    var x=om_mod_0_vector((r)["inputs"]);
    var result=om_mod_10_values(g,x);
    put(out,"valid",((result)[1])[(g)["root"]]);
    put(out,"value",((result)[0])[(g)["root"]]);
  }
  se((has(r,"lower_i64")&&((r)["lower_i64"]==1))) {
    var names=[];
    var i=0;
    enquanto((i<(g)["variables"])) {
      push(names,("x"+text(i)));
      i=(i+1);
    }
    put(out,"source",(((("funcao hypothesis("+join(names,","))+") { retornar ")+om_mod_10_expression(g,(g)["root"]))+"; }"));
  }
  retornar out;
}
funcao om_mod_10_expression(g,id) {
  var n=((g)["nodes"])[id];
  se(((n)[0]=="const")) {
    se((((qden((n)[1])!=1)||((n)[1]<(-9223372036854775808)))||((n)[1]>9223372036854775807))) {
      fail("Direct i64 lowering requires integral bounded constants");
    }
    retornar (("("+text((n)[1]))+")");
  }
  se(((n)[0]=="var")) {
    retornar ("x"+text((n)[1]));
  }
  se(((n)[0]=="neg")) {
    retornar (("(-"+om_mod_10_expression(g,((n)[2])[0]))+")");
  }
  var op="+";
  se(((n)[0]=="sub")) {
    op="-";
  }
  se(((n)[0]=="mul")) {
    op="*";
  }
  retornar (((("("+om_mod_10_expression(g,((n)[2])[0]))+op)+om_mod_10_expression(g,((n)[2])[1]))+")");
}
funcao om_mod_10_ingest(g,ast,depth) {
  se((((depth>16)||(!islist(ast)))||(len(ast)<2))) {
    fail("Symbolic AST shape/depth");
  }
  var op=(ast)[0];
  se(((op=="const")||(op=="var"))) {
    se((len(ast)!=2)) {
      fail("Leaf AST exact arity");
    }
    retornar om_mod_10_intern(g,op,(ast)[1],[]);
  }
  var arity=2;
  se((op=="neg")) {
    arity=1;
  }
  se(((len(ast)!=(arity+1))||(!contains(["neg","add","sub","mul"],op)))) {
    fail("Polynomial AST required");
  }
  var children=[];
  var i=0;
  enquanto((i<arity)) {
    var child=om_mod_10_ingest(g,(ast)[(i+1)],(depth+1));
    se((child<0)) {
      retornar (-1);
    }
    push(children,child);
    i=(i+1);
  }
  retornar om_mod_10_intern(g,op,0,children);
