  om_mod_8_conditional(s,5,"error_io");
  om_mod_3_emit(s,[72,139,116,36,16]);
  om_mod_8_constant(s,7,(-100));
  om_mod_8_constant(s,2,0);
  om_mod_8_constant(s,10,0);
