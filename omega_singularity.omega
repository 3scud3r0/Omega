#|/* Omega native value runtime. GMP rationals; no Python or external interpreter. */
#|#ifndef _GNU_SOURCE
#|#define _GNU_SOURCE
#|#endif
#|#ifndef OMEGA_RUNTIME_H
#|#define OMEGA_RUNTIME_H
#|#include <ctype.h>
#|#include <errno.h>
