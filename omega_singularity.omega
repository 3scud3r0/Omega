    var type=om_mod_0_count((definitions)[i],"type",0,(len(raw)-1));
    var body=om_mod_0_count((definitions)[i],"body",0,(len(raw)-1));
    se(((om_mod_5_type_level(state,type,0)<0)||(!om_mod_5_check_term(state,body,type,0)))) {
      accepted=0;
    }
    senao {
      push((state)["definitions"],[type,body]);
    }
    i=(i+1);
  }
  se(accepted) {
    accepted=(((om_mod_5_type_level(state,expected,0)>=0)&&om_mod_5_check_term(state,proof,expected,0))&&((state)["error"]==""));
  }
  var resource=contains(["arena-limit","fuel-limit","depth-limit","context-limit","universe-limit","arithmetic-limit"],(state)["error"]);
  var status="rejected";
  se(accepted) {
    status="accepted";
  }
  senao {
    se(resource) {
      status="resource-limit";
    }
  }
  var result=obj();
  put(result,"accepted",accepted);
  put(result,"verified",accepted);
  put(result,"status",status);
  put(result,"error",(state)["error"]);
  put(result,"expected_node",expected);
  put(result,"proof_node",proof);
  put(result,"error_node",(state)["error_node"]);
  put(result,"arena_nodes",len((state)["nodes"]));
  put(result,"fuel_used",((state)["initial_fuel"]-(state)["fuel"]));
  put(result,"peak_depth",(state)["peak_depth"]);
  put(result,"axioms",[]);
  put(result,"logic","predicative-intensional-MLTT-1");
  put(result,"request_document_sha256",sha256(om_mod_18_canonical(request)));
  retornar result;
}
