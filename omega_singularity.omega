#|        printf("%s\"",i?",":"");
#|        mpz_out_str(stdout,10,matrix->numerators[i]);
#|        printf("\"");
#|    }
#|    printf("],\"backend\":%u,\"simd_products\":%zu}",matrix->backend,matrix->simd_products);
#|}
