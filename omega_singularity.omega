#|      var value=0;
#|      se(ast[1]=="||") { value=1; }
#|      constant(s,arch,value);
#|      a::mark(s,done);
#|    } senao {
#|      var right=expression(s,arch,ast[3],env,slots);
#|      load(s,arch,result_register(arch),left);
#|      load(s,arch,rhs_register(arch),right);
#|      binary(s,arch,ast[1]);
#|    }
#|  }
#|  store(s,arch,slot);
#|  retornar slot;
#|}
#|funcao block(s,arch,body,env,slots) {
#|  var i=0;
#|  enquanto(i<len(body)) {
#|    var statement=body[i];
#|    se(statement[0]=="let") {
#|      var slot=expression(s,arch,statement[2],env,slots);
