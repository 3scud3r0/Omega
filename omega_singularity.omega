funcao om_mod_0_mul(a,b) {
  se((len((a)[0])!=len(b))) {
    fail("Matrix product shape");
  }
  var bt=om_mod_0_transpose(b);
  var out=[];
  var i=0;
  enquanto((i<len(a))) {
    var row=[];
    var j=0;
    enquanto((j<len(bt))) {
      push(row,om_mod_0_dot((a)[i],(bt)[j]));
      j=(j+1);
    }
    push(out,row);
    i=(i+1);
  }
  retornar out;
}
