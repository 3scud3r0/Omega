funcao om_mod_10_document(g,root) {
  om_mod_0_integer(root,0,(len((g)["nodes"])-1));
  var marked=om_mod_0_zeros(len((g)["nodes"]));
  om_mod_10_reachable(g,root,marked);
  var nodes=[];
  var map=[];
  var i=0;
  enquanto((i<len((g)["nodes"]))) {
    push(map,(-1));
    se((marked)[i]) {
      var node=((g)["nodes"])[i];
      var children=[];
      var j=0;
      enquanto((j<len((node)[2]))) {
        push(children,(map)[((node)[2])[j]]);
        j=(j+1);
      }
      put(map,i,len(nodes));
      push(nodes,[(node)[0],(node)[1],children]);
    }
    i=(i+1);
  }
  var out=obj();
  put(out,"format","omega-symbolic-dag-1");
  put(out,"variables",(g)["variables"]);
  put(out,"nodes",nodes);
  put(out,"root",(map)[root]);
  retornar out;
}
funcao om_mod_10_execute(r) {
  se((has(r,"mode")&&((r)["mode"]=="policy-update"))) {
    retornar om_mod_10_update_policy(r);
  }
  var g=om_mod_10_load((r)["dag"]);
  var out=obj();
  put(out,"dag",om_mod_10_document(g,(g)["root"]));
  put(out,"polynomial",om_mod_10_polynomial(g,(g)["root"]));
  put(out,"cost",om_mod_10_cost(g,(g)["root"]));
  put(out,"formal_refinement_proved",0);
