funcao om_mod_10_intern(g,op,payload,children) {
  var arity=0;
  se((op=="neg")) {
    arity=1;
  }
  se(contains(["add","sub","mul"],op)) {
    arity=2;
  }
  se((((!contains(["const","var","neg","add","sub","mul"],op))||(!islist(children)))||(len(children)!=arity))) {
    fail("Symbolic DAG operation/arity");
  }
  se((op=="const")) {
    payload=om_mod_0_val(payload);
    se((qbits(payload)>256)) {
      fail("DAG constant bit budget 256");
    }
  }
  senao {
    se((op=="var")) {
      payload=om_mod_0_integer(om_mod_0_val(payload),0,((g)["variables"]-1));
    }
    senao {
      se((payload!=0)) {
        fail("Operator payload must be zero");
      }
    }
  }
  var expanded=1;
  var bits=3;
  se((op=="var")) {
    bits=5;
  }
  se((op=="const")) {
    var numerator=qnum(payload);
    se((numerator<0)) {
      numerator=(-numerator);
    }
    bits=((((4+(2*qbits((numerator+1))))-1)+(2*qbits(qden(payload))))-1);
  }
  var depth=1;
  var i=0;
  enquanto((i<arity)) {
    var child=om_mod_0_integer((children)[i],0,(len((g)["nodes"])-1));
    expanded=(expanded+((g)["costs"])[child]);
    bits=(bits+((g)["code_bits"])[child]);
    se(((((g)["depths"])[child]+1)>depth)) {
      depth=(((g)["depths"])[child]+1);
    }
    i=(i+1);
  }
  se(((expanded>127)||(depth>16))) {
    put(g,"limited",1);
    retornar (-1);
  }
  se((((op=="add")||(op=="mul"))&&((children)[0]>(children)[1]))) {
    children=[(children)[1],(children)[0]];
  }
  var key=om_mod_18_canonical([op,payload,children]);
  se(has((g)["table"],key)) {
    retornar ((g)["table"])[key];
  }
  se((len((g)["nodes"])>=(g)["limit"])) {
    put(g,"limited",1);
    retornar (-1);
  }
  var id=len((g)["nodes"]);
  push((g)["nodes"],[op,payload,slice(children,0,len(children))]);
  push((g)["costs"],expanded);
  push((g)["code_bits"],bits);
  push((g)["depths"],depth);
  put((g)["table"],key,id);
  retornar id;
}
funcao om_mod_10_load(raw) {
  se((((((raw)["format"]!="omega-symbolic-dag-1")||(!islist((raw)["nodes"])))||(len((raw)["nodes"])<1))||(len((raw)["nodes"])>256))) {
    fail("Symbolic DAG format/size");
  }
  se((len(keys(raw))!=4)) {
    fail("DAG fields: format,variables,nodes,root");
  }
  var g=om_mod_10_create(om_mod_0_val((raw)["variables"]),256);
  var map=[];
  var i=0;
  enquanto((i<len((raw)["nodes"]))) {
    var node=((raw)["nodes"])[i];
    se((((!islist(node))||(len(node)!=3))||(!islist((node)[2])))) {
      fail("DAG node [op,payload,children]");
    }
    var children=[];
    var j=0;
    enquanto((j<len((node)[2]))) {
      var child=om_mod_0_integer(om_mod_0_val(((node)[2])[j]),0,(i-1));
      push(children,(map)[child]);
      j=(j+1);
    }
    var id=om_mod_10_intern(g,(node)[0],om_mod_0_val((node)[1]),children);
    se((id<0)) {
      fail("DAG expression resource limit");
    }
    push(map,id);
    i=(i+1);
  }
  put(g,"root",(map)[om_mod_0_integer(om_mod_0_val((raw)["root"]),0,(len(map)-1))]);
  retornar g;
}
funcao om_mod_10_observations(raw,variables) {
  se((((!islist(raw))||(len(raw)<1))||(len(raw)>32))) {
    fail("Observation budget 1..32");
  }
  var out=[];
  var i=0;
  enquanto((i<len(raw))) {
    se(((!islist((raw)[i]))||(len((raw)[i])!=2))) {
      fail("Observation [inputs,output]");
    }
    var x=om_mod_0_vector(((raw)[i])[0]);
    var y=om_mod_0_val(((raw)[i])[1]);
    se(((len(x)!=variables)||(qbits(y)>256))) {
      fail("Observation dimension/bit budget");
    }
    var j=0;
    enquanto((j<len(x))) {
      se((qbits((x)[j])>256)) {
        fail("Observation input bit budget");
      }
      j=(j+1);
    }
    push(out,[x,y]);
    i=(i+1);
  }
  retornar out;
}
funcao om_mod_10_polynomial(g,root) {
  var polys=(g)["polynomials"];
  var i=len(polys);
  enquanto((i<=root)) {
    var n=((g)["nodes"])[i];
    var p=[];
    se(((n)[0]=="const")) {
      p=om_mod_11_poly_const((n)[1],(g)["variables"]);
    }
    se(((n)[0]=="var")) {
      p=om_mod_11_poly_var((n)[1],(g)["variables"]);
    }
    se(((n)[0]=="neg")) {
      p=om_mod_11_poly_scale((polys)[((n)[2])[0]],(-1));
    }
    se(((n)[0]=="add")) {
      p=om_mod_11_poly_add((polys)[((n)[2])[0]],(polys)[((n)[2])[1]]);
    }
    se(((n)[0]=="sub")) {
      p=om_mod_11_poly_add((polys)[((n)[2])[0]],om_mod_11_poly_scale((polys)[((n)[2])[1]],(-1)));
    }
    se(((n)[0]=="mul")) {
      p=om_mod_11_poly_mul((polys)[((n)[2])[0]],(polys)[((n)[2])[1]]);
    }
    push(polys,p);
    i=(i+1);
  }
  retornar (polys)[root];
}
funcao om_mod_10_reachable(g,id,marked) {
  se((marked)[id]) {
    retornar 0;
  }
  put(marked,id,1);
  var children=(((g)["nodes"])[id])[2];
  var i=0;
  enquanto((i<len(children))) {
    om_mod_10_reachable(g,(children)[i],marked);
    i=(i+1);
  }
  retornar 0;
}
funcao om_mod_10_update_policy(r) {
  var weights=om_mod_0_vector((r)["weights"]);
  var features=om_mod_0_vector((r)["features"]);
  se(((len(weights)!=6)||(len(features)!=6))) {
    fail("Six-opcode linear policy vectors required");
  }
  var rate=om_mod_0_positive(om_mod_0_num(r,"rate",(1/16)));
  var reward=om_mod_0_val((r)["reward"]);
  se((((rate>1)||(reward<(-1)))||(reward>1))) {
    fail("Bounded advisory reward/rate");
  }
  var i=0;
  enquanto((i<6)) {
    se((((((weights)[i]<(-32))||((weights)[i]>32))||((features)[i]<(-127)))||((features)[i]>127))) {
      fail("Advisory policy bounds");
    }
    i=(i+1);
  }
  var before=om_mod_0_dot(weights,features);
  var out=[];
  i=0;
  enquanto((i<6)) {
    var next=((weights)[i]+((rate*reward)*(features)[i]));
    se((next<(-32))) {
      next=(-32);
    }
    se((next>32)) {
      next=32;
    }
    push(out,next);
    i=(i+1);
  }
  var result=obj();
  put(result,"weights",out);
  put(result,"previous_score",before);
  put(result,"new_score",om_mod_0_dot(out,features));
  put(result,"proof_authority",0);
  put(result,"model","bounded exact linear opcode preference; not a language model");
  retornar result;
}
funcao om_mod_10_values(g,x) {
  se((len(x)!=(g)["variables"])) {
    fail("DAG evaluation dimension");
  }
  var out=[];
  var valid=[];
  var i=0;
  enquanto((i<len((g)["nodes"]))) {
    var n=((g)["nodes"])[i];
    var v=0;
    var good=1;
    se(((n)[0]=="const")) {
      v=(n)[1];
    }
    se(((n)[0]=="var")) {
      v=(x)[(n)[1]];
    }
    se(((n)[0]=="neg")) {
      good=(valid)[((n)[2])[0]];
      v=(-(out)[((n)[2])[0]]);
    }
    se(contains(["add","sub","mul"],(n)[0])) {
      var left=((n)[2])[0];
      var right=((n)[2])[1];
      good=((valid)[left]&&(valid)[right]);
      se(good) {
        se(((n)[0]=="add")) {
          v=((out)[left]+(out)[right]);
        }
        se(((n)[0]=="sub")) {
          v=((out)[left]-(out)[right]);
        }
        se(((n)[0]=="mul")) {
          v=((out)[left]*(out)[right]);
        }
      }
    }
    se((qbits(v)>256)) {
      good=0;
    }
    se((!good)) {
      v=0;
    }
    push(out,v);
    push(valid,good);
    i=(i+1);
  }
  retornar [out,valid];
}
funcao om_mod_9_better(a,b) {
  se(((a)[3]!=(b)[3])) {
    retornar ((a)[3]>(b)[3]);
  }
  se(((a)[1]!=(b)[1])) {
    retornar ((a)[1]<(b)[1]);
  }
  se(((a)[2]!=(b)[2])) {
    retornar ((a)[2]<(b)[2]);
  }
  retornar ((a)[0]<(b)[0]);
}
funcao om_mod_9_evaluate_new(g,observed,cache) {
  var i=0;
  enquanto((i<len(observed))) {
    var pair=(cache)[i];
    var values=(pair)[0];
    var valid=(pair)[1];
    var j=len(values);
    enquanto((j<len((g)["nodes"]))) {
      var n=((g)["nodes"])[j];
      var value=0;
      var good=1;
      se(((n)[0]=="const")) {
        value=(n)[1];
      }
      se(((n)[0]=="var")) {
        value=(((observed)[i])[0])[(n)[1]];
      }
      se(((n)[0]=="neg")) {
        good=(valid)[((n)[2])[0]];
        value=(-(values)[((n)[2])[0]]);
      }
      se(contains(["add","sub","mul"],(n)[0])) {
        var a=((n)[2])[0];
        var b=((n)[2])[1];
        good=((valid)[a]&&(valid)[b]);
        se(good) {
          se(((n)[0]=="add")) {
            value=((values)[a]+(values)[b]);
          }
          se(((n)[0]=="sub")) {
            value=((values)[a]-(values)[b]);
          }
          se(((n)[0]=="mul")) {
            value=((values)[a]*(values)[b]);
          }
        }
      }
      se((qbits(value)>256)) {
        good=0;
      }
      se((!good)) {
        value=0;
      }
      push(values,value);
      push(valid,good);
      j=(j+1);
    }
    i=(i+1);
  }
  retornar 0;
}
funcao om_mod_9_execute(r) {
  var variables=om_mod_0_integer(om_mod_0_num(r,"variables",1),1,4);
  var observed=om_mod_10_observations((r)["observations"],variables);
  var limit=om_mod_0_integer(om_mod_0_num(r,"max_candidates",512),8,1024);
  var width=om_mod_0_integer(om_mod_0_num(r,"beam_width",8),1,32);
  var max_nodes=om_mod_0_integer(om_mod_0_num(r,"max_nodes",5),1,9);
  var constants=om_mod_0_vector((r)["constants"]);
  se(((len(constants)<1)||(len(constants)>8))) {
    fail("Constant alphabet 1..8");
  }
  var g=om_mod_10_create(variables,limit);
  var operators=["add","sub","mul"];
  se(has(r,"opcode_prior")) {
    var prior=om_mod_0_vector((r)["opcode_prior"]);
    se((len(prior)!=3)) {
      fail("Advisory prior: add,sub,mul");
    }
    var order=[0,1,2];
    var position=1;
    enquanto((position<3)) {
      var j=position;
      enquanto(((j>0)&&((prior)[(order)[j]]>(prior)[(order)[(j-1)]]))) {
        var swap=(order)[j];
        put(order,j,(order)[(j-1)]);
        put(order,(j-1),swap);
        j=(j-1);
      }
      position=(position+1);
    }
    operators=[(operators)[(order)[0]],(operators)[(order)[1]],(operators)[(order)[2]]];
  }
  var levels=[[]];
  var cache=[];
  var i=0;
  enquanto((i<len(observed))) {
    push(cache,[[],[]]);
    i=(i+1);
  }
  i=0;
  enquanto((i<variables)) {
    om_mod_10_intern(g,"var",i,[]);
    i=(i+1);
  }
  i=0;
  enquanto((i<len(constants))) {
    om_mod_10_intern(g,"const",(constants)[i],[]);
    i=(i+1);
  }
  var seen=obj();
  var all=[];
  var best=[];
  var beam_pruned=0;
  var level=1;
  var exhausted=0;
  enquanto(((level<=max_nodes)&&(!exhausted))) {
    var begin=0;
    se((level>1)) {
      begin=len((g)["nodes"]);
      var unary=(levels)[(level-1)];
      i=0;
      enquanto(((i<len(unary))&&(!(g)["limited"]))) {
        om_mod_10_intern(g,"neg",0,[((unary)[i])[0]]);
        i=(i+1);
      }
      var split=1;
      enquanto(((split<(level-1))&&(!(g)["limited"]))) {
        var left=(levels)[split];
        var right=(levels)[((level-1)-split)];
        var a=0;
        enquanto(((a<len(left))&&(!(g)["limited"]))) {
          var b=0;
          enquanto(((b<len(right))&&(!(g)["limited"]))) {
            var op=0;
            enquanto(((op<3)&&(!(g)["limited"]))) {
              om_mod_10_intern(g,(operators)[op],0,[((left)[a])[0],((right)[b])[0]]);
              op=(op+1);
            }
            b=(b+1);
          }
          a=(a+1);
        }
        split=(split+1);
      }
    }
    om_mod_9_evaluate_new(g,observed,cache);
    var retained=[];
    var candidates=0;
    i=begin;
    enquanto((i<len((g)["nodes"]))) {
      se((((g)["costs"])[i]==level)) {
        var item=om_mod_9_score(g,i,observed,cache);
        se((item)[3]) {
          var key=om_mod_18_canonical(om_mod_10_polynomial(g,i));
          se((!has(seen,key))) {
            put(seen,key,1);
            push(all,item);
            retained=om_mod_9_offer(retained,item,width);
            best=om_mod_9_offer(best,item,8);
            candidates=(candidates+1);
          }
        }
      }
      i=(i+1);
    }
    se((candidates>width)) {
      beam_pruned=1;
    }
    push(levels,retained);
    exhausted=(g)["limited"];
    level=(level+1);
  }
  se((len(best)==0)) {
    fail("No valid candidate within the finite numeric domain");
  }
  var winner=(best)[0];
  var out=obj();
  put(out,"format","omega-finite-induction-1");
  put(out,"winner",om_mod_10_document(g,(winner)[0]));
  put(out,"training_error",(winner)[1]);
  put(out,"description_bits",(winner)[2]);
  put(out,"cost",om_mod_10_cost(g,(winner)[0]));
  put(out,"generated_nodes",len((g)["nodes"]));
  put(out,"distinct_polynomials",len(all));
  put(out,"budget_exhausted",exhausted);
  put(out,"beam_pruned",beam_pruned);
  put(out,"search_complete",((!exhausted)&&(!beam_pruned)));
  put(out,"universal_optimality_claimed",0);
  put(out,"verified",0);
  var consistent=[];
  var weight=0;
  i=0;
  enquanto((i<len(all))) {
    se((((all)[i])[1]==0)) {
      var prior=1;
      var bit=0;
      enquanto((bit<((all)[i])[2])) {
        prior=(prior/2);
        bit=(bit+1);
      }
      push(consistent,[((all)[i])[0],prior]);
      weight=(weight+prior);
    }
    i=(i+1);
  }
  var predictions=[];
  se(has(r,"predict")) {
    se(((!islist((r)["predict"]))||(len((r)["predict"])>16))) {
      fail("Prediction query budget");
    }
    var j=0;
    enquanto((j<len((r)["predict"]))) {
      var x=om_mod_0_vector(((r)["predict"])[j]);
      var evaluation=om_mod_10_values(g,x);
      var total=0;
      var low=0;
      var high=0;
      var valid=(weight>0);
      i=0;
      enquanto((i<len(consistent))) {
        var id=((consistent)[i])[0];
        valid=(valid&&((evaluation)[1])[id]);
        var value=((evaluation)[0])[id];
        total=(total+(value*((consistent)[i])[1]));
        se(((i==0)||(value<low))) {
          low=value;
        }
        se(((i==0)||(value>high))) {
          high=value;
        }
        i=(i+1);
      }
      var mean=0;
      se(valid) {
        mean=(total/weight);
      }
      push(predictions,[valid,mean,low,high]);
      j=(j+1);
    }
  }
  put(out,"consistent_candidates",len(consistent));
  put(out,"finite_prior_mass",weight);
  put(out,"predictions",predictions);
  se(has(r,"holdout")) {
    var holdout=om_mod_10_observations((r)["holdout"],variables);
    var error=0;
    var valid=1;
    i=0;
    enquanto((i<len(holdout))) {
      var j=0;
      enquanto((j<len(observed))) {
        se((om_mod_18_canonical(((holdout)[i])[0])==om_mod_18_canonical(((observed)[j])[0]))) {
          fail("Train/holdout input overlap");
        }
        j=(j+1);
      }
      var evaluation=om_mod_10_values(g,((holdout)[i])[0]);
      valid=(valid&&((evaluation)[1])[(winner)[0]]);
      var delta=(((evaluation)[0])[(winner)[0]]-((holdout)[i])[1]);
      error=(error+(delta*delta));
      i=(i+1);
    }
    put(out,"holdout_valid",valid);
    put(out,"holdout_error",error);
  }
  retornar out;
}
funcao om_mod_9_offer(best,item,width) {
  var i=0;
  enquanto(((i<len(best))&&(!om_mod_9_better(item,(best)[i])))) {
    i=(i+1);
  }
  se((i>=width)) {
    retornar best;
  }
  var out=slice(best,0,i);
  push(out,item);
  var j=i;
  enquanto(((j<len(best))&&(len(out)<width))) {
    push(out,(best)[j]);
    j=(j+1);
  }
  retornar out;
}
funcao om_mod_9_score(g,id,observed,cache) {
  var error=0;
  var good=1;
  var values=[];
  var i=0;
  enquanto((i<len(observed))) {
    var result=(cache)[i];
    good=(good&&((result)[1])[id]);
    var value=((result)[0])[id];
    push(values,value);
    var delta=(value-((observed)[i])[1]);
    error=(error+(delta*delta));
    i=(i+1);
  }
  se((qbits(error)>1024)) {
    good=0;
    error=0;
  }
  retornar [id,error,((g)["code_bits"])[id],good,values];
}
funcao om_mod_12_draw(state,low,high) {
  retornar (low+(om_mod_12_next(state)%((high-low)+1)));
}
funcao om_mod_12_execute(r) {
  var seed=om_mod_0_integer(om_mod_0_num(r,"seed",0),0,4294967295);
  var count=om_mod_0_integer(om_mod_0_num(r,"tasks",4),1,16);
  var train=om_mod_0_integer(om_mod_0_num(r,"train",4),2,12);
  var held=om_mod_0_integer(om_mod_0_num(r,"heldout",2),1,8);
  var mode=om_mod_0_text_field(r,"domain",32);
  se((!contains(["affine","polynomial","conservative-step"],mode))) {
    fail("Synthetic domain affine, polynomial or conservative-step");
  }
  var state=[seed];
  var tasks=[];
  var i=0;
  enquanto((i<count)) {
    var a=om_mod_12_draw(state,(-3),3);
    se((a==0)) {
      a=1;
    }
    var b=om_mod_12_draw(state,(-3),3);
    var ast=["add",["mul",["const",a],["var",0]],["const",b]];
    var variables=1;
    se((mode=="polynomial")) {
      ast=["add",["mul",["const",a],["mul",["var",0],["var",0]]],["const",b]];
    }
    se((mode=="conservative-step")) {
      variables=2;
      ast=["add",["var",0],["var",1]];
    }
    var g=om_mod_10_create(variables,64);
    var root=om_mod_10_ingest(g,ast,0);
    var observations=[];
    var holdout=[];
    var j=0;
    enquanto((j<(train+held))) {
      var x=[(j-train)];
      se((variables==2)) {
        push(x,om_mod_12_draw(state,(-3),3));
      }
      var values=om_mod_10_values(g,x);
      se((!((values)[1])[root])) {
        fail("Synthetic arithmetic limit");
      }
      var sample=[x,((values)[0])[root]];
      se((j<train)) {
        push(observations,sample);
      }
      senao {
        push(holdout,sample);
      }
      j=(j+1);
    }
    var task=obj();
    put(task,"id",((text(seed)+":")+text(i)));
    put(task,"domain",mode);
    put(task,"variables",variables);
    put(task,"observations",observations);
    put(task,"holdout",holdout);
    put(task,"answer_key",om_mod_10_document(g,root));
    put(task,"answer_key_sha256",sha256(om_mod_18_canonical((task)["answer_key"])));
    put(task,"verified",0);
    put(task,"empirical_claim",0);
    push(tasks,task);
    i=(i+1);
  }
  var out=obj();
  put(out,"format","omega-synthetic-universes-1");
  put(out,"seed",seed);
  put(out,"tasks",tasks);
  put(out,"external_data_bytes",0);
  put(out,"proof_obligations",(len(tasks)*(train+held)));
  put(out,"generator_semantics","finite exact polynomial models; LCG32 seed; disjoint x0 ranges");
  retornar out;
}
funcao om_mod_12_next(state) {
  put(state,0,((((state)[0]*1664525)+1013904223)%4294967296));
  retornar (state)[0];
}
funcao om_mod_13_execute(r) {
  var programs=(r)["programs"];
  se((((!islist(programs))||(len(programs)<1))||(len(programs)>256))) {
    fail("Parallel candidate batch 1..256");
  }
  var dimension=om_mod_0_integer(om_mod_0_val(((programs)[0])["variables"]),1,4);
  var observed=om_mod_10_observations((r)["observations"],dimension);
  var packed=[];
  var descriptors=[];
  var results=[];
  var fits=[];
  var eligible=1;
  var evaluate=1;
  se((has(r,"pack_only")&&((r)["pack_only"]==1))) {
    evaluate=0;
  }
  var i=0;
  enquanto((i<len(programs))) {
    var g=om_mod_10_load((programs)[i]);
    se(((g)["variables"]!=dimension)) {
      fail("Parallel candidate variable mismatch");
    }
    var doc=om_mod_10_document(g,(g)["root"]);
    se((len((doc)["nodes"])>32)) {
      eligible=0;
    }
    var j=0;
    enquanto((j<32)) {
      var record=[0,0,1,0];
      se((j<len((doc)["nodes"]))) {
        var node=((doc)["nodes"])[j];
        se(((node)[0]=="const")) {
          record=[0,qnum((node)[1]),qden((node)[1]),0];
          se(((((record)[1]<(-32767))||((record)[1]>32767))||((record)[2]>32767))) {
            eligible=0;
          }
        }
        se(((node)[0]=="var")) {
          record=[1,(node)[1],0,0];
        }
        se(((node)[0]=="neg")) {
          record=[2,((node)[2])[0],0,0];
        }
        se(contains(["add","sub","mul"],(node)[0])) {
          var op=3;
          se(((node)[0]=="sub")) {
            op=4;
          }
          se(((node)[0]=="mul")) {
            op=5;
          }
          record=[op,((node)[2])[0],((node)[2])[1],0];
        }
      }
      push(packed,record);
      j=(j+1);
    }
    push(descriptors,[len((doc)["nodes"]),(doc)["root"]]);
    var mismatches=0;
    var first=(-1);
    var good=1;
    var witness=[];
    j=0;
    enquanto((evaluate&&(j<len(observed)))) {
      var values=om_mod_10_values(g,((observed)[j])[0]);
      good=(good&&((values)[1])[(g)["root"]]);
      se(((!((values)[1])[(g)["root"]])||(((values)[0])[(g)["root"]]!=((observed)[j])[1]))) {
        mismatches=(mismatches+1);
        se((first<0)) {
          first=j;
          witness=[((observed)[j])[0],((values)[0])[(g)["root"]],((observed)[j])[1]];
        }
      }
      j=(j+1);
    }
    se(evaluate) {
      push(results,[good,mismatches,first,witness]);
      se((good&&(mismatches==0))) {
        push(fits,i);
      }
    }
    i=(i+1);
  }
  var samples=[];
  i=0;
  enquanto((i<len(observed))) {
    var row=slice(((observed)[i])[0],0,dimension);
    push(row,((observed)[i])[1]);
    var j=0;
    enquanto((j<len(row))) {
      var n=qnum((row)[j]);
      var d=qden((row)[j]);
      se((((n<(-32767))||(n>32767))||(d>32767))) {
        eligible=0;
      }
      push(samples,[n,d]);
      j=(j+1);
    }
    i=(i+1);
  }
  var out=obj();
  put(out,"format","omega-parallel-sieve-1");
  put(out,"backend","native-omega-cpu-reference");
  put(out,"results",results);
  put(out,"fits",fits);
  put(out,"gpu_eligible",eligible);
  put(out,"metadata",[len(programs),len(observed),dimension,32]);
  put(out,"nodes",packed);
  put(out,"descriptors",descriptors);
  put(out,"samples",samples);
  put(out,"verified",0);
  put(out,"gpu_executed",0);
  put(out,"cpu_evaluated",evaluate);
  retornar out;
}
funcao om_mod_14_execute(r) {
  var messages=(r)["messages"];
  se(((!islist(messages))||(len(messages)>32))) {
    fail("Swarm batch limit 32");
  }
  var known=obj();
  var pending=[];
  var rejected=[];
  var duplicate=[];
  var bytes=0;
  var i=0;
  enquanto((i<len(messages))) {
    var message=(messages)[i];
    se((((message)["format"]!="omega-epistemic-claim-1")||(len(keys(message))!=3))) {
      fail("Claim exact fields: format,dag,observations");
    }
    var g=om_mod_10_load((message)["dag"]);
    var claim=obj();
    put(claim,"format","omega-epistemic-claim-1");
    put(claim,"dag",om_mod_10_document(g,(g)["root"]));
    put(claim,"observations",om_mod_10_observations((message)["observations"],(g)["variables"]));
    var encoded=om_mod_18_canonical(claim);
    se((len(encoded)>65536)) {
      fail("Swarm claim byte limit 64 KiB");
    }
    bytes=(bytes+len(encoded));
    se((bytes>262144)) {
      fail("Swarm batch byte limit 256 KiB");
    }
    var id=sha256(encoded);
    se(has(known,id)) {
      push(duplicate,[i,id]);
    }
    senao {
      put(known,id,1);
      var valid=1;
      var j=0;
      enquanto((j<len((claim)["observations"]))) {
        var sample=((claim)["observations"])[j];
        var values=om_mod_10_values(g,(sample)[0]);
        se(((!((values)[1])[(g)["root"]])||(((values)[0])[(g)["root"]]!=(sample)[1]))) {
          valid=0;
        }
        j=(j+1);
      }
      se(valid) {
        push(pending,[id,claim]);
      }
      senao {
        push(rejected,[i,id,"counterexample-or-numeric-limit"]);
      }
    }
    i=(i+1);
  }
  var out=obj();
  put(out,"format","omega-swarm-quarantine-1");
  put(out,"pending_kernel",pending);
  put(out,"rejected",rejected);
  put(out,"duplicates",duplicate);
  put(out,"bytes",bytes);
  put(out,"admitted",0);
  put(out,"network_actions",0);
  put(out,"origin_authenticated",0);
  retornar out;
}
funcao om_mod_15_execute(r) {
  var baseline=om_mod_10_load((r)["baseline"]);
  var original=om_mod_10_document(baseline,(baseline)["root"]);
  var old_cost=om_mod_10_cost(baseline,(baseline)["root"]);
  var rounds=om_mod_0_integer(om_mod_0_num(r,"rounds",4),1,8);
  var candidate=original;
  var history=[];
  var step=0;
  var stopped=0;
  enquanto(((step<rounds)&&(!stopped))) {
    var proposed=om_mod_15_pass(candidate);
    var equal=(om_mod_18_canonical((proposed)[0])==om_mod_18_canonical(candidate));
    push(history,[step,sha256(om_mod_18_canonical(candidate)),sha256(om_mod_18_canonical((proposed)[0])),(proposed)[1]]);
    candidate=(proposed)[0];
    stopped=equal;
    step=(step+1);
  }
  var new=om_mod_10_load(candidate);
  var new_cost=om_mod_10_cost(new,(new)["root"]);
  var p=om_mod_10_polynomial(baseline,(baseline)["root"]);
  var q=om_mod_10_polynomial(new,(new)["root"]);
  var equivalent=(om_mod_18_canonical(p)==om_mod_18_canonical(q));
  var out=obj();
  put(out,"format","omega-improvement-proposal-1");
  put(out,"baseline",original);
  put(out,"candidate",candidate);
  put(out,"baseline_sha256",sha256(om_mod_18_canonical(original)));
  put(out,"candidate_sha256",sha256(om_mod_18_canonical(candidate)));
  put(out,"polynomial_equal",equivalent);
  put(out,"baseline_cost",old_cost);
  put(out,"candidate_cost",new_cost);
  put(out,"strict_cost_improvement",(equivalent&&((new_cost)[1]<(old_cost)[1])));
  put(out,"history",history);
  put(out,"stop_reason","round-budget");
  se(stopped) {
    put(out,"stop_reason","fixed-point");
  }
  put(out,"applied",0);
  put(out,"verified",0);
  put(out,"cost_model","unique exact-rational arithmetic DAG nodes");
  put(out,"general_intelligence_gain_proved",0);
  retornar out;
}
funcao om_mod_15_literal(g,id,value) {
  retornar (((((g)["nodes"])[id])[0]=="const")&&((((g)["nodes"])[id])[1]==value));
}
funcao om_mod_15_pass(raw) {
  var old=om_mod_10_load(raw);
  var g=om_mod_10_create((old)["variables"],256);
  var map=[];
  var ledger=[];
  var i=0;
  enquanto((i<len((old)["nodes"]))) {
    var n=((old)["nodes"])[i];
    var children=[];
    var j=0;
    enquanto((j<len((n)[2]))) {
      push(children,(map)[((n)[2])[j]]);
      j=(j+1);
    }
    var id=om_mod_15_rewrite(g,(n)[0],(n)[1],children,ledger);
    se((id<0)) {
      fail("Rewrite arena budget");
    }
    push(map,id);
    i=(i+1);
  }
  retornar [om_mod_10_document(g,(map)[(old)["root"]]),ledger];
}
funcao om_mod_15_rewrite(g,op,payload,children,ledger) {
  se(((op=="const")||(op=="var"))) {
    retornar om_mod_10_intern(g,op,payload,[]);
  }
  var left=(children)[0];
  var a=((g)["nodes"])[left];
  se((op=="neg")) {
    se(((a)[0]=="const")) {
      push(ledger,"constant-negation");
      retornar om_mod_10_intern(g,"const",(-(a)[1]),[]);
    }
    se(((a)[0]=="neg")) {
      push(ledger,"double-negation");
      retornar ((a)[2])[0];
    }
    retornar om_mod_10_intern(g,op,0,children);
  }
  var right=(children)[1];
  var b=((g)["nodes"])[right];
  se((((a)[0]=="const")&&((b)[0]=="const"))) {
    var value=((a)[1]+(b)[1]);
    se((op=="sub")) {
      value=((a)[1]-(b)[1]);
    }
    se((op=="mul")) {
      value=((a)[1]*(b)[1]);
    }
    se((qbits(value)<=256)) {
      push(ledger,"constant-folding");
      retornar om_mod_10_intern(g,"const",value,[]);
    }
  }
  se((((op=="add")||(op=="sub"))&&om_mod_15_literal(g,right,0))) {
    push(ledger,"right-zero");
    retornar left;
  }
  se(((op=="add")&&om_mod_15_literal(g,left,0))) {
    push(ledger,"left-zero");
    retornar right;
  }
  se(((op=="sub")&&(left==right))) {
    push(ledger,"self-subtraction");
    retornar om_mod_10_intern(g,"const",0,[]);
  }
  se((op=="mul")) {
    se((om_mod_15_literal(g,left,0)||om_mod_15_literal(g,right,0))) {
      push(ledger,"zero-product");
      retornar om_mod_10_intern(g,"const",0,[]);
    }
    se(om_mod_15_literal(g,left,1)) {
      push(ledger,"left-one");
      retornar right;
    }
    se(om_mod_15_literal(g,right,1)) {
      push(ledger,"right-one");
      retornar left;
    }
  }
  se((((op=="add")&&((a)[0]=="mul"))&&((b)[0]=="mul"))) {
    var i=0;
    enquanto((i<2)) {
      var j=0;
      enquanto((j<2)) {
        se((((a)[2])[i]==((b)[2])[j])) {
          var sum=om_mod_10_intern(g,"add",0,[((a)[2])[(1-i)],((b)[2])[(1-j)]]);
          se((sum<0)) {
            fail("Rewrite node budget");
          }
          push(ledger,"distributive-factorization");
          retornar om_mod_10_intern(g,"mul",0,[((a)[2])[i],sum]);
        }
        j=(j+1);
      }
      i=(i+1);
    }
  }
  retornar om_mod_10_intern(g,op,0,children);
}
funcao principal() {
  se((argc()!=2)) {
    fail("Usage: omega-recursive request.json");
  }
  var envelope=parsejson(read(arg(1)));
  var operation=(envelope)["operation"];
  var request=(envelope)["request"];
  var out=obj();
  se((operation=="dag")) {
    out=om_mod_10_execute(request);
  }
  senao {
    se((operation=="induce")) {
      out=om_mod_9_execute(request);
    }
    senao {
      se((operation=="improve")) {
        out=om_mod_15_execute(request);
      }
      senao {
        se((operation=="universe")) {
          out=om_mod_12_execute(request);
        }
        senao {
          se((operation=="quarantine")) {
            out=om_mod_14_execute(request);
          }
          senao {
            se((operation=="sieve")) {
              out=om_mod_13_execute(request);
            }
            senao {
              se((operation=="verify")) {
                out=om_mod_5_verify(request);
              }
              senao {
                se((operation=="compile")) {
                  out=om_mod_4_compile(om_mod_7_parse((request)["source"]),(request)["architecture"]);
                }
                senao {
                  fail("Unknown recursive workbench operation");
                }
              }
            }
          }
        }
      }
    }
  }
  print(om_mod_18_canonical(out));
  retornar 0;
}
