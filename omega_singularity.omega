}
funcao om_mod_17_pow_int(x,n) {
  se(((((n%1)!=0)||(n<0))||(n>1024))) {
    fail("Exponent budget");
  }
  var r=1;
  var i=0;
  enquanto((i<n)) {
    r=(r*x);
    i=(i+1);
  }
  retornar r;
}
funcao om_mod_17_precision(bits) {
  se(((((bits%1)!=0)||(bits<8))||(bits>128))) {
    fail("Precision must be 8..128 bits");
  }
  retornar om_mod_17_pow_int(2,bits);
}
funcao om_mod_17_rounded(lo,hi,scale) {
  retornar om_mod_17_box((qfloor((lo*scale))/scale),(om_mod_17_ceil_q((hi*scale))/scale));
}
funcao om_mod_17_sin_interval(x,bits) {
  var result=om_mod_17_trig_interval(x,bits);
  retornar (result)["sin"];
}
funcao om_mod_17_sqrt_interval(x,bits) {
  var scale=om_mod_17_precision(bits);
  se(((x<0)||(x>om_mod_17_pow_int(2,256)))) {
    fail("Square root domain");
  }
  se((x==0)) {
    retornar [0,0];
  }
  var hi=om_mod_17_max(1,x);
  var i=0;
  var lo=0;
  enquanto((i<1024)) {
    var next=(om_mod_17_ceil_q((((hi+(x/hi))*scale)/2))/scale);
    se((next>=hi)) {
      parar;
    }
    hi=next;
    i=(i+1);
  }
  lo=(qfloor(((x/hi)*scale))/scale);
  retornar om_mod_17_box(lo,hi);
}
funcao om_mod_17_times(a,b) {
  var p=[((a)[0]*(b)[0]),((a)[0]*(b)[1]),((a)[1]*(b)[0]),((a)[1]*(b)[1])];
  var lo=(p)[0];
  var hi=lo;
  var i=1;
  enquanto((i<4)) {
    lo=om_mod_17_min(lo,(p)[i]);
    hi=om_mod_17_max(hi,(p)[i]);
    i=(i+1);
  }
  retornar om_mod_17_box(lo,hi);
}
funcao om_mod_17_trig_interval(x,bits) {
  om_mod_17_precision(bits);
  se((om_mod_17_abs(x)>32)) {
    fail("Trigonometric domain is [-32,32]");
  }
  var shifts=(bits+14);
  var divisor=om_mod_17_pow_int(2,shifts);
  var u=(x/divisor);
  var scale=om_mod_17_pow_int(2,((bits+(2*shifts))+32));
  var error=((om_mod_17_pow_int(om_mod_17_abs(u),4)*5)/96);
  var s=om_mod_17_rounded(((u-(((u*u)*u)/6))-error),((u-(((u*u)*u)/6))+error),scale);
  var c=om_mod_17_rounded(((1-((u*u)/2))-error),((1-((u*u)/2))+error),scale);
  var i=0;
  enquanto((i<shifts)) {
    var product=om_mod_17_times(s,c);
    var ss=om_mod_17_times(s,s);
    var cc=om_mod_17_times(c,c);
    s=om_mod_17_rounded(om_mod_17_max((-1),(2*(product)[0])),om_mod_17_min(1,(2*(product)[1])),scale);
    c=om_mod_17_rounded(om_mod_17_max((-1),((cc)[0]-(ss)[1])),om_mod_17_min(1,((cc)[1]-(ss)[0])),scale);
    i=(i+1);
  }
  var output=obj();
  put(output,"sin",s);
  put(output,"cos",c);
  put(output,"small_angle",u);
  put(output,"doublings",shifts);
  retornar output;
}
funcao om_mod_18_as_list(x) {
  se((!islist(x))) {
    fail("List required");
  }
  retornar x;
}
funcao om_mod_18_as_number(x) {
  se((!isnum(x))) {
    fail("Rational required");
  }
  retornar x;
}
funcao om_mod_18_as_object(x) {
  se(((isnum(x)||isstr(x))||islist(x))) {
    fail("Object required");
  }
  retornar x;
}
funcao om_mod_18_as_string(x) {
  se((!isstr(x))) {
    fail("String required");
  }
  retornar x;
}
funcao om_mod_18_canonical(x) {
  se(isnum(x)) {
    retornar (("[\"q\","+json(om_mod_18_format_q(x)))+"]");
  }
  se(isstr(x)) {
    retornar (("[\"s\","+json(x))+"]");
  }
  se(islist(x)) {
    var items=[];
    var i=0;
    enquanto((i<len(x))) {
      push(items,om_mod_18_canonical((x)[i]));
      i=(i+1);
    }
    retornar (("[\"a\",["+join(items,","))+"]]");
  }
  var names=keys(x);
  var i=1;
  enquanto((i<len(names))) {
    var j=i;
    enquanto(((j>0)&&((names)[j]<(names)[(j-1)]))) {
      var tmp=(names)[j];
      put(names,j,(names)[(j-1)]);
      put(names,(j-1),tmp);
      j=(j-1);
    }
    i=(i+1);
  }
  var items=[];
  i=0;
  enquanto((i<len(names))) {
    var key=(names)[i];
    push(items,(((("["+json(key))+",")+om_mod_18_canonical((x)[key]))+"]"));
    i=(i+1);
  }
  retornar (("[\"o\",["+join(items,","))+"]]");
}
funcao om_mod_18_ends_with(s,suffix) {
  retornar ((len(s)>=len(suffix))&&(slice(s,(len(s)-len(suffix)),len(s))==suffix));
}
funcao om_mod_18_format_q(x) {
  retornar ((text(qnum(x))+"/")+text(qden(x)));
}
funcao om_mod_18_rational(s) {
  var parts=om_mod_18_split(s,"/");
  se((len(parts)==1)) {
    retornar number(s);
  }
  se((len(parts)!=2)) {
    fail("Rational text required");
  }
  var a=number((parts)[0]);
  var b=number((parts)[1]);
  se((((qden(a)!=1)||(qden(b)!=1))||(b==0))) {
    fail("Invalid rational pair");
  }
  retornar (a/b);
}
funcao om_mod_18_replace(s,old,value) {
  retornar join(om_mod_18_split(s,old),value);
}
funcao om_mod_18_split(s,delimiter) {
  se((len(delimiter)==0)) {
    fail("Nonempty delimiter required");
  }
  var out=[];
  var start=0;
  var i=0;
  enquanto(((i+len(delimiter))<=len(s))) {
    se((slice(s,i,(i+len(delimiter)))==delimiter)) {
      push(out,slice(s,start,i));
      i=(i+len(delimiter));
      start=i;
    }
    senao {
      i=(i+1);
    }
  }
  push(out,slice(s,start,len(s)));
  retornar out;
}
funcao om_mod_18_starts_with(s,prefix) {
  retornar ((len(s)>=len(prefix))&&(slice(s,0,len(prefix))==prefix));
}
funcao om_mod_18_trim(s) {
  var lo=0;
  var hi=len(s);
  enquanto(((lo<hi)&&contains(" \t\r\n",(s)[lo]))) {
    lo=(lo+1);
  }
  enquanto(((hi>lo)&&contains(" \t\r\n",(s)[(hi-1)]))) {
    hi=(hi-1);
  }
  retornar slice(s,lo,hi);
}
