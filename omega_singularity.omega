funcao om_mod_4_copy_environment(env) {
  var out=obj();
  var names=keys(env);
  var i=0;
  enquanto((i<len(names))) {
    put(out,(names)[i],(env)[(names)[i]]);
    i=(i+1);
  }
  retornar out;
}
funcao om_mod_4_expression(s,arch,ast,env,slots) {
  var slot=(256+(8*(slots)[0]));
  put(slots,0,((slots)[0]+1));
  se(((slots)[0]>256)) {
    fail("ELF expression slot budget");
  }
  var op=(ast)[0];
  se((op=="constant")) {
    om_mod_4_constant(s,arch,om_mod_0_val((ast)[1]));
  }
  se((op=="load")) {
    om_mod_4_load(s,arch,om_mod_4_result_register(arch),(env)[(ast)[1]]);
  }
  se((op=="unary")) {
    var operand=om_mod_4_expression(s,arch,(ast)[2],env,slots);
    om_mod_4_load(s,arch,om_mod_4_result_register(arch),operand);
    om_mod_4_unary(s,arch,(ast)[1]);
  }
  se((op=="binary")) {
    var left=om_mod_4_expression(s,arch,(ast)[2],env,slots);
    se((((ast)[1]=="&&")||((ast)[1]=="||"))) {
      var short=om_mod_3_fresh(s,"short_");
      var done=om_mod_3_fresh(s,"short_done_");
      om_mod_4_load(s,arch,om_mod_4_result_register(arch),left);
      se(((ast)[1]=="||")) {
        om_mod_4_unary(s,arch,"!");
      }
      om_mod_4_zero_branch(s,arch,short);
      var right=om_mod_4_expression(s,arch,(ast)[3],env,slots);
      om_mod_4_load(s,arch,om_mod_4_result_register(arch),right);
      om_mod_4_unary(s,arch,"!");
      om_mod_4_unary(s,arch,"!");
      om_mod_4_jump(s,arch,done);
      om_mod_3_mark(s,short);
      var value=0;
      se(((ast)[1]=="||")) {
        value=1;
      }
      om_mod_4_constant(s,arch,value);
      om_mod_3_mark(s,done);
    }
    senao {
      var right=om_mod_4_expression(s,arch,(ast)[3],env,slots);
      om_mod_4_load(s,arch,om_mod_4_result_register(arch),left);
      om_mod_4_load(s,arch,om_mod_4_rhs_register(arch),right);
      om_mod_4_binary(s,arch,(ast)[1]);
    }
  }
  om_mod_4_store(s,arch,slot);
  retornar slot;
