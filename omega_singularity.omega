funcao om_mod_3_create() {
  var s=obj();
  put(s,"bytes",[]);
  put(s,"labels",obj());
  put(s,"fixups",[]);
  put(s,"serial",0);
  retornar s;
}
funcao om_mod_3_emit(s,bytes) {
  var i=0;
  enquanto((i<len(bytes))) {
    om_mod_0_integer((bytes)[i],0,255);
    om_mod_3_octet(s,(bytes)[i]);
