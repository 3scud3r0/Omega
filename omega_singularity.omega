  om_mod_3_emit(s,[76,137,230,72,129,198]);
  om_mod_3_word(s,128);
  om_mod_8_load(s,1,176);
  om_mod_3_emit(s,[72,1,206]);
  om_mod_8_constant(s,2,18);
  om_mod_3_emit(s,[72,41,202]);
  om_mod_8_syscall(s,1);
  om_mod_3_emit(s,[72,131,248,252]);
  om_mod_8_conditional(s,4,"write_loop");
  om_mod_3_emit(s,[72,133,192]);
  om_mod_8_conditional(s,14,"exit_io");
  om_mod_8_add_count(s,176);
