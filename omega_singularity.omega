funcao om_mod_0_rref(raw) {
  var a=om_mod_0_copy(raw);
  var row=0;
  var col=0;
  var pivots=[];
  enquanto(((row<len(a))&&(col<len((a)[0])))) {
    var p=row;
    enquanto(((p<len(a))&&(((a)[p])[col]==0))) {
      p=(p+1);
    }
    se((p<len(a))) {
      var t=(a)[row];
      put(a,row,(a)[p]);
      put(a,p,t);
      var d=((a)[row])[col];
      var j=0;
      enquanto((j<len((a)[0]))) {
        put((a)[row],j,om_mod_0_check((((a)[row])[j]/d)));
        j=(j+1);
      }
      var i=0;
      enquanto((i<len(a))) {
        se((i!=row)) {
          var f=((a)[i])[col];
          j=0;
          enquanto((j<len((a)[0]))) {
            put((a)[i],j,om_mod_0_check((((a)[i])[j]-(f*((a)[row])[j]))));
            j=(j+1);
          }
        }
        i=(i+1);
      }
      push(pivots,col);
      row=(row+1);
    }
    col=(col+1);
  }
  var out=obj();
  put(out,"matrix",a);
  put(out,"pivots",pivots);
  put(out,"rank",row);
  retornar out;
}
funcao om_mod_0_scale(a,x) {
  var out=[];
  var i=0;
  enquanto((i<len(a))) {
    push(out,om_mod_0_check(((a)[i]*x)));
    i=(i+1);
  }
  retornar out;
}
funcao om_mod_0_solve(a,b) {
  var n=len(a);
  se(((n!=len((a)[0]))||(len(b)!=n))) {
    fail("Square solve shape");
  }
  var augmented=om_mod_0_copy(a);
  var i=0;
  enquanto((i<n)) {
    push((augmented)[i],(b)[i]);
    i=(i+1);
  }
  var reduced=om_mod_0_rref(augmented);
  se(((reduced)["rank"]!=n)) {
    fail("Singular linear system");
  }
  var x=[];
  i=0;
  enquanto((i<n)) {
    se((((reduced)["pivots"])[i]!=i)) {
      fail("Inconsistent linear system");
    }
    push(x,(((reduced)["matrix"])[i])[n]);
    i=(i+1);
  }
  retornar x;
}
