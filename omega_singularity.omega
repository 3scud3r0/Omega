# Six finite research components: native Omega with inert C/Python/WGSL source frames.
# Generate: python -m omega_recursive.amalgamation --generate
# No universal Solomonoff, intelligence-growth or physical-GPU performance claim.
funcao om_mod_17_abs(x) {
  se((x<0)) {
    retornar (-x);
  }
  retornar x;
}
funcao om_mod_17_box(lo,hi) {
  se((lo>hi)) {
    fail("Invalid enclosure");
  }
  retornar [lo,hi];
}
funcao om_mod_17_ceil_q(x) {
  retornar (-qfloor((-x)));
}
funcao om_mod_17_cos_interval(x,bits) {
  var result=om_mod_17_trig_interval(x,bits);
  retornar (result)["cos"];
}
funcao om_mod_17_exp_interval(x,bits) {
  var scale=om_mod_17_precision(bits);
  se((om_mod_17_abs(x)>32)) {
    fail("Exponential domain is [-32,32]");
  }
  se((x==0)) {
    retornar [1,1];
  }
  var u=om_mod_17_abs(x);
  var shifts=0;
  enquanto((u>1)) {
    u=(u/2);
    shifts=(shifts+1);
  }
  scale=om_mod_17_pow_int(2,((bits+(2*om_mod_17_ceil_q(om_mod_17_abs(x))))+24));
  var n=((bits+(2*om_mod_17_ceil_q(om_mod_17_abs(x))))+32);
  var sum=0;
  var term=1;
  var fact=1;
  var i=0;
  enquanto((i<n)) {
    sum=(sum+term);
    i=(i+1);
    term=((term*u)/i);
    fact=(fact*i);
  }
  var error=((n+1)/(fact*n));
  var interval=om_mod_17_rounded((sum-error),(sum+error),scale);
  i=0;
  enquanto((i<shifts)) {
    interval=om_mod_17_rounded(((interval)[0]*(interval)[0]),((interval)[1]*(interval)[1]),scale);
    i=(i+1);
  }
  se((x<0)) {
    se(((interval)[0]<=0)) {
      fail("Unproved positive exponential");
    }
    interval=om_mod_17_rounded((1/(interval)[1]),(1/(interval)[0]),scale);
  }
  retornar interval;
}
funcao om_mod_17_floor_q(x) {
  retornar qfloor(x);
}
funcao om_mod_17_log_interval(x,bits) {
  var scale=om_mod_17_precision(bits);
  var bound=om_mod_17_pow_int(2,32);
  se((((x<=0)||(x<(1/bound)))||(x>bound))) {
    fail("Log domain is [2^-32,2^32]");
  }
  se((x==1)) {
    retornar [0,0];
  }
  var m=x;
  var k=0;
  enquanto((m>2)) {
    m=(m/2);
    k=(k+1);
  }
  enquanto((m<1)) {
    m=(m*2);
    k=(k-1);
  }
  var a=om_mod_17_log_unit(m,(bits+16));
  var b=om_mod_17_log_unit(2,(bits+16));
  var lo=(a)[0];
  var hi=(a)[1];
  se((k>=0)) {
    lo=(lo+(k*(b)[0]));
    hi=(hi+(k*(b)[1]));
  }
  senao {
    lo=(lo+(k*(b)[1]));
    hi=(hi+(k*(b)[0]));
  }
  retornar om_mod_17_rounded(lo,hi,scale);
}
funcao om_mod_17_log_unit(x,n) {
  var z=((x-1)/(x+1));
  var term=z;
  var sum=0;
  var i=1;
  enquanto((i<=n)) {
    se(((i%2)==1)) {
      sum=(sum+((2*term)/i));
    }
    term=(term*z);
    i=(i+1);
  }
  var error=((2*om_mod_17_abs(term))/(1-om_mod_17_abs(z)));
  retornar om_mod_17_box((sum-error),(sum+error));
}
funcao om_mod_17_max(a,b) {
  se((a>b)) {
    retornar a;
  }
  retornar b;
}
funcao om_mod_17_min(a,b) {
  se((a<b)) {
    retornar a;
  }
