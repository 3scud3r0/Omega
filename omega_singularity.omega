funcao om_mod_3_fresh(s,prefix) {
  var label=(prefix+text((s)["serial"]));
  put(s,"serial",((s)["serial"]+1));
  retornar label;
}
funcao om_mod_3_hex(bytes) {
  var digits="0123456789abcdef";
  var pieces=[];
  var i=0;
  enquanto((i<len(bytes))) {
    var value=om_mod_0_integer((bytes)[i],0,255);
    push(pieces,((digits)[qfloor((value/16))]+(digits)[(value%16)]));
    i=(i+1);
  }
  retornar join(pieces,"");
