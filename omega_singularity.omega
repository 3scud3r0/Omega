funcao om_mod_0_power(x,n) {
  om_mod_0_integer(n,(-128),128);
  se((n<0)) {
    se((x==0)) {
      fail("Negative power of zero");
    }
    retornar (1/om_mod_0_power(x,(-n)));
  }
  var y=1;
  enquanto((n>0)) {
    se(((n%2)==1)) {
      y=om_mod_0_check((y*x));
    }
    n=qfloor((n/2));
    se((n>0)) {
      x=om_mod_0_check((x*x));
    }
  }
  retornar y;
}
