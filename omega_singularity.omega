funcao om_mod_5_arity(op) {
  se(contains(["pi","lambda","app","sigma","annotation","refl","absurd","nat-add","nat-mul","rat-add","rat-mul"],op)) {
    retornar 2;
  }
  se(contains(["let","pair","equality","transport"],op)) {
    retornar 3;
  }
  se(contains(["first","second","successor","rat-neg"],op)) {
    retornar 1;
  }
  se((op=="nat-rec")) {
    retornar 4;
  }
  se(contains(["sort","var","nat","zero","nat-literal","unit","unit-value","empty","constant","rat","rat-literal"],op)) {
    retornar 0;
  }
  retornar (-1);
}
funcao om_mod_5_atom(state,op) {
  retornar om_mod_5_make_node(state,op,[],[]);
}
funcao om_mod_5_binary(state,op,a,b) {
  retornar om_mod_5_make_node(state,op,[a,b],[]);
}
funcao om_mod_5_binder(op,index) {
  retornar ((contains(["pi","lambda","sigma"],op)&&(index==1))||((op=="let")&&(index==2)));
}
funcao om_mod_5_check_term(state,term,expected,depth) {
  var actual=om_mod_5_infer_term(state,term,(depth+1));
  se(((actual<0)||(!om_mod_5_equal_terms(state,actual,expected,(depth+1))))) {
    om_mod_5_fault(state,"type-mismatch",term);
    retornar 0;
  }
  retornar ((state)["error"]=="");
}
funcao om_mod_5_data_arity(op) {
  se((op=="rat-literal")) {
    retornar 2;
  }
  se(contains(["sort","var","constant","nat-literal"],op)) {
    retornar 1;
  }
  retornar 0;
}
funcao om_mod_5_equal_terms(state,left,right,depth) {
  se((!om_mod_5_tick(state,left,depth))) {
    retornar 0;
  }
  se((((left==right)&&(left>=0))&&(left<len((state)["nodes"])))) {
    retornar 1;
  }
  left=om_mod_5_normal(state,left,(depth+1));
  right=om_mod_5_normal(state,right,(depth+1));
  se(((state)["error"]!="")) {
    retornar 0;
  }
  var a=om_mod_5_node(state,left);
  var b=om_mod_5_node(state,right);
  se(((((a)[0]!=(b)[0])||(len((a)[2])!=len((b)[2])))||(len((a)[1])!=len((b)[1])))) {
    retornar 0;
  }
  var i=0;
  enquanto((i<len((a)[2]))) {
    se((((a)[2])[i]!=((b)[2])[i])) {
      retornar 0;
    }
    i=(i+1);
  }
  i=0;
  enquanto((i<len((a)[1]))) {
    se((!om_mod_5_equal_terms(state,((a)[1])[i],((b)[1])[i],(depth+1)))) {
      retornar 0;
    }
    i=(i+1);
  }
  retornar 1;
}
funcao om_mod_5_fault(state,code,node) {
  se(((state)["error"]=="")) {
    put(state,"error",code);
    put(state,"error_node",node);
  }
  retornar (-1);
}
funcao om_mod_5_fields(raw,allowed) {
  se(((isnum(raw)||isstr(raw))||islist(raw))) {
    fail("Proof protocol object required");
  }
  var names=keys(raw);
  var i=0;
  enquanto((i<len(names))) {
    se((!contains(allowed,(names)[i]))) {
      fail("Unknown proof protocol field");
    }
    i=(i+1);
  }
  retornar 0;
}
funcao om_mod_5_infer_term(state,id,depth) {
  se((!om_mod_5_tick(state,id,depth))) {
    retornar (-1);
  }
  var term=om_mod_5_node(state,id);
  var op=(term)[0];
  var args=(term)[1];
  se((op=="sort")) {
    se((((term)[2])[0]>31)) {
      retornar om_mod_5_fault(state,"universe-limit",id);
    }
    retornar om_mod_5_sort_node(state,(((term)[2])[0]+1));
  }
  se((op=="var")) {
    var k=((term)[2])[0];
    se(((k<0)||(k>=(state)["context_depth"]))) {
      retornar om_mod_5_fault(state,"scope",id);
    }
    retornar om_mod_5_shift(state,((state)["context"])[(((state)["context_depth"]-1)-k)],(k+1),0,(depth+1));
  }
  se(((op=="pi")||(op=="sigma"))) {
    var a=om_mod_5_type_level(state,(args)[0],(depth+1));
    se(((a<0)||(!om_mod_5_push_context(state,(args)[0],id)))) {
      retornar (-1);
    }
    var b=om_mod_5_type_level(state,(args)[1],(depth+1));
    put(state,"context_depth",((state)["context_depth"]-1));
    se((b<0)) {
      retornar (-1);
    }
    retornar om_mod_5_sort_node(state,om_mod_17_max(a,b));
  }
  se((op=="lambda")) {
    se(((om_mod_5_type_level(state,(args)[0],(depth+1))<0)||(!om_mod_5_push_context(state,(args)[0],id)))) {
      retornar (-1);
    }
    var body=om_mod_5_infer_term(state,(args)[1],(depth+1));
    put(state,"context_depth",((state)["context_depth"]-1));
    retornar om_mod_5_binary(state,"pi",(args)[0],body);
  }
  se((op=="app")) {
    var fn=om_mod_5_node(state,om_mod_5_normal(state,om_mod_5_infer_term(state,(args)[0],(depth+1)),(depth+1)));
    se(((fn)[0]!="pi")) {
      retornar om_mod_5_fault(state,"not-a-function",id);
    }
    se((!om_mod_5_check_term(state,(args)[1],((fn)[1])[0],(depth+1)))) {
      retornar (-1);
    }
    retornar om_mod_5_instantiate(state,((fn)[1])[1],(args)[1],(depth+1));
  }
  se((op=="let")) {
    se((((om_mod_5_type_level(state,(args)[0],(depth+1))<0)||(!om_mod_5_check_term(state,(args)[1],(args)[0],(depth+1))))||(!om_mod_5_push_context(state,(args)[0],id)))) {
      retornar (-1);
    }
    var body=om_mod_5_infer_term(state,(args)[2],(depth+1));
    put(state,"context_depth",((state)["context_depth"]-1));
    retornar om_mod_5_instantiate(state,body,(args)[1],(depth+1));
  }
  se((op=="annotation")) {
    se(((om_mod_5_type_level(state,(args)[1],(depth+1))<0)||(!om_mod_5_check_term(state,(args)[0],(args)[1],(depth+1))))) {
      retornar (-1);
    }
