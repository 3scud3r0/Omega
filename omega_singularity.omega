# OMEGA-KERNEL-FILE "kernel/native/sha256.h"
#|#ifndef OMEGA_KERNEL_SHA256_H
#|#define OMEGA_KERNEL_SHA256_H
#|#include <stdint.h>
#|#include <stddef.h>
#|
#|typedef struct {
#|    uint32_t state[8];
#|    uint64_t bytes;
#|    unsigned char block[64];
#|    size_t used;
#|} ok_sha256;
#|
#|static inline uint32_t ok_rotr32(uint32_t x, unsigned n)
#|{
#|    return (x >> n) | (x << (32 - n));
#|}
#|
#|static void ok_sha256_transform(ok_sha256 *s, const unsigned char *data)
#|{
#|    static const uint32_t constants[64] = {
#|        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
#|        0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
#|        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
#|        0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
#|        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
#|        0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
#|        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
#|        0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
#|        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
#|        0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
#|        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
#|        0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
#|        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
#|        0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
#|        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
#|        0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
#|    };
#|    uint32_t w[64];
#|    for (unsigned i = 0; i < 16; ++i) {
#|        w[i] = (uint32_t)data[4*i] << 24 |
#|               (uint32_t)data[4*i+1] << 16 |
#|               (uint32_t)data[4*i+2] << 8 |
#|               data[4*i+3];
#|    }
#|    for (unsigned i = 16; i < 64; ++i) {
#|        uint32_t a = ok_rotr32(w[i-15], 7) ^ ok_rotr32(w[i-15], 18) ^ (w[i-15] >> 3);
#|        uint32_t b = ok_rotr32(w[i-2], 17) ^ ok_rotr32(w[i-2], 19) ^ (w[i-2] >> 10);
#|        w[i] = w[i-16] + a + w[i-7] + b;
#|    }
#|    uint32_t a = s->state[0];
#|    uint32_t b = s->state[1];
#|    uint32_t c = s->state[2];
#|    uint32_t d = s->state[3];
#|    uint32_t e = s->state[4];
#|    uint32_t f = s->state[5];
#|    uint32_t g = s->state[6];
#|    uint32_t h = s->state[7];
#|    for (unsigned i = 0; i < 64; ++i) {
#|        uint32_t sigma1 = ok_rotr32(e,6) ^ ok_rotr32(e,11) ^ ok_rotr32(e,25);
#|        uint32_t choose = (e & f) ^ (~e & g);
#|        uint32_t t1 = h + sigma1 + choose + constants[i] + w[i];
#|        uint32_t sigma0 = ok_rotr32(a,2) ^ ok_rotr32(a,13) ^ ok_rotr32(a,22);
#|        uint32_t majority = (a & b) ^ (a & c) ^ (b & c);
#|        uint32_t t2 = sigma0 + majority;
#|        h = g;
#|        g = f;
#|        f = e;
#|        e = d + t1;
#|        d = c;
#|        c = b;
#|        b = a;
#|        a = t1 + t2;
#|    }
#|    s->state[0] += a;
#|    s->state[1] += b;
#|    s->state[2] += c;
#|    s->state[3] += d;
#|    s->state[4] += e;
#|    s->state[5] += f;
#|    s->state[6] += g;
#|    s->state[7] += h;
#|}
#|
#|static inline void ok_sha256_init(ok_sha256 *s)
#|{
#|    static const uint32_t initial[8] = {
#|        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
#|        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
#|    };
#|    for (unsigned i = 0; i < 8; ++i) {
#|        s->state[i] = initial[i];
#|    }
#|    s->bytes = 0;
#|    s->used = 0;
#|}
#|
#|static inline int ok_sha256_update(ok_sha256 *s, const void *buffer, size_t length)
#|{
#|    const unsigned char *data = buffer;
#|    if (!s || (!data && length) || length > UINT64_MAX / 8 - s->bytes) {
#|        return 0;
#|    }
#|    s->bytes += length;
#|    while (length) {
#|        size_t n = 64 - s->used;
#|        if (n > length) {
#|            n = length;
#|        }
#|        for (size_t i = 0; i < n; ++i) {
#|            s->block[s->used+i] = data[i];
#|        }
#|        s->used += n;
#|        data += n;
#|        length -= n;
#|        if (s->used == 64) {
#|            ok_sha256_transform(s, s->block);
#|            s->used = 0;
#|        }
#|    }
#|    return 1;
#|}
#|
#|static inline void ok_sha256_finish(ok_sha256 *s, unsigned char digest[32])
#|{
#|    uint64_t bits = s->bytes * 8;
#|    s->block[s->used++] = 0x80;
#|    if (s->used > 56) {
#|        while (s->used < 64) {
#|            s->block[s->used++] = 0;
#|        }
#|        ok_sha256_transform(s, s->block);
#|        s->used = 0;
#|    }
#|    while (s->used < 56) {
#|        s->block[s->used++] = 0;
#|    }
#|    for (unsigned i = 0; i < 8; ++i) {
#|        s->block[63-i] = (unsigned char)(bits >> (8*i));
#|    }
#|    ok_sha256_transform(s, s->block);
#|    for (unsigned i = 0; i < 8; ++i) {
#|        digest[4*i] = (unsigned char)(s->state[i] >> 24);
#|        digest[4*i+1] = (unsigned char)(s->state[i] >> 16);
#|        digest[4*i+2] = (unsigned char)(s->state[i] >> 8);
#|        digest[4*i+3] = (unsigned char)s->state[i];
#|    }
#|}
#|
#|static inline void ok_sha256_hex(const void *data, size_t size, char output[65])
#|{
#|    static const char hex[] = "0123456789abcdef";
#|    ok_sha256 state;
#|    unsigned char digest[32];
#|    ok_sha256_init(&state);
#|    ok_sha256_update(&state, data, size);
#|    ok_sha256_finish(&state, digest);
#|    for (unsigned i = 0; i < 32; ++i) {
#|        output[2*i] = hex[digest[i] >> 4];
#|        output[2*i+1] = hex[digest[i] & 15];
#|    }
#|    output[64] = 0;
#|}
#|
#|#endif
# OMEGA-KERNEL-FILE-END
# OMEGA-KERNEL-FILE "kernel/native/tensor.h"
#|#ifndef OMEGA_KERNEL_TENSOR_H
#|#define OMEGA_KERNEL_TENSOR_H
#|
#|/* Exact structure-of-arrays batches. SIMD is used only after lane range checks.
#| * Overflow is a per-lane result, never a wrapped value masquerading as Q.
#| * Inputs/outputs are caller-owned, non-overlapping contiguous arrays.
#| */
#|#include <stddef.h>
#|#include <stdint.h>
#|#include <limits.h>
#|#include "../../omega_selfhost/bounded_rational.h"
#|
#|#if defined(__x86_64__) && defined(__GNUC__)
#|#include <immintrin.h>
#|#define OKQ_X86_SIMD 1
#|#else
#|#define OKQ_X86_SIMD 0
#|#endif
#|
#|#if defined(__aarch64__) && defined(__ARM_NEON)
#|#include <arm_neon.h>
#|#define OKQ_ARM_SIMD 1
#|#else
#|#define OKQ_ARM_SIMD 0
#|#endif
#|
#|enum {
#|    OKQ_AUTO,
#|    OKQ_SCALAR,
#|    OKQ_AVX2,
#|    OKQ_AVX512,
#|    OKQ_NEON
#|};
#|
#|enum {
#|    OKQ_ADD,
#|    OKQ_MULTIPLY
#|};
#|
#|enum {
#|    OKQ_SUCCESS,
#|    OKQ_BAD_ARGUMENT,
#|    OKQ_UNSUPPORTED,
#|    OKQ_ARITHMETIC_OVERFLOW,
#|    OKQ_BAD_RATIONAL
#|};
#|
#|typedef struct {
#|    const int64_t *numerators;
#|    const uint64_t *denominators;
#|    size_t length;
#|} okq_view;
#|
#|typedef struct {
#|    int64_t *numerators;
#|    uint64_t *denominators;
#|    uint8_t *status;
#|    size_t capacity;
#|} okq_output;
#|
#|typedef struct {
#|    unsigned backend;
#|    size_t simd_lanes;
#|    size_t scalar_lanes;
#|    size_t failed_lanes;
#|} okq_statistics;
#|
#|static inline int okq_available(unsigned backend)
#|{
#|    if (backend == OKQ_AUTO || backend == OKQ_SCALAR) {
#|        return 1;
#|    }
#|#if OKQ_X86_SIMD
#|    __builtin_cpu_init();
#|    if (backend == OKQ_AVX2) {
#|        return !!__builtin_cpu_supports("avx2");
#|    }
#|    if (backend == OKQ_AVX512) {
#|        return __builtin_cpu_supports("avx512f") &&
#|               __builtin_cpu_supports("avx512dq") &&
#|               __builtin_cpu_supports("avx512bw");
#|    }
#|#endif
#|#if OKQ_ARM_SIMD
#|    if (backend == OKQ_NEON) {
#|        return 1;
#|    }
#|#endif
#|    return 0;
#|}
#|
#|static inline unsigned okq_choose(unsigned requested)
#|{
#|    if (requested != OKQ_AUTO) {
#|        return okq_available(requested) ? requested : UINT_MAX;
#|    }
#|    if (okq_available(OKQ_AVX512)) {
#|        return OKQ_AVX512;
#|    }
#|    if (okq_available(OKQ_AVX2)) {
#|        return OKQ_AVX2;
#|    }
#|    if (okq_available(OKQ_NEON)) {
#|        return OKQ_NEON;
#|    }
#|    return OKQ_SCALAR;
#|}
#|
#|static inline int okq_small_lane(okq_view a, okq_view b, size_t i)
#|{
#|    return a.numerators[i] >= INT32_MIN && a.numerators[i] <= INT32_MAX &&
#|           b.numerators[i] >= INT32_MIN && b.numerators[i] <= INT32_MAX &&
#|           a.denominators[i] > 0 && a.denominators[i] <= INT32_MAX &&
#|           b.denominators[i] > 0 && b.denominators[i] <= INT32_MAX;
#|}
#|
#|static inline int okq_block_eligible(okq_view a, okq_view b, size_t start, size_t width)
#|{
#|    if (width > a.length - start) {
#|        return 0;
#|    }
#|    for (size_t i = 0; i < width; ++i) {
#|        if (!okq_small_lane(a,b,start+i)) {
#|            return 0;
#|        }
#|    }
#|    return 1;
#|}
#|
#|#if OKQ_X86_SIMD
#|__attribute__((target("avx2")))
#|static void okq_avx2_products(okq_view a, okq_view b, size_t start, unsigned operation,
#|                              int64_t numerator[4], uint64_t denominator[4])
#|{
#|    __m256i an = _mm256_loadu_si256((const __m256i *)(const void *)(a.numerators+start));
#|    __m256i ad = _mm256_loadu_si256((const __m256i *)(const void *)(a.denominators+start));
#|    __m256i bn = _mm256_loadu_si256((const __m256i *)(const void *)(b.numerators+start));
#|    __m256i bd = _mm256_loadu_si256((const __m256i *)(const void *)(b.denominators+start));
#|    __m256i n;
#|    if (operation == OKQ_ADD) {
#|        n = _mm256_add_epi64(_mm256_mul_epi32(an,bd),_mm256_mul_epi32(bn,ad));
#|    } else {
#|        n = _mm256_mul_epi32(an,bn);
#|    }
#|    __m256i d = _mm256_mul_epu32(ad,bd);
#|    _mm256_storeu_si256((__m256i *)(void *)numerator,n);
#|    _mm256_storeu_si256((__m256i *)(void *)denominator,d);
#|}
#|
#|__attribute__((target("avx512f,avx512dq,avx512bw")))
#|static void okq_avx512_products(okq_view a, okq_view b, size_t start, unsigned operation,
#|                                int64_t numerator[8], uint64_t denominator[8])
#|{
#|    __m512i an = _mm512_loadu_si512((const void *)(a.numerators+start));
#|    __m512i ad = _mm512_loadu_si512((const void *)(a.denominators+start));
#|    __m512i bn = _mm512_loadu_si512((const void *)(b.numerators+start));
#|    __m512i bd = _mm512_loadu_si512((const void *)(b.denominators+start));
#|    __m512i n;
#|    if (operation == OKQ_ADD) {
#|        n = _mm512_add_epi64(_mm512_mul_epi32(an,bd),_mm512_mul_epi32(bn,ad));
#|    } else {
#|        n = _mm512_mul_epi32(an,bn);
#|    }
#|    __m512i d = _mm512_mul_epu32(ad,bd);
#|    _mm512_storeu_si512((void *)numerator,n);
#|    _mm512_storeu_si512((void *)denominator,d);
#|}
#|
#|__attribute__((target("avx2")))
#|static int64_t okq_avx2_dot16(const int16_t *a, const int16_t *b, size_t n)
#|{
#|    __m256i low = _mm256_setzero_si256();
#|    __m256i high = _mm256_setzero_si256();
#|    size_t i = 0;
#|    for (; i+16 <= n; i+=16) {
#|        __m256i x = _mm256_loadu_si256((const __m256i *)(const void *)(a+i));
#|        __m256i y = _mm256_loadu_si256((const __m256i *)(const void *)(b+i));
#|        __m256i p = _mm256_madd_epi16(x,y);
#|        low = _mm256_add_epi64(low,_mm256_cvtepi32_epi64(_mm256_castsi256_si128(p)));
#|        high = _mm256_add_epi64(high,_mm256_cvtepi32_epi64(_mm256_extracti128_si256(p,1)));
#|    }
#|    int64_t lanes[4];
#|    _mm256_storeu_si256((__m256i *)(void *)lanes,_mm256_add_epi64(low,high));
#|    int64_t sum = lanes[0]+lanes[1]+lanes[2]+lanes[3];
#|    for (; i<n; ++i) {
#|        sum += (int64_t)a[i]*b[i];
#|    }
#|    return sum;
#|}
#|
#|__attribute__((target("avx512f,avx512dq,avx512bw")))
#|static int64_t okq_avx512_dot16(const int16_t *a, const int16_t *b, size_t n)
#|{
#|    __m512i low = _mm512_setzero_si512();
#|    __m512i high = _mm512_setzero_si512();
#|    size_t i = 0;
#|    for (; i+32<=n; i+=32) {
#|        __m512i x = _mm512_loadu_si512((const void *)(a+i));
#|        __m512i y = _mm512_loadu_si512((const void *)(b+i));
#|        __m512i p = _mm512_madd_epi16(x,y);
#|        low = _mm512_add_epi64(low,_mm512_cvtepi32_epi64(_mm512_castsi512_si256(p)));
#|        high = _mm512_add_epi64(high,_mm512_cvtepi32_epi64(_mm512_extracti64x4_epi64(p,1)));
#|    }
#|    int64_t lanes[8];
#|    _mm512_storeu_si512((void *)lanes,_mm512_add_epi64(low,high));
#|    int64_t sum = 0;
#|    for (unsigned k=0;k<8;++k) {
#|        sum += lanes[k];
#|    }
#|    for (;i<n;++i) {
#|        sum += (int64_t)a[i]*b[i];
#|    }
#|    return sum;
#|}
#|#endif
#|
#|#if OKQ_ARM_SIMD
#|static void okq_neon_products(okq_view a, okq_view b, size_t start, unsigned operation,
#|                               int64_t numerator[2], uint64_t denominator[2])
#|{
#|    int32_t an[2] = {(int32_t)a.numerators[start],(int32_t)a.numerators[start+1]};
#|    int32_t bn[2] = {(int32_t)b.numerators[start],(int32_t)b.numerators[start+1]};
#|    int32_t ad[2] = {(int32_t)a.denominators[start],(int32_t)a.denominators[start+1]};
#|    int32_t bd[2] = {(int32_t)b.denominators[start],(int32_t)b.denominators[start+1]};
#|    int64x2_t n;
#|    if (operation == OKQ_ADD) {
#|        n = vaddq_s64(vmull_s32(vld1_s32(an),vld1_s32(bd)),
#|                       vmull_s32(vld1_s32(bn),vld1_s32(ad)));
#|    } else {
#|        n = vmull_s32(vld1_s32(an),vld1_s32(bn));
#|    }
#|    int64x2_t d = vmull_s32(vld1_s32(ad),vld1_s32(bd));
#|    vst1q_s64(numerator,n);
#|    vst1q_u64(denominator,vreinterpretq_u64_s64(d));
#|}
#|
#|static int64_t okq_neon_dot16(const int16_t *a, const int16_t *b, size_t n)
#|{
#|    int64x2_t sum = vdupq_n_s64(0);
#|    size_t i=0;
#|    for (;i+8<=n;i+=8) {
#|        int16x8_t x=vld1q_s16(a+i);
#|        int16x8_t y=vld1q_s16(b+i);
#|        sum=vpadalq_s32(sum,vmull_s16(vget_low_s16(x),vget_low_s16(y)));
#|        sum=vpadalq_s32(sum,vmull_s16(vget_high_s16(x),vget_high_s16(y)));
#|    }
#|    int64_t result=vgetq_lane_s64(sum,0)+vgetq_lane_s64(sum,1);
#|    for (;i<n;++i) {
#|        result+=(int64_t)a[i]*b[i];
#|    }
#|    return result;
#|}
#|#endif
#|
#|static inline int64_t okq_dot16(const int16_t *a, const int16_t *b, size_t n,
#|                                unsigned backend)
#|{
#|    /* Caller proves |a[i]|,|b[i]|<=32767 and n<=4096 before dispatch. */
#|#if OKQ_X86_SIMD
#|    if (backend==OKQ_AVX512) {
#|        return okq_avx512_dot16(a,b,n);
#|    }
#|    if (backend==OKQ_AVX2) {
#|        return okq_avx2_dot16(a,b,n);
#|    }
#|#endif
#|#if OKQ_ARM_SIMD
#|    if (backend==OKQ_NEON) {
#|        return okq_neon_dot16(a,b,n);
#|    }
#|#endif
#|    int64_t result=0;
#|    for (size_t i=0;i<n;++i) {
#|        result+=(int64_t)a[i]*b[i];
#|    }
#|    return result;
#|}
#|
#|static inline void okq_store(okq_output out, size_t index, int status,
#|                              omega_q64 value, okq_statistics *statistics)
#|{
#|    if (status != OMEGA_Q_OK) {
#|        out.numerators[index]=0;
#|        out.denominators[index]=1;
#|        out.status[index]=status==OMEGA_Q_OVERFLOW ?
#|            OKQ_ARITHMETIC_OVERFLOW : OKQ_BAD_RATIONAL;
#|        statistics->failed_lanes++;
#|    } else {
#|        out.numerators[index]=value.numerator;
#|        out.denominators[index]=value.denominator;
#|        out.status[index]=OKQ_SUCCESS;
#|    }
#|}
#|
#|static inline int okq_batch(okq_view a, okq_view b, okq_output out,
#|                            unsigned operation, unsigned requested,
#|                            okq_statistics *statistics)
#|{
#|    if (!statistics || !a.numerators || !a.denominators || !b.numerators ||
#|        !b.denominators || !out.numerators || !out.denominators || !out.status ||
#|        a.length != b.length || a.length > out.capacity || a.length>1048576 ||
#|        operation>OKQ_MULTIPLY || requested>OKQ_NEON) {
#|        return OKQ_BAD_ARGUMENT;
#|    }
#|    statistics->backend=okq_choose(requested);
#|    statistics->simd_lanes=0;
#|    statistics->scalar_lanes=0;
#|    statistics->failed_lanes=0;
#|    if (statistics->backend==UINT_MAX) {
#|        return OKQ_UNSUPPORTED;
#|    }
#|    unsigned width=1;
#|    if (statistics->backend==OKQ_AVX512) {
#|        width=8;
#|    } else if (statistics->backend==OKQ_AVX2) {
#|        width=4;
#|    } else if (statistics->backend==OKQ_NEON) {
#|        width=2;
#|    }
#|    size_t i=0;
#|    while (i<a.length) {
#|        if (width>1 && okq_block_eligible(a,b,i,width)) {
#|            int64_t numerators[8];
#|            uint64_t denominators[8];
#|#if OKQ_X86_SIMD
#|            if (statistics->backend==OKQ_AVX512) {
#|                okq_avx512_products(a,b,i,operation,numerators,denominators);
#|            } else if (statistics->backend==OKQ_AVX2) {
#|                okq_avx2_products(a,b,i,operation,numerators,denominators);
#|            }
#|#endif
#|#if OKQ_ARM_SIMD
#|            if (statistics->backend==OKQ_NEON) {
#|                okq_neon_products(a,b,i,operation,numerators,denominators);
#|            }
#|#endif
#|            for (unsigned j=0;j<width;++j) {
#|                omega_q64 value={0,1};
#|                int status=omega_q64_make(&value,numerators[j],denominators[j]);
#|                okq_store(out,i+j,status,value,statistics);
#|            }
#|            statistics->simd_lanes+=width;
#|            i+=width;
#|            continue;
#|        }
#|        omega_q64 x={a.numerators[i],a.denominators[i]};
#|        omega_q64 y={b.numerators[i],b.denominators[i]};
#|        omega_q64 value={0,1};
#|        int status=operation==OKQ_ADD ? omega_q64_add(&value,x,y) :
#|                                       omega_q64_mul(&value,x,y);
#|        okq_store(out,i,status,value,statistics);
#|        statistics->scalar_lanes++;
#|        i++;
#|    }
#|    return OKQ_SUCCESS;
#|}
#|
#|static inline int okq_gemm64(okq_view a, okq_view b, okq_output out,
#|                              size_t rows, size_t inner, size_t columns)
#|{
#|    if (!rows || !inner || !columns || rows>1024 || inner>4096 || columns>1024 ||
#|        a.length!=rows*inner || b.length!=inner*columns ||
#|        out.capacity<rows*columns || !a.numerators || !a.denominators ||
#|        !b.numerators || !b.denominators || !out.numerators ||
#|        !out.denominators || !out.status) {
#|        return OKQ_BAD_ARGUMENT;
#|    }
#|    for (size_t i=0;i<rows;++i) {
#|        for (size_t j=0;j<columns;++j) {
#|            omega_q64 accumulator={0,1};
#|            int status=OMEGA_Q_OK;
#|            for (size_t k=0;k<inner;++k) {
#|                omega_q64 x={a.numerators[i*inner+k],a.denominators[i*inner+k]};
#|                omega_q64 y={b.numerators[k*columns+j],b.denominators[k*columns+j]};
#|                omega_q64 product;
#|                status=omega_q64_mul(&product,x,y);
#|                if (status!=OMEGA_Q_OK) {
#|                    break;
#|                }
#|                status=omega_q64_add(&accumulator,accumulator,product);
#|                if (status!=OMEGA_Q_OK) {
#|                    break;
#|                }
#|            }
#|            size_t index=i*columns+j;
#|            out.status[index]=status==OMEGA_Q_OK ? OKQ_SUCCESS :
#|                status==OMEGA_Q_OVERFLOW ? OKQ_ARITHMETIC_OVERFLOW : OKQ_BAD_RATIONAL;
#|            out.numerators[index]=status==OMEGA_Q_OK ? accumulator.numerator : 0;
#|            out.denominators[index]=status==OMEGA_Q_OK ? accumulator.denominator : 1;
#|        }
#|    }
#|    return OKQ_SUCCESS;
#|}
#|
#|#endif
# OMEGA-KERNEL-FILE-END
# OMEGA-KERNEL-FILE "kernel/native/tensor_gmp.h"
#|#ifndef OMEGA_KERNEL_TENSOR_GMP_H
#|#define OMEGA_KERNEL_TENSOR_GMP_H
#|
#|/* A matrix is an integer grid over one positive common denominator. Matrix
#| * products normalize once per output matrix, not once per multiply-accumulate.
#| * A compact int16 representation activates checked SIMD dot products. General
#| * inputs retain GMP precision; no denominator is truncated to make them fit.
#| */
#|#include <gmp.h>
#|#include <stdlib.h>
#|#include <stdint.h>
#|#include <stddef.h>
#|#include "tensor.h"
#|
#|_Static_assert(sizeof(long) >= 8, "GMP compact dot path requires a 64-bit long");
#|
#|enum {
#|    OKG_SUCCESS,
#|    OKG_ARGUMENT,
#|    OKG_ALLOCATION,
#|    OKG_BUDGET,
#|    OKG_INPUT,
#|    OKG_SHAPE
#|};
#|
#|typedef struct {
#|    size_t limit;
#|    size_t charged;
#|    size_t peak;
#|    unsigned bits;
#|} okg_budget;
#|
#|typedef struct {
#|    size_t rows;
#|    size_t columns;
#|    size_t count;
#|    mpz_t *numerators;
#|    mpz_t denominator;
#|    okg_budget *budget;
#|    size_t charge;
#|    unsigned initialized;
#|    unsigned backend;
#|    size_t simd_products;
#|} okg_matrix;
#|
#|typedef int (*okg_reader)(void *, size_t, mpq_t);
#|
#|static inline int okg_budget_init(okg_budget *b, size_t limit, unsigned bits)
#|{
#|    if (!b || limit<4096 || limit>1073741824 || bits<64 || bits>8192) {
#|        return 0;
#|    }
#|    b->limit=limit;
#|    b->charged=0;
#|    b->peak=0;
#|    b->bits=bits;
#|    return 1;
#|}
#|
#|static inline int okg_reserve(okg_budget *b, size_t bytes)
#|{
#|    if (!b || b->charged>b->limit || bytes>b->limit-b->charged) {
#|        return 0;
#|    }
#|    b->charged+=bytes;
#|    if (b->charged>b->peak) {
#|        b->peak=b->charged;
#|    }
#|    return 1;
#|}
#|
#|static inline void okg_release(okg_budget *b, size_t bytes)
#|{
#|    if (b && bytes<=b->charged) {
#|        b->charged-=bytes;
#|    }
#|}
#|
#|static inline int okg_allocate(okg_matrix *out, size_t rows, size_t columns,
#|                               okg_budget *budget)
#|{
#|    if (!out || out->initialized || !budget || !rows || !columns ||
#|        rows>1024 || columns>1024 || rows>1048576/columns) {
#|        return OKG_ARGUMENT;
#|    }
#|    size_t count=rows*columns;
#|    size_t per_cell=(budget->bits+7)/8+sizeof(mpz_t)+32;
#|    if (count>(SIZE_MAX-128)/per_cell) {
#|        return OKG_BUDGET;
#|    }
#|    size_t charge=count*per_cell+128;
#|    if (!okg_reserve(budget,charge)) {
#|        return OKG_BUDGET;
#|    }
#|    mpz_t *cells=calloc(count,sizeof(mpz_t));
#|    if (!cells) {
#|        okg_release(budget,charge);
#|        return OKG_ALLOCATION;
#|    }
#|    for (size_t i=0;i<count;++i) {
#|        mpz_init2(cells[i],64);
#|    }
#|    mpz_init_set_ui(out->denominator,1);
#|    out->rows=rows;
#|    out->columns=columns;
#|    out->count=count;
#|    out->numerators=cells;
#|    out->budget=budget;
#|    out->charge=charge;
#|    out->initialized=1;
#|    out->backend=OKQ_SCALAR;
#|    out->simd_products=0;
#|    return OKG_SUCCESS;
#|}
#|
#|static inline void okg_clear(okg_matrix *matrix)
#|{
#|    if (!matrix || !matrix->initialized) {
#|        return;
#|    }
#|    for (size_t i=0;i<matrix->count;++i) {
#|        mpz_clear(matrix->numerators[i]);
#|    }
#|    free(matrix->numerators);
#|    mpz_clear(matrix->denominator);
#|    okg_release(matrix->budget,matrix->charge);
#|    matrix->initialized=0;
#|    matrix->numerators=NULL;
#|    matrix->rows=0;
#|    matrix->columns=0;
#|    matrix->count=0;
#|}
#|
#|static inline int okg_within(const okg_matrix *matrix, const mpz_t value)
#|{
#|    return matrix && matrix->initialized &&
#|           mpz_sizeinbase(value,2)<=matrix->budget->bits;
#|}
#|
#|static inline int okg_normalize(okg_matrix *matrix)
#|{
#|    if (!matrix || !matrix->initialized || mpz_sgn(matrix->denominator)<=0) {
#|        return OKG_ARGUMENT;
#|    }
#|    mpz_t common;
#|    mpz_init_set(common,matrix->denominator);
#|    for (size_t i=0;i<matrix->count;++i) {
#|        if (!okg_within(matrix,matrix->numerators[i])) {
#|            mpz_clear(common);
#|            return OKG_BUDGET;
#|        }
#|        if (mpz_cmp_ui(common,1)!=0) {
#|            mpz_gcd(common,common,matrix->numerators[i]);
#|        }
#|    }
#|    if (!okg_within(matrix,matrix->denominator)) {
#|        mpz_clear(common);
#|        return OKG_BUDGET;
#|    }
#|    if (mpz_cmp_ui(common,1)>0) {
#|        mpz_divexact(matrix->denominator,matrix->denominator,common);
#|        for (size_t i=0;i<matrix->count;++i) {
#|            mpz_divexact(matrix->numerators[i],matrix->numerators[i],common);
#|        }
#|    }
#|    mpz_clear(common);
#|    return OKG_SUCCESS;
#|}
#|
#|static int okg_from_reader(okg_matrix *out, size_t rows, size_t columns,
#|                            okg_budget *budget, okg_reader reader, void *context)
#|{
#|    if (!reader) {
#|        return OKG_ARGUMENT;
#|    }
#|    int status=okg_allocate(out,rows,columns,budget);
#|    if (status) {
#|        return status;
#|    }
#|    mpq_t q;
#|    mpz_t divisor;
#|    mpz_t multiplier;
#|    mpq_init(q);
#|    mpz_init(divisor);
#|    mpz_init(multiplier);
#|    for (size_t i=0;i<out->count;++i) {
#|        if (!reader(context,i,q) || mpz_sgn(mpq_denref(q))<=0 ||
#|            !okg_within(out,mpq_numref(q)) || !okg_within(out,mpq_denref(q))) {
#|            status=OKG_INPUT;
#|            break;
#|        }
#|        mpz_gcd(divisor,out->denominator,mpq_denref(q));
#|        mpz_divexact(multiplier,out->denominator,divisor);
#|        mpz_mul(out->denominator,multiplier,mpq_denref(q));
#|        if (!okg_within(out,out->denominator)) {
#|            status=OKG_BUDGET;
#|            break;
#|        }
#|    }
#|    for (size_t i=0;!status && i<out->count;++i) {
#|        if (!reader(context,i,q) || mpz_sgn(mpq_denref(q))<=0 ||
#|            !mpz_divisible_p(out->denominator,mpq_denref(q))) {
#|            status=OKG_INPUT;
