funcao om_mod_0_transpose(a) {
  var out=[];
  var j=0;
  enquanto((j<len((a)[0]))) {
    var row=[];
    var i=0;
    enquanto((i<len(a))) {
      push(row,((a)[i])[j]);
      i=(i+1);
    }
    push(out,row);
    j=(j+1);
  }
  retornar out;
}
