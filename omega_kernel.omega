funcao om_mod_0_determinant(raw) {
  var a=om_mod_0_copy(raw);
  var n=len(a);
  se((n!=len((a)[0]))) {
    fail("Square determinant shape");
  }
  var previous=1;
  var sign=1;
  var k=0;
  enquanto((k<(n-1))) {
    var p=k;
    enquanto(((p<n)&&(((a)[p])[k]==0))) {
      p=(p+1);
    }
    se((p==n)) {
      retornar 0;
    }
    se((p!=k)) {
      var row=(a)[p];
      put(a,p,(a)[k]);
      put(a,k,row);
      sign=(-sign);
    }
    var pivot=((a)[k])[k];
    var i=(k+1);
    enquanto((i<n)) {
      var j=(k+1);
      enquanto((j<n)) {
        put((a)[i],j,om_mod_0_check((((pivot*((a)[i])[j])-(((a)[i])[k]*((a)[k])[j]))/previous)));
        j=(j+1);
      }
      put((a)[i],k,0);
      i=(i+1);
    }
    previous=pivot;
    k=(k+1);
  }
  retornar (sign*((a)[(n-1)])[(n-1)]);
}
