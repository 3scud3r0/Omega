funcao om_mod_7_verify(request) {
  om_mod_7_fields(request,["format","nodes","definitions","proof","expected","limits"]);
  se(((request)["format"]!="omega-kernel-proof-1")) {
    fail("Unsupported proof calculus wire format");
  }
  var limits=obj();
  se(has(request,"limits")) {
    limits=(request)["limits"];
  }
  om_mod_7_fields(limits,["nodes","fuel","depth"]);
  var state=obj();
  put(state,"nodes",[]);
  put(state,"capacity",om_mod_0_integer(om_mod_0_num(limits,"nodes",16384),16,16384));
  put(state,"fuel",om_mod_0_integer(om_mod_0_num(limits,"fuel",1000000),1,10000000));
  put(state,"initial_fuel",(state)["fuel"]);
  put(state,"depth_limit",om_mod_0_integer(om_mod_0_num(limits,"depth",128),8,256));
  put(state,"peak_depth",0);
  put(state,"error","");
  put(state,"error_node",(-1));
  put(state,"context",[]);
  put(state,"context_depth",0);
  put(state,"definitions",[]);
  var raw=om_mod_30_as_list((request)["nodes"]);
  se((((len(raw)<1)||(len(raw)>4096))||(len(raw)>(state)["capacity"]))) {
    fail("Proof raw node budget");
  }
  var i=0;
  enquanto((i<len(raw))) {
    om_mod_7_fields((raw)[i],["op","args","data"]);
    var op=om_mod_30_as_string(((raw)[i])["op"]);
    var args=om_mod_0_vector(((raw)[i])["args"]);
    var data=om_mod_0_vector(((raw)[i])["data"]);
    se((((om_mod_7_arity(op)<0)||(len(args)!=om_mod_7_arity(op)))||(len(data)!=om_mod_7_data_arity(op)))) {
      fail("Proof constructor arity");
    }
    var j=0;
    enquanto((j<len(args))) {
      om_mod_0_integer((args)[j],0,(i-1));
      j=(j+1);
    }
    j=0;
    enquanto((j<len(data))) {
      om_mod_0_integer((data)[j],(-9223372036854775807),9223372036854775807);
      j=(j+1);
    }
    se((op=="sort")) {
      om_mod_0_integer((data)[0],0,32);
    }
    se(((op=="var")||(op=="constant"))) {
      om_mod_0_integer((data)[0],0,255);
    }
    se((op=="nat-literal")) {
      om_mod_0_integer((data)[0],0,9223372036854775807);
    }
    se((op=="rat-literal")) {
      om_mod_0_integer((data)[1],1,9223372036854775807);
    }
    om_mod_7_make_node(state,op,args,data);
    i=(i+1);
  }
  var expected=om_mod_0_count(request,"expected",0,(len(raw)-1));
  var proof=om_mod_0_count(request,"proof",0,(len(raw)-1));
  var definitions=om_mod_30_as_list((request)["definitions"]);
  se((len(definitions)>256)) {
    fail("Proof definition budget");
  }
  var accepted=1;
  i=0;
  enquanto(((i<len(definitions))&&accepted)) {
    om_mod_7_fields((definitions)[i],["type","body"]);
    var type=om_mod_0_count((definitions)[i],"type",0,(len(raw)-1));
    var body=om_mod_0_count((definitions)[i],"body",0,(len(raw)-1));
    se(((om_mod_7_type_level(state,type,0)<0)||(!om_mod_7_check_term(state,body,type,0)))) {
      accepted=0;
    }
    senao {
      push((state)["definitions"],[type,body]);
    }
    i=(i+1);
  }
  se(accepted) {
    accepted=(((om_mod_7_type_level(state,expected,0)>=0)&&om_mod_7_check_term(state,proof,expected,0))&&((state)["error"]==""));
  }
  var resource=contains(["arena-limit","fuel-limit","depth-limit","context-limit","universe-limit","arithmetic-limit"],(state)["error"]);
  var status="rejected";
  se(accepted) {
    status="accepted";
  }
  senao {
    se(resource) {
      status="resource-limit";
    }
  }
  var result=obj();
  put(result,"accepted",accepted);
  put(result,"verified",accepted);
  put(result,"status",status);
  put(result,"error",(state)["error"]);
  put(result,"expected_node",expected);
  put(result,"proof_node",proof);
  put(result,"error_node",(state)["error_node"]);
  put(result,"arena_nodes",len((state)["nodes"]));
  put(result,"fuel_used",((state)["initial_fuel"]-(state)["fuel"]));
  put(result,"peak_depth",(state)["peak_depth"]);
  put(result,"axioms",[]);
  put(result,"logic","predicative-intensional-MLTT-1");
  put(result,"request_document_sha256",sha256(om_mod_30_canonical(request)));
  retornar result;
}
funcao om_mod_10_decode(matrix) {
