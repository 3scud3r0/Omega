funcao om_mod_4_compile(program,arch) {
  om_mod_9_validate(program);
  se((!contains(["x86_64","aarch64","riscv64"],arch))) {
    fail("Unknown direct ELF architecture");
  }
  var code=om_mod_3_create();
  var n=len((program)["parameters"]);
  se((arch=="x86_64")) {
    om_mod_11_prologue(code,n);
  }
  se((arch=="aarch64")) {
    om_mod_2_prologue(code,n);
  }
  se((arch=="riscv64")) {
    om_mod_8_prologue(code,n);
  }
  var env=obj();
  var i=0;
  enquanto((i<n)) {
