  om_mod_4_half(file,2);
  var machine=62;
  se((arch=="aarch64")) {
    machine=183;
  }
  se((arch=="riscv64")) {
    machine=243;
  }
  om_mod_4_half(file,machine);
  om_mod_3_word(file,1);
  om_mod_3_wide(file,4198400);
  om_mod_3_wide(file,64);
  om_mod_3_wide(file,0);
  om_mod_3_word(file,0);
  om_mod_4_half(file,64);
  om_mod_4_half(file,56);
  om_mod_4_half(file,3);
  om_mod_4_half(file,0);
  om_mod_4_half(file,0);
  om_mod_4_half(file,0);
  om_mod_4_segment(file,1,5,0,4194304,(4096+len(bytes)),(4096+len(bytes)),4096);
  om_mod_4_segment(file,1,6,0,6291456,0,4096,4096);
  om_mod_4_segment(file,1685382481,6,0,0,0,0,16);
  enquanto((len((file)["bytes"])<4096)) {
    om_mod_3_octet(file,0);
  }
  om_mod_3_emit(file,bytes);
  var out=obj();
  put(out,"format","omega-direct-elf-1");
  put(out,"architecture",arch);
  put(out,"parameters",(program)["parameters"]);
  put(out,"ir",program);
  put(out,"elf_hex",om_mod_3_hex((file)["bytes"]));
  put(out,"machine_code_bytes",len(bytes));
  put(out,"expression_slots",(slots)[0]);
  put(out,"external_assembler",0);
  put(out,"external_linker",0);
  put(out,"semantics","checked-i64-exact-division-v1");
  retornar out;
}
