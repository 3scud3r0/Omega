#|  se(maximum-minimum>64) { fail("Associative score dynamic-range budget 64"); }
#|  var exponential=[]; var total=[0,0]; i=0;
#|  enquanto(i<len(scores)) { var e=m::exp_interval(scores[i]-maximum,bits); push(exponential,e); total=iv::add(total,e); i=i+1; }
#|  var midpoints=[]; var normalization=0; var intervals=[]; i=0;
#|  enquanto(i<len(scores)) {
#|    var weight=iv::div(exponential[i],total); push(intervals,weight);
#|    var point=iv::midpoint(weight); push(midpoints,point); normalization=normalization+point; i=i+1;
#|  }
#|  midpoints=u::scale(midpoints,1/normalization); var enclosure=[]; var dimension=0;
#|  enquanto(dimension<len(values[0])) {
