#|          put(recipient["mailbox"],recipient["tail"],actor["registers"][reg]);
#|          put(recipient,"tail",(recipient["tail"]+1)%mailbox); put(recipient,"count",recipient["count"]+1);
#|          peak=m::max(peak,recipient["count"]); messages=messages+1;
#|        }
#|      }
#|      se(op=="recv") {
#|        se(actor["count"]==0) { put(actor,"status","blocked_receive"); stop=1; }
#|        senao {
#|          put(actor["registers"],reg,actor["mailbox"][actor["head"]]); put(actor["mailbox"],actor["head"],0);
#|          put(actor,"head",(actor["head"]+1)%mailbox); put(actor,"count",actor["count"]-1);
#|        }
#|      }
#|      se(!stop) {
#|        put(actor,"pc",next); put(actor,"status","ready"); put(actor,"executed",actor["executed"]+1);
#|        progress=1; used=used+1; instructions=instructions+1;
#|        se(op=="halt") { put(actor,"halted",1); put(actor,"status","halted"); completed=completed+1; stop=1; }
#|        se(op=="yield") { stop=1; }
#|      }
#|    }
#|    se(progress) { idle=0; } senao { idle=idle+1; }
#|    se(idle>=count&&completed<count) { deadlock=1; }
#|    turn=turn+1;
#|  }
#|  var states=[]; var statuses=[]; var mail_counts=[]; var pcs=[]; i=0;
#|  enquanto(i<count) {
#|    push(states,actors[i]["registers"]); push(statuses,actors[i]["status"]); push(mail_counts,actors[i]["count"]); push(pcs,actors[i]["pc"]); i=i+1;
#|  }
