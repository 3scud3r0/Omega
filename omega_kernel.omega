#|  }
#|  fail("Unsupported Taylor AST operation/arity"); retornar 0;
#|}
#|funcao execute(r) {
#|  var center=u::q(r,"center"); var radius=u::nonnegative(u::q(r,"radius"));
#|  var order=u::count(r,"order",1,12); var bits=u::integer(u::num(r,"bits",48),8,128);
