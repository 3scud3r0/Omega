funcao om_mod_29_sqrt_interval(x,bits) {
  var scale=om_mod_29_precision(bits);
  se(((x<0)||(x>om_mod_29_pow_int(2,256)))) {
    fail("Square root domain");
  }
  se((x==0)) {
    retornar [0,0];
  }
  var hi=om_mod_29_max(1,x);
  var i=0;
  var lo=0;
  enquanto((i<1024)) {
    var next=(om_mod_29_ceil_q((((hi+(x/hi))*scale)/2))/scale);
    se((next>=hi)) {
      parar;
    }
    hi=next;
    i=(i+1);
  }
  lo=(qfloor(((x/hi)*scale))/scale);
  retornar om_mod_29_box(lo,hi);
}
funcao om_mod_29_times(a,b) {
  var p=[((a)[0]*(b)[0]),((a)[0]*(b)[1]),((a)[1]*(b)[0]),((a)[1]*(b)[1])];
  var lo=(p)[0];
