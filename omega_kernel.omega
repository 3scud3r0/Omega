funcao om_mod_29_log_interval(x,bits) {
  var scale=om_mod_29_precision(bits);
  var bound=om_mod_29_pow_int(2,32);
  se((((x<=0)||(x<(1/bound)))||(x>bound))) {
    fail("Log domain is [2^-32,2^32]");
  }
  se((x==1)) {
    retornar [0,0];
  }
  var m=x;
  var k=0;
  enquanto((m>2)) {
    m=(m/2);
    k=(k+1);
  }
  enquanto((m<1)) {
    m=(m*2);
    k=(k-1);
  }
  var a=om_mod_29_log_unit(m,(bits+16));
  var b=om_mod_29_log_unit(2,(bits+16));
  var lo=(a)[0];
  var hi=(a)[1];
  se((k>=0)) {
    lo=(lo+(k*(b)[0]));
    hi=(hi+(k*(b)[1]));
  }
  senao {
    lo=(lo+(k*(b)[1]));
    hi=(hi+(k*(b)[0]));
  }
  retornar om_mod_29_rounded(lo,hi,scale);
}
funcao om_mod_29_log_unit(x,n) {
  var z=((x-1)/(x+1));
  var term=z;
  var sum=0;
  var i=1;
  enquanto((i<=n)) {
    se(((i%2)==1)) {
      sum=(sum+((2*term)/i));
    }
    term=(term*z);
    i=(i+1);
  }
  var error=((2*om_mod_29_abs(term))/(1-om_mod_29_abs(z)));
  retornar om_mod_29_box((sum-error),(sum+error));
}
