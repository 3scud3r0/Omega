#|  var turns=u::count(r,"max_turns",1,100000); var raw=r["program"];
#|  se(!islist(raw)||len(raw)<1||len(raw)>128) { fail("Microactor shared program length 1..128"); }
#|  se(arena%8!=0) { fail("Microactor arena stride must be aligned to eight bytes"); }
#|  var reserved=count*arena+len(raw)*64+256;
#|  se(reserved>memory) { fail("Microactor arena reservation exceeds memory quota"); }
#|  # Conservative control/register/mailbox accounting. This is not a native stack.
#|  se(256+registers*16+mailbox*32>arena) { fail("Actor layout does not fit arena"); }
