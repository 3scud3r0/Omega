#|        return malformed("unknown",digest);
#|    }
#|    size_t length=fread(input_buffer,1,OK_INPUT_BYTES+1,input);
#|    int read_error=ferror(input);
#|    fclose(input);
#|    if (read_error || length>OK_INPUT_BYTES) {
#|        return malformed("unknown",digest);
#|    }
#|    ok_sha256_hex(input_buffer,length,digest);
#|    okj_parser parser;
#|    if (!okj_parse(&parser,input_buffer,length,json_tokens,OK_JSON_TOKENS)) {
#|        return malformed("unknown",digest);
#|    }
#|    static const char *const root_keys[]={"operation","request"};
#|    if (!protocol_fields(&parser,0,root_keys,2) || parser.tokens[0].count!=2) {
#|        return malformed("unknown",digest);
#|    }
#|    uint32_t operation=okj_field(&parser,0,"operation");
#|    uint32_t request=okj_field(&parser,0,"request");
#|    if (okj_name(&parser,operation,"verify")) {
#|        return proof_request(&parser,request,digest);
#|    }
#|    if (okj_name(&parser,operation,"batch")) {
#|        return batch_request(&parser,request,digest);
#|    }
#|#ifdef OMEGA_KERNEL_GMP
#|    if (okj_name(&parser,operation,"tensor")) {
#|        return tensor_request(&parser,request,digest);
#|    }
#|    if (okj_name(&parser,operation,"graph")) {
#|        return graph_request(&parser,request,digest);
#|    }
#|#endif
#|    if (okj_name(&parser,operation,"capabilities")) {
#|        result_prefix("capabilities",digest);
#|        printf("\"accepted\":true,\"verified\":false,\"status\":\"available\","
#|               "\"logic\":\"predicative-intensional-MLTT-1\",\"avx2\":%s,\"avx512\":%s,\"neon\":%s,",
#|               okq_available(OKQ_AVX2)?"true":"false",okq_available(OKQ_AVX512)?"true":"false",
#|               okq_available(OKQ_NEON)?"true":"false");
#|#ifdef OMEGA_KERNEL_GMP
#|        puts("\"gmp_tensor\":true}");
#|#else
#|        puts("\"gmp_tensor\":false}");
#|#endif
#|        return 0;
#|    }
#|    return malformed("unknown",digest);
#|}
# OMEGA-KERNEL-FILE-END
# OMEGA-KERNEL-FILE "kernel/native/sha256.h"
#|#ifndef OMEGA_KERNEL_SHA256_H
#|#define OMEGA_KERNEL_SHA256_H
#|#include <stdint.h>
#|#include <stddef.h>
#|
#|typedef struct {
#|    uint32_t state[8];
#|    uint64_t bytes;
#|    unsigned char block[64];
#|    size_t used;
#|} ok_sha256;
#|
#|static inline uint32_t ok_rotr32(uint32_t x, unsigned n)
#|{
#|    return (x >> n) | (x << (32 - n));
#|}
#|
#|static void ok_sha256_transform(ok_sha256 *s, const unsigned char *data)
#|{
#|    static const uint32_t constants[64] = {
#|        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
#|        0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
#|        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
#|        0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
#|        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
#|        0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
#|        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
#|        0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
#|        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
#|        0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
#|        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
#|        0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
#|        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
#|        0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
#|        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
#|        0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
#|    };
#|    uint32_t w[64];
#|    for (unsigned i = 0; i < 16; ++i) {
#|        w[i] = (uint32_t)data[4*i] << 24 |
#|               (uint32_t)data[4*i+1] << 16 |
#|               (uint32_t)data[4*i+2] << 8 |
#|               data[4*i+3];
#|    }
#|    for (unsigned i = 16; i < 64; ++i) {
#|        uint32_t a = ok_rotr32(w[i-15], 7) ^ ok_rotr32(w[i-15], 18) ^ (w[i-15] >> 3);
#|        uint32_t b = ok_rotr32(w[i-2], 17) ^ ok_rotr32(w[i-2], 19) ^ (w[i-2] >> 10);
#|        w[i] = w[i-16] + a + w[i-7] + b;
#|    }
#|    uint32_t a = s->state[0];
#|    uint32_t b = s->state[1];
#|    uint32_t c = s->state[2];
#|    uint32_t d = s->state[3];
#|    uint32_t e = s->state[4];
#|    uint32_t f = s->state[5];
#|    uint32_t g = s->state[6];
#|    uint32_t h = s->state[7];
#|    for (unsigned i = 0; i < 64; ++i) {
#|        uint32_t sigma1 = ok_rotr32(e,6) ^ ok_rotr32(e,11) ^ ok_rotr32(e,25);
#|        uint32_t choose = (e & f) ^ (~e & g);
#|        uint32_t t1 = h + sigma1 + choose + constants[i] + w[i];
#|        uint32_t sigma0 = ok_rotr32(a,2) ^ ok_rotr32(a,13) ^ ok_rotr32(a,22);
#|        uint32_t majority = (a & b) ^ (a & c) ^ (b & c);
#|        uint32_t t2 = sigma0 + majority;
#|        h = g;
#|        g = f;
#|        f = e;
#|        e = d + t1;
#|        d = c;
#|        c = b;
#|        b = a;
#|        a = t1 + t2;
#|    }
#|    s->state[0] += a;
#|    s->state[1] += b;
#|    s->state[2] += c;
#|    s->state[3] += d;
#|    s->state[4] += e;
#|    s->state[5] += f;
#|    s->state[6] += g;
#|    s->state[7] += h;
#|}
#|
#|static inline void ok_sha256_init(ok_sha256 *s)
#|{
#|    static const uint32_t initial[8] = {
#|        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
#|        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
#|    };
#|    for (unsigned i = 0; i < 8; ++i) {
#|        s->state[i] = initial[i];
#|    }
#|    s->bytes = 0;
#|    s->used = 0;
#|}
#|
#|static inline int ok_sha256_update(ok_sha256 *s, const void *buffer, size_t length)
#|{
#|    const unsigned char *data = buffer;
#|    if (!s || (!data && length) || length > UINT64_MAX / 8 - s->bytes) {
#|        return 0;
#|    }
#|    s->bytes += length;
#|    while (length) {
#|        size_t n = 64 - s->used;
#|        if (n > length) {
#|            n = length;
#|        }
#|        for (size_t i = 0; i < n; ++i) {
#|            s->block[s->used+i] = data[i];
#|        }
#|        s->used += n;
#|        data += n;
#|        length -= n;
#|        if (s->used == 64) {
#|            ok_sha256_transform(s, s->block);
#|            s->used = 0;
#|        }
#|    }
#|    return 1;
#|}
#|
#|static inline void ok_sha256_finish(ok_sha256 *s, unsigned char digest[32])
#|{
#|    uint64_t bits = s->bytes * 8;
#|    s->block[s->used++] = 0x80;
#|    if (s->used > 56) {
#|        while (s->used < 64) {
#|            s->block[s->used++] = 0;
#|        }
#|        ok_sha256_transform(s, s->block);
#|        s->used = 0;
#|    }
#|    while (s->used < 56) {
#|        s->block[s->used++] = 0;
#|    }
#|    for (unsigned i = 0; i < 8; ++i) {
#|        s->block[63-i] = (unsigned char)(bits >> (8*i));
#|    }
#|    ok_sha256_transform(s, s->block);
#|    for (unsigned i = 0; i < 8; ++i) {
#|        digest[4*i] = (unsigned char)(s->state[i] >> 24);
#|        digest[4*i+1] = (unsigned char)(s->state[i] >> 16);
#|        digest[4*i+2] = (unsigned char)(s->state[i] >> 8);
#|        digest[4*i+3] = (unsigned char)s->state[i];
#|    }
#|}
#|
#|static inline void ok_sha256_hex(const void *data, size_t size, char output[65])
#|{
#|    static const char hex[] = "0123456789abcdef";
#|    ok_sha256 state;
#|    unsigned char digest[32];
#|    ok_sha256_init(&state);
#|    ok_sha256_update(&state, data, size);
#|    ok_sha256_finish(&state, digest);
#|    for (unsigned i = 0; i < 32; ++i) {
#|        output[2*i] = hex[digest[i] >> 4];
#|        output[2*i+1] = hex[digest[i] & 15];
#|    }
#|    output[64] = 0;
#|}
#|
#|#endif
# OMEGA-KERNEL-FILE-END
# OMEGA-KERNEL-FILE "kernel/native/tensor.h"
#|#ifndef OMEGA_KERNEL_TENSOR_H
#|#define OMEGA_KERNEL_TENSOR_H
#|
#|/* Exact structure-of-arrays batches. SIMD is used only after lane range checks.
#| * Overflow is a per-lane result, never a wrapped value masquerading as Q.
#| * Inputs/outputs are caller-owned, non-overlapping contiguous arrays.
#| */
#|#include <stddef.h>
#|#include <stdint.h>
#|#include <limits.h>
#|#include "../../omega_selfhost/bounded_rational.h"
#|
#|#if defined(__x86_64__) && defined(__GNUC__)
#|#include <immintrin.h>
#|#define OKQ_X86_SIMD 1
#|#else
#|#define OKQ_X86_SIMD 0
#|#endif
#|
#|#if defined(__aarch64__) && defined(__ARM_NEON)
#|#include <arm_neon.h>
#|#define OKQ_ARM_SIMD 1
#|#else
#|#define OKQ_ARM_SIMD 0
#|#endif
#|
#|enum {
#|    OKQ_AUTO,
#|    OKQ_SCALAR,
#|    OKQ_AVX2,
#|    OKQ_AVX512,
#|    OKQ_NEON
#|};
#|
#|enum {
#|    OKQ_ADD,
#|    OKQ_MULTIPLY
#|};
#|
#|enum {
#|    OKQ_SUCCESS,
#|    OKQ_BAD_ARGUMENT,
#|    OKQ_UNSUPPORTED,
#|    OKQ_ARITHMETIC_OVERFLOW,
#|    OKQ_BAD_RATIONAL
#|};
#|
#|typedef struct {
#|    const int64_t *numerators;
#|    const uint64_t *denominators;
#|    size_t length;
#|} okq_view;
#|
#|typedef struct {
#|    int64_t *numerators;
#|    uint64_t *denominators;
#|    uint8_t *status;
#|    size_t capacity;
#|} okq_output;
#|
#|typedef struct {
#|    unsigned backend;
#|    size_t simd_lanes;
#|    size_t scalar_lanes;
#|    size_t failed_lanes;
#|} okq_statistics;
#|
#|static inline int okq_available(unsigned backend)
#|{
#|    if (backend == OKQ_AUTO || backend == OKQ_SCALAR) {
#|        return 1;
#|    }
#|#if OKQ_X86_SIMD
#|    __builtin_cpu_init();
#|    if (backend == OKQ_AVX2) {
#|        return !!__builtin_cpu_supports("avx2");
#|    }
#|    if (backend == OKQ_AVX512) {
#|        return __builtin_cpu_supports("avx512f") &&
#|               __builtin_cpu_supports("avx512dq") &&
#|               __builtin_cpu_supports("avx512bw");
#|    }
#|#endif
#|#if OKQ_ARM_SIMD
#|    if (backend == OKQ_NEON) {
#|        return 1;
#|    }
#|#endif
#|    return 0;
#|}
#|
#|static inline unsigned okq_choose(unsigned requested)
#|{
#|    if (requested != OKQ_AUTO) {
#|        return okq_available(requested) ? requested : UINT_MAX;
#|    }
#|    if (okq_available(OKQ_AVX512)) {
#|        return OKQ_AVX512;
#|    }
#|    if (okq_available(OKQ_AVX2)) {
#|        return OKQ_AVX2;
#|    }
#|    if (okq_available(OKQ_NEON)) {
#|        return OKQ_NEON;
#|    }
#|    return OKQ_SCALAR;
#|}
#|
#|static inline int okq_small_lane(okq_view a, okq_view b, size_t i)
#|{
#|    return a.numerators[i] >= INT32_MIN && a.numerators[i] <= INT32_MAX &&
#|           b.numerators[i] >= INT32_MIN && b.numerators[i] <= INT32_MAX &&
#|           a.denominators[i] > 0 && a.denominators[i] <= INT32_MAX &&
#|           b.denominators[i] > 0 && b.denominators[i] <= INT32_MAX;
#|}
#|
#|static inline int okq_block_eligible(okq_view a, okq_view b, size_t start, size_t width)
#|{
#|    if (width > a.length - start) {
#|        return 0;
#|    }
#|    for (size_t i = 0; i < width; ++i) {
#|        if (!okq_small_lane(a,b,start+i)) {
#|            return 0;
#|        }
#|    }
#|    return 1;
#|}
#|
#|#if OKQ_X86_SIMD
#|__attribute__((target("avx2")))
#|static void okq_avx2_products(okq_view a, okq_view b, size_t start, unsigned operation,
#|                              int64_t numerator[4], uint64_t denominator[4])
#|{
#|    __m256i an = _mm256_loadu_si256((const __m256i *)(const void *)(a.numerators+start));
#|    __m256i ad = _mm256_loadu_si256((const __m256i *)(const void *)(a.denominators+start));
#|    __m256i bn = _mm256_loadu_si256((const __m256i *)(const void *)(b.numerators+start));
#|    __m256i bd = _mm256_loadu_si256((const __m256i *)(const void *)(b.denominators+start));
#|    __m256i n;
#|    if (operation == OKQ_ADD) {
#|        n = _mm256_add_epi64(_mm256_mul_epi32(an,bd),_mm256_mul_epi32(bn,ad));
#|    } else {
#|        n = _mm256_mul_epi32(an,bn);
#|    }
#|    __m256i d = _mm256_mul_epu32(ad,bd);
#|    _mm256_storeu_si256((__m256i *)(void *)numerator,n);
#|    _mm256_storeu_si256((__m256i *)(void *)denominator,d);
#|}
#|
#|__attribute__((target("avx512f,avx512dq,avx512bw")))
#|static void okq_avx512_products(okq_view a, okq_view b, size_t start, unsigned operation,
#|                                int64_t numerator[8], uint64_t denominator[8])
#|{
#|    __m512i an = _mm512_loadu_si512((const void *)(a.numerators+start));
#|    __m512i ad = _mm512_loadu_si512((const void *)(a.denominators+start));
#|    __m512i bn = _mm512_loadu_si512((const void *)(b.numerators+start));
#|    __m512i bd = _mm512_loadu_si512((const void *)(b.denominators+start));
#|    __m512i n;
#|    if (operation == OKQ_ADD) {
#|        n = _mm512_add_epi64(_mm512_mul_epi32(an,bd),_mm512_mul_epi32(bn,ad));
#|    } else {
#|        n = _mm512_mul_epi32(an,bn);
#|    }
#|    __m512i d = _mm512_mul_epu32(ad,bd);
#|    _mm512_storeu_si512((void *)numerator,n);
#|    _mm512_storeu_si512((void *)denominator,d);
#|}
#|
#|__attribute__((target("avx2")))
#|static int64_t okq_avx2_dot16(const int16_t *a, const int16_t *b, size_t n)
#|{
#|    __m256i low = _mm256_setzero_si256();
#|    __m256i high = _mm256_setzero_si256();
#|    size_t i = 0;
#|    for (; i+16 <= n; i+=16) {
#|        __m256i x = _mm256_loadu_si256((const __m256i *)(const void *)(a+i));
#|        __m256i y = _mm256_loadu_si256((const __m256i *)(const void *)(b+i));
#|        __m256i p = _mm256_madd_epi16(x,y);
#|        low = _mm256_add_epi64(low,_mm256_cvtepi32_epi64(_mm256_castsi256_si128(p)));
#|        high = _mm256_add_epi64(high,_mm256_cvtepi32_epi64(_mm256_extracti128_si256(p,1)));
#|    }
#|    int64_t lanes[4];
#|    _mm256_storeu_si256((__m256i *)(void *)lanes,_mm256_add_epi64(low,high));
#|    int64_t sum = lanes[0]+lanes[1]+lanes[2]+lanes[3];
#|    for (; i<n; ++i) {
#|        sum += (int64_t)a[i]*b[i];
#|    }
#|    return sum;
#|}
#|
#|__attribute__((target("avx512f,avx512dq,avx512bw")))
#|static int64_t okq_avx512_dot16(const int16_t *a, const int16_t *b, size_t n)
#|{
#|    __m512i low = _mm512_setzero_si512();
#|    __m512i high = _mm512_setzero_si512();
#|    size_t i = 0;
#|    for (; i+32<=n; i+=32) {
#|        __m512i x = _mm512_loadu_si512((const void *)(a+i));
#|        __m512i y = _mm512_loadu_si512((const void *)(b+i));
#|        __m512i p = _mm512_madd_epi16(x,y);
#|        low = _mm512_add_epi64(low,_mm512_cvtepi32_epi64(_mm512_castsi512_si256(p)));
#|        high = _mm512_add_epi64(high,_mm512_cvtepi32_epi64(_mm512_extracti64x4_epi64(p,1)));
#|    }
#|    int64_t lanes[8];
#|    _mm512_storeu_si512((void *)lanes,_mm512_add_epi64(low,high));
#|    int64_t sum = 0;
#|    for (unsigned k=0;k<8;++k) {
#|        sum += lanes[k];
#|    }
#|    for (;i<n;++i) {
#|        sum += (int64_t)a[i]*b[i];
#|    }
#|    return sum;
#|}
#|#endif
#|
#|#if OKQ_ARM_SIMD
#|static void okq_neon_products(okq_view a, okq_view b, size_t start, unsigned operation,
#|                               int64_t numerator[2], uint64_t denominator[2])
#|{
#|    int32_t an[2] = {(int32_t)a.numerators[start],(int32_t)a.numerators[start+1]};
#|    int32_t bn[2] = {(int32_t)b.numerators[start],(int32_t)b.numerators[start+1]};
#|    int32_t ad[2] = {(int32_t)a.denominators[start],(int32_t)a.denominators[start+1]};
#|    int32_t bd[2] = {(int32_t)b.denominators[start],(int32_t)b.denominators[start+1]};
#|    int64x2_t n;
#|    if (operation == OKQ_ADD) {
#|        n = vaddq_s64(vmull_s32(vld1_s32(an),vld1_s32(bd)),
#|                       vmull_s32(vld1_s32(bn),vld1_s32(ad)));
#|    } else {
#|        n = vmull_s32(vld1_s32(an),vld1_s32(bn));
#|    }
#|    int64x2_t d = vmull_s32(vld1_s32(ad),vld1_s32(bd));
#|    vst1q_s64(numerator,n);
#|    vst1q_u64(denominator,vreinterpretq_u64_s64(d));
#|}
#|
#|static int64_t okq_neon_dot16(const int16_t *a, const int16_t *b, size_t n)
#|{
#|    int64x2_t sum = vdupq_n_s64(0);
#|    size_t i=0;
#|    for (;i+8<=n;i+=8) {
#|        int16x8_t x=vld1q_s16(a+i);
#|        int16x8_t y=vld1q_s16(b+i);
#|        sum=vpadalq_s32(sum,vmull_s16(vget_low_s16(x),vget_low_s16(y)));
#|        sum=vpadalq_s32(sum,vmull_s16(vget_high_s16(x),vget_high_s16(y)));
#|    }
#|    int64_t result=vgetq_lane_s64(sum,0)+vgetq_lane_s64(sum,1);
#|    for (;i<n;++i) {
#|        result+=(int64_t)a[i]*b[i];
#|    }
#|    return result;
#|}
#|#endif
#|
#|static inline int64_t okq_dot16(const int16_t *a, const int16_t *b, size_t n,
#|                                unsigned backend)
#|{
#|    /* Caller proves |a[i]|,|b[i]|<=32767 and n<=4096 before dispatch. */
#|#if OKQ_X86_SIMD
#|    if (backend==OKQ_AVX512) {
#|        return okq_avx512_dot16(a,b,n);
#|    }
#|    if (backend==OKQ_AVX2) {
#|        return okq_avx2_dot16(a,b,n);
#|    }
#|#endif
#|#if OKQ_ARM_SIMD
#|    if (backend==OKQ_NEON) {
#|        return okq_neon_dot16(a,b,n);
#|    }
#|#endif
#|    int64_t result=0;
#|    for (size_t i=0;i<n;++i) {
#|        result+=(int64_t)a[i]*b[i];
#|    }
#|    return result;
#|}
#|
#|static inline void okq_store(okq_output out, size_t index, int status,
#|                              omega_q64 value, okq_statistics *statistics)
#|{
#|    if (status != OMEGA_Q_OK) {
#|        out.numerators[index]=0;
#|        out.denominators[index]=1;
#|        out.status[index]=status==OMEGA_Q_OVERFLOW ?
#|            OKQ_ARITHMETIC_OVERFLOW : OKQ_BAD_RATIONAL;
#|        statistics->failed_lanes++;
#|    } else {
#|        out.numerators[index]=value.numerator;
#|        out.denominators[index]=value.denominator;
#|        out.status[index]=OKQ_SUCCESS;
#|    }
#|}
#|
#|static inline int okq_batch(okq_view a, okq_view b, okq_output out,
#|                            unsigned operation, unsigned requested,
#|                            okq_statistics *statistics)
#|{
#|    if (!statistics || !a.numerators || !a.denominators || !b.numerators ||
#|        !b.denominators || !out.numerators || !out.denominators || !out.status ||
#|        a.length != b.length || a.length > out.capacity || a.length>1048576 ||
#|        operation>OKQ_MULTIPLY || requested>OKQ_NEON) {
#|        return OKQ_BAD_ARGUMENT;
#|    }
#|    statistics->backend=okq_choose(requested);
#|    statistics->simd_lanes=0;
#|    statistics->scalar_lanes=0;
#|    statistics->failed_lanes=0;
#|    if (statistics->backend==UINT_MAX) {
#|        return OKQ_UNSUPPORTED;
#|    }
#|    unsigned width=1;
#|    if (statistics->backend==OKQ_AVX512) {
#|        width=8;
#|    } else if (statistics->backend==OKQ_AVX2) {
#|        width=4;
#|    } else if (statistics->backend==OKQ_NEON) {
#|        width=2;
#|    }
#|    size_t i=0;
#|    while (i<a.length) {
#|        if (width>1 && okq_block_eligible(a,b,i,width)) {
#|            int64_t numerators[8];
#|            uint64_t denominators[8];
#|#if OKQ_X86_SIMD
#|            if (statistics->backend==OKQ_AVX512) {
#|                okq_avx512_products(a,b,i,operation,numerators,denominators);
#|            } else if (statistics->backend==OKQ_AVX2) {
#|                okq_avx2_products(a,b,i,operation,numerators,denominators);
#|            }
#|#endif
#|#if OKQ_ARM_SIMD
#|            if (statistics->backend==OKQ_NEON) {
#|                okq_neon_products(a,b,i,operation,numerators,denominators);
#|            }
#|#endif
#|            for (unsigned j=0;j<width;++j) {
#|                omega_q64 value={0,1};
#|                int status=omega_q64_make(&value,numerators[j],denominators[j]);
#|                okq_store(out,i+j,status,value,statistics);
#|            }
#|            statistics->simd_lanes+=width;
#|            i+=width;
#|            continue;
#|        }
#|        omega_q64 x={a.numerators[i],a.denominators[i]};
#|        omega_q64 y={b.numerators[i],b.denominators[i]};
#|        omega_q64 value={0,1};
#|        int status=operation==OKQ_ADD ? omega_q64_add(&value,x,y) :
#|                                       omega_q64_mul(&value,x,y);
#|        okq_store(out,i,status,value,statistics);
#|        statistics->scalar_lanes++;
#|        i++;
#|    }
#|    return OKQ_SUCCESS;
#|}
#|
#|static inline int okq_gemm64(okq_view a, okq_view b, okq_output out,
#|                              size_t rows, size_t inner, size_t columns)
#|{
#|    if (!rows || !inner || !columns || rows>1024 || inner>4096 || columns>1024 ||
#|        a.length!=rows*inner || b.length!=inner*columns ||
#|        out.capacity<rows*columns || !a.numerators || !a.denominators ||
#|        !b.numerators || !b.denominators || !out.numerators ||
#|        !out.denominators || !out.status) {
#|        return OKQ_BAD_ARGUMENT;
#|    }
#|    for (size_t i=0;i<rows;++i) {
#|        for (size_t j=0;j<columns;++j) {
#|            omega_q64 accumulator={0,1};
#|            int status=OMEGA_Q_OK;
#|            for (size_t k=0;k<inner;++k) {
#|                omega_q64 x={a.numerators[i*inner+k],a.denominators[i*inner+k]};
#|                omega_q64 y={b.numerators[k*columns+j],b.denominators[k*columns+j]};
#|                omega_q64 product;
#|                status=omega_q64_mul(&product,x,y);
#|                if (status!=OMEGA_Q_OK) {
#|                    break;
#|                }
#|                status=omega_q64_add(&accumulator,accumulator,product);
#|                if (status!=OMEGA_Q_OK) {
#|                    break;
#|                }
#|            }
#|            size_t index=i*columns+j;
#|            out.status[index]=status==OMEGA_Q_OK ? OKQ_SUCCESS :
#|                status==OMEGA_Q_OVERFLOW ? OKQ_ARITHMETIC_OVERFLOW : OKQ_BAD_RATIONAL;
#|            out.numerators[index]=status==OMEGA_Q_OK ? accumulator.numerator : 0;
#|            out.denominators[index]=status==OMEGA_Q_OK ? accumulator.denominator : 1;
#|        }
#|    }
#|    return OKQ_SUCCESS;
#|}
#|
#|#endif
# OMEGA-KERNEL-FILE-END
# OMEGA-KERNEL-FILE "kernel/native/tensor_gmp.h"
#|#ifndef OMEGA_KERNEL_TENSOR_GMP_H
#|#define OMEGA_KERNEL_TENSOR_GMP_H
#|
#|/* A matrix is an integer grid over one positive common denominator. Matrix
#| * products normalize once per output matrix, not once per multiply-accumulate.
#| * A compact int16 representation activates checked SIMD dot products. General
#| * inputs retain GMP precision; no denominator is truncated to make them fit.
#| */
#|#include <gmp.h>
#|#include <stdlib.h>
#|#include <stdint.h>
#|#include <stddef.h>
#|#include "tensor.h"
#|
#|_Static_assert(sizeof(long) >= 8, "GMP compact dot path requires a 64-bit long");
#|
#|enum {
#|    OKG_SUCCESS,
#|    OKG_ARGUMENT,
#|    OKG_ALLOCATION,
#|    OKG_BUDGET,
#|    OKG_INPUT,
#|    OKG_SHAPE
#|};
#|
#|typedef struct {
#|    size_t limit;
#|    size_t charged;
#|    size_t peak;
#|    unsigned bits;
#|} okg_budget;
#|
#|typedef struct {
#|    size_t rows;
#|    size_t columns;
#|    size_t count;
#|    mpz_t *numerators;
#|    mpz_t denominator;
#|    okg_budget *budget;
#|    size_t charge;
#|    unsigned initialized;
#|    unsigned backend;
#|    size_t simd_products;
#|} okg_matrix;
#|
#|typedef int (*okg_reader)(void *, size_t, mpq_t);
#|
#|static inline int okg_budget_init(okg_budget *b, size_t limit, unsigned bits)
#|{
#|    if (!b || limit<4096 || limit>1073741824 || bits<64 || bits>8192) {
#|        return 0;
#|    }
#|    b->limit=limit;
#|    b->charged=0;
#|    b->peak=0;
#|    b->bits=bits;
#|    return 1;
#|}
#|
#|static inline int okg_reserve(okg_budget *b, size_t bytes)
#|{
#|    if (!b || b->charged>b->limit || bytes>b->limit-b->charged) {
#|        return 0;
#|    }
#|    b->charged+=bytes;
#|    if (b->charged>b->peak) {
#|        b->peak=b->charged;
#|    }
#|    return 1;
#|}
#|
#|static inline void okg_release(okg_budget *b, size_t bytes)
#|{
#|    if (b && bytes<=b->charged) {
#|        b->charged-=bytes;
#|    }
#|}
#|
#|static inline int okg_allocate(okg_matrix *out, size_t rows, size_t columns,
#|                               okg_budget *budget)
#|{
#|    if (!out || out->initialized || !budget || !rows || !columns ||
#|        rows>1024 || columns>1024 || rows>1048576/columns) {
#|        return OKG_ARGUMENT;
#|    }
#|    size_t count=rows*columns;
#|    size_t per_cell=(budget->bits+7)/8+sizeof(mpz_t)+32;
#|    if (count>(SIZE_MAX-128)/per_cell) {
#|        return OKG_BUDGET;
#|    }
#|    size_t charge=count*per_cell+128;
#|    if (!okg_reserve(budget,charge)) {
#|        return OKG_BUDGET;
#|    }
#|    mpz_t *cells=calloc(count,sizeof(mpz_t));
#|    if (!cells) {
#|        okg_release(budget,charge);
#|        return OKG_ALLOCATION;
#|    }
#|    for (size_t i=0;i<count;++i) {
#|        mpz_init2(cells[i],64);
#|    }
#|    mpz_init_set_ui(out->denominator,1);
#|    out->rows=rows;
#|    out->columns=columns;
#|    out->count=count;
#|    out->numerators=cells;
#|    out->budget=budget;
#|    out->charge=charge;
#|    out->initialized=1;
#|    out->backend=OKQ_SCALAR;
#|    out->simd_products=0;
#|    return OKG_SUCCESS;
#|}
#|
#|static inline void okg_clear(okg_matrix *matrix)
#|{
#|    if (!matrix || !matrix->initialized) {
#|        return;
#|    }
#|    for (size_t i=0;i<matrix->count;++i) {
#|        mpz_clear(matrix->numerators[i]);
#|    }
#|    free(matrix->numerators);
#|    mpz_clear(matrix->denominator);
#|    okg_release(matrix->budget,matrix->charge);
#|    matrix->initialized=0;
#|    matrix->numerators=NULL;
#|    matrix->rows=0;
#|    matrix->columns=0;
#|    matrix->count=0;
#|}
#|
#|static inline int okg_within(const okg_matrix *matrix, const mpz_t value)
#|{
#|    return matrix && matrix->initialized &&
#|           mpz_sizeinbase(value,2)<=matrix->budget->bits;
#|}
#|
#|static inline int okg_normalize(okg_matrix *matrix)
#|{
#|    if (!matrix || !matrix->initialized || mpz_sgn(matrix->denominator)<=0) {
#|        return OKG_ARGUMENT;
#|    }
#|    mpz_t common;
#|    mpz_init_set(common,matrix->denominator);
#|    for (size_t i=0;i<matrix->count;++i) {
#|        if (!okg_within(matrix,matrix->numerators[i])) {
#|            mpz_clear(common);
#|            return OKG_BUDGET;
#|        }
#|        if (mpz_cmp_ui(common,1)!=0) {
#|            mpz_gcd(common,common,matrix->numerators[i]);
#|        }
#|    }
#|    if (!okg_within(matrix,matrix->denominator)) {
#|        mpz_clear(common);
#|        return OKG_BUDGET;
#|    }
#|    if (mpz_cmp_ui(common,1)>0) {
#|        mpz_divexact(matrix->denominator,matrix->denominator,common);
#|        for (size_t i=0;i<matrix->count;++i) {
#|            mpz_divexact(matrix->numerators[i],matrix->numerators[i],common);
#|        }
#|    }
#|    mpz_clear(common);
#|    return OKG_SUCCESS;
#|}
#|
#|static int okg_from_reader(okg_matrix *out, size_t rows, size_t columns,
#|                            okg_budget *budget, okg_reader reader, void *context)
#|{
#|    if (!reader) {
#|        return OKG_ARGUMENT;
#|    }
#|    int status=okg_allocate(out,rows,columns,budget);
#|    if (status) {
#|        return status;
#|    }
#|    mpq_t q;
#|    mpz_t divisor;
#|    mpz_t multiplier;
#|    mpq_init(q);
#|    mpz_init(divisor);
#|    mpz_init(multiplier);
#|    for (size_t i=0;i<out->count;++i) {
#|        if (!reader(context,i,q) || mpz_sgn(mpq_denref(q))<=0 ||
#|            !okg_within(out,mpq_numref(q)) || !okg_within(out,mpq_denref(q))) {
#|            status=OKG_INPUT;
#|            break;
#|        }
#|        mpz_gcd(divisor,out->denominator,mpq_denref(q));
#|        mpz_divexact(multiplier,out->denominator,divisor);
#|        mpz_mul(out->denominator,multiplier,mpq_denref(q));
#|        if (!okg_within(out,out->denominator)) {
#|            status=OKG_BUDGET;
#|            break;
#|        }
#|    }
#|    for (size_t i=0;!status && i<out->count;++i) {
#|        if (!reader(context,i,q) || mpz_sgn(mpq_denref(q))<=0 ||
#|            !mpz_divisible_p(out->denominator,mpq_denref(q))) {
#|            status=OKG_INPUT;
#|            break;
#|        }
#|        mpz_divexact(multiplier,out->denominator,mpq_denref(q));
#|        mpz_mul(out->numerators[i],mpq_numref(q),multiplier);
#|        if (!okg_within(out,out->numerators[i])) {
#|            status=OKG_BUDGET;
#|        }
#|    }
#|    if (!status) {
#|        status=okg_normalize(out);
#|    }
#|    mpq_clear(q);
#|    mpz_clear(divisor);
#|    mpz_clear(multiplier);
#|    if (status) {
#|        okg_clear(out);
#|    }
#|    return status;
#|}
#|
#|static inline int okg_clone(okg_matrix *out, const okg_matrix *source)
#|{
#|    if (!source || !source->initialized || out==source) {
#|        return OKG_ARGUMENT;
#|    }
#|    int status=okg_allocate(out,source->rows,source->columns,source->budget);
#|    if (status) {
#|        return status;
#|    }
#|    mpz_set(out->denominator,source->denominator);
#|    for (size_t i=0;i<source->count;++i) {
#|        mpz_set(out->numerators[i],source->numerators[i]);
#|    }
#|    return OKG_SUCCESS;
#|}
#|
#|static inline int okg_transpose(okg_matrix *out, const okg_matrix *source)
#|{
#|    if (!source || !source->initialized || out==source) {
#|        return OKG_ARGUMENT;
#|    }
#|    int status=okg_allocate(out,source->columns,source->rows,source->budget);
#|    if (status) {
#|        return status;
#|    }
#|    mpz_set(out->denominator,source->denominator);
#|    for (size_t i=0;i<source->rows;++i) {
#|        for (size_t j=0;j<source->columns;++j) {
#|            mpz_set(out->numerators[j*out->columns+i],source->numerators[i*source->columns+j]);
#|        }
#|    }
#|    return OKG_SUCCESS;
#|}
#|
#|static inline int okg_add(okg_matrix *out, const okg_matrix *a,
#|                           const okg_matrix *b, int subtract)
#|{
#|    if (!a || !b || !a->initialized || !b->initialized ||
#|        a->rows!=b->rows || a->columns!=b->columns || a->budget!=b->budget ||
#|        out==a || out==b || (subtract!=0 && subtract!=1)) {
#|        return OKG_SHAPE;
#|    }
#|    int status=okg_allocate(out,a->rows,a->columns,a->budget);
#|    if (status) {
#|        return status;
#|    }
#|    mpz_t common;
#|    mpz_t scale_a;
#|    mpz_t scale_b;
#|    mpz_t term;
#|    mpz_init(common);
#|    mpz_init(scale_a);
#|    mpz_init(scale_b);
#|    mpz_init(term);
#|    mpz_gcd(common,a->denominator,b->denominator);
#|    mpz_divexact(scale_a,b->denominator,common);
#|    mpz_divexact(scale_b,a->denominator,common);
#|    mpz_mul(out->denominator,a->denominator,scale_a);
#|    if (!okg_within(out,out->denominator)) {
#|        status=OKG_BUDGET;
#|    }
#|    for (size_t i=0;!status && i<a->count;++i) {
#|        mpz_mul(out->numerators[i],a->numerators[i],scale_a);
#|        mpz_mul(term,b->numerators[i],scale_b);
#|        if (subtract) {
#|            mpz_sub(out->numerators[i],out->numerators[i],term);
#|        } else {
#|            mpz_add(out->numerators[i],out->numerators[i],term);
#|        }
#|        if (!okg_within(out,out->numerators[i])) {
#|            status=OKG_BUDGET;
#|        }
#|    }
#|    if (!status) {
#|        status=okg_normalize(out);
#|    }
#|    mpz_clear(common);
#|    mpz_clear(scale_a);
#|    mpz_clear(scale_b);
#|    mpz_clear(term);
#|    if (status) {
#|        okg_clear(out);
#|    }
#|    return status;
#|}
#|
#|static inline int okg_hadamard(okg_matrix *out, const okg_matrix *a, const okg_matrix *b)
#|{
#|    if (!a || !b || !a->initialized || !b->initialized ||
#|        a->rows!=b->rows || a->columns!=b->columns || a->budget!=b->budget ||
#|        out==a || out==b) {
#|        return OKG_SHAPE;
#|    }
#|    int status=okg_allocate(out,a->rows,a->columns,a->budget);
#|    if (status) {
#|        return status;
#|    }
#|    mpz_mul(out->denominator,a->denominator,b->denominator);
#|    if (!okg_within(out,out->denominator)) {
#|        status=OKG_BUDGET;
#|    }
#|    for (size_t i=0;!status && i<a->count;++i) {
#|        mpz_mul(out->numerators[i],a->numerators[i],b->numerators[i]);
#|        if (!okg_within(out,out->numerators[i])) {
#|            status=OKG_BUDGET;
#|        }
#|    }
#|    if (!status) {
#|        status=okg_normalize(out);
#|    }
#|    if (status) {
#|        okg_clear(out);
#|    }
#|    return status;
#|}
#|
#|static inline int okg_small_grid(const okg_matrix *a)
#|{
#|    for (size_t i=0;i<a->count;++i) {
#|        if (mpz_cmp_si(a->numerators[i],-32767)<0 || mpz_cmp_si(a->numerators[i],32767)>0) {
#|            return 0;
#|        }
#|    }
#|    return 1;
#|}
#|
#|static int okg_gemm(okg_matrix *out, const okg_matrix *a,
#|                     const okg_matrix *b, unsigned requested)
#|{
#|    if (!a || !b || !a->initialized || !b->initialized ||
#|        a->columns!=b->rows || a->budget!=b->budget || out==a || out==b) {
#|        return OKG_SHAPE;
#|    }
#|    unsigned backend=okq_choose(requested);
#|    if (backend==UINT_MAX) {
#|        return OKG_ARGUMENT;
#|    }
#|    int status=okg_allocate(out,a->rows,b->columns,a->budget);
#|    if (status) {
#|        return status;
#|    }
#|    mpz_mul(out->denominator,a->denominator,b->denominator);
#|    if (!okg_within(out,out->denominator)) {
#|        okg_clear(out);
#|        return OKG_BUDGET;
#|    }
#|    int small=a->columns<=4096 && okg_small_grid(a) && okg_small_grid(b);
#|    size_t packed_bytes=(a->count+b->count)*sizeof(int16_t);
#|    if (small && okg_reserve(a->budget,packed_bytes)) {
#|        int16_t *left=malloc(a->count*sizeof(int16_t));
#|        int16_t *right=malloc(b->count*sizeof(int16_t));
#|        if (!left || !right) {
#|            free(left);
#|            free(right);
#|            okg_release(a->budget,packed_bytes);
#|            okg_clear(out);
#|            return OKG_ALLOCATION;
#|        }
#|        for (size_t i=0;i<a->count;++i) {
#|            left[i]=(int16_t)mpz_get_si(a->numerators[i]);
#|        }
#|        for (size_t i=0;i<b->rows;++i) {
#|            for (size_t j=0;j<b->columns;++j) {
#|                right[j*b->rows+i]=(int16_t)mpz_get_si(b->numerators[i*b->columns+j]);
#|            }
#|        }
#|        for (size_t i=0;i<a->rows;++i) {
#|            for (size_t j=0;j<b->columns;++j) {
#|                int64_t value=okq_dot16(left+i*a->columns,right+j*b->rows,a->columns,backend);
#|                mpz_set_si(out->numerators[i*out->columns+j],(long)value);
#|            }
#|        }
#|        out->backend=backend;
#|        out->simd_products=backend==OKQ_SCALAR ? 0 : a->rows*b->columns*a->columns;
#|        free(left);
#|        free(right);
#|        okg_release(a->budget,packed_bytes);
#|    } else {
#|        /* i-k-j tile order reuses A and traverses B/C rows contiguously. */
#|        size_t max_a=1;
#|        size_t max_b=1;
#|        for (size_t i=0;i<a->count;++i) {
#|            size_t bits=mpz_sizeinbase(a->numerators[i],2);
#|            if (bits>max_a) {
#|                max_a=bits;
#|            }
#|        }
#|        for (size_t i=0;i<b->count;++i) {
#|            size_t bits=mpz_sizeinbase(b->numerators[i],2);
#|            if (bits>max_b) {
#|                max_b=bits;
#|            }
#|        }
#|        size_t reserve_bits=max_a+max_b+16;
#|        if (reserve_bits>out->budget->bits+16) {
#|            okg_clear(out);
#|            return OKG_BUDGET;
#|        }
#|        for (size_t i=0;i<out->count;++i) {
#|            mpz_realloc2(out->numerators[i],reserve_bits);
#|        }
#|        const size_t tile=16;
#|        for (size_t ii=0;ii<a->rows;ii+=tile) {
#|            size_t ie=ii+tile<a->rows ? ii+tile : a->rows;
#|            for (size_t kk=0;kk<a->columns;kk+=tile) {
#|                size_t ke=kk+tile<a->columns ? kk+tile : a->columns;
#|                for (size_t jj=0;jj<b->columns;jj+=tile) {
#|                    size_t je=jj+tile<b->columns ? jj+tile : b->columns;
#|                    for (size_t i=ii;i<ie;++i) {
#|                        for (size_t k=kk;k<ke;++k) {
#|                            for (size_t j=jj;j<je;++j) {
#|                                mpz_addmul(out->numerators[i*out->columns+j],
#|                                           a->numerators[i*a->columns+k],
#|                                           b->numerators[k*b->columns+j]);
#|                            }
#|                        }
#|                    }
#|                }
#|            }
#|        }
#|    }
#|    status=okg_normalize(out);
#|    if (status) {
#|        okg_clear(out);
#|    }
#|    return status;
#|}
#|
#|static inline int okg_scale(okg_matrix *out, const okg_matrix *source, const mpq_t factor)
#|{
#|    if (!source || !source->initialized || mpz_sgn(mpq_denref(factor))<=0) {
#|        return OKG_ARGUMENT;
#|    }
#|    int status=okg_allocate(out,source->rows,source->columns,source->budget);
#|    if (status) {
#|        return status;
#|    }
#|    mpz_mul(out->denominator,source->denominator,mpq_denref(factor));
#|    for (size_t i=0;i<source->count;++i) {
#|        mpz_mul(out->numerators[i],source->numerators[i],mpq_numref(factor));
#|    }
#|    status=okg_normalize(out);
#|    if (status) {
#|        okg_clear(out);
#|    }
#|    return status;
#|}
#|
#|static inline int okg_reduce(okg_matrix *out, const okg_matrix *source, int square)
#|{
#|    if (!source || !source->initialized || (square!=0 && square!=1)) {
#|        return OKG_ARGUMENT;
#|    }
#|    int status=okg_allocate(out,1,1,source->budget);
#|    if (status) {
#|        return status;
#|    }
#|    mpz_set(out->denominator,source->denominator);
#|    if (square) {
#|        mpz_mul(out->denominator,out->denominator,out->denominator);
#|    }
#|    for (size_t i=0;i<source->count;++i) {
#|        if (square) {
#|            mpz_addmul(out->numerators[0],source->numerators[i],source->numerators[i]);
#|        } else {
#|            mpz_add(out->numerators[0],out->numerators[0],source->numerators[i]);
#|        }
#|        if (!okg_within(out,out->numerators[0])) {
#|            status=OKG_BUDGET;
#|            break;
#|        }
#|    }
#|    if (!status) {
#|        status=okg_normalize(out);
#|    }
#|    if (status) {
#|        okg_clear(out);
#|    }
#|    return status;
#|}
#|
#|static inline int okg_relu(okg_matrix *out, const okg_matrix *source)
#|{
#|    int status=okg_clone(out,source);
#|    if (status) {
#|        return status;
#|    }
#|    for (size_t i=0;i<out->count;++i) {
#|        if (mpz_sgn(out->numerators[i])<0) {
#|            mpz_set_ui(out->numerators[i],0);
#|        }
#|    }
#|    status=okg_normalize(out);
#|    if (status) {
#|        okg_clear(out);
#|    }
#|    return status;
#|}
#|
#|static inline int okg_relu_pullback(okg_matrix *out, const okg_matrix *source,
#|                                    const okg_matrix *gradient)
#|{
#|    if (!source || !gradient || !source->initialized || !gradient->initialized ||
#|        source->rows!=gradient->rows || source->columns!=gradient->columns) {
#|        return OKG_SHAPE;
#|    }
#|    int status=okg_clone(out,gradient);
#|    if (status) {
#|        return status;
#|    }
#|    for (size_t i=0;i<out->count;++i) {
#|        /* Declared subgradient at zero is zero. */
#|        if (mpz_sgn(source->numerators[i])<=0) {
#|            mpz_set_ui(out->numerators[i],0);
#|        }
#|    }
#|    status=okg_normalize(out);
#|    if (status) {
#|        okg_clear(out);
#|    }
#|    return status;
#|}
#|
#|static inline int okg_equal(const okg_matrix *a, const okg_matrix *b)
#|{
#|    if (!a || !b || !a->initialized || !b->initialized ||
#|        a->rows!=b->rows || a->columns!=b->columns) {
#|        return 0;
#|    }
#|    mpz_t left;
#|    mpz_t right;
#|    mpz_init(left);
#|    mpz_init(right);
#|    int equal=1;
#|    for (size_t i=0;i<a->count;++i) {
#|        mpz_mul(left,a->numerators[i],b->denominator);
#|        mpz_mul(right,b->numerators[i],a->denominator);
#|        if (mpz_cmp(left,right)!=0) {
#|            equal=0;
#|            break;
#|        }
#|    }
#|    mpz_clear(left);
#|    mpz_clear(right);
#|    return equal;
#|}
#|
#|static inline int okg_accumulate(okg_matrix *target, okg_matrix *contribution)
#|{
#|    if (!target || !contribution || !contribution->initialized || target==contribution) {
#|        return OKG_ARGUMENT;
#|    }
#|    if (!target->initialized) {
#|        *target=*contribution;
#|        contribution->initialized=0;
#|        contribution->numerators=NULL;
#|        return OKG_SUCCESS;
#|    }
#|    okg_matrix sum={0};
#|    int status=okg_add(&sum,target,contribution,0);
#|    if (status) {
#|        return status;
#|    }
#|    okg_clear(target);
#|    *target=sum;
#|    sum.initialized=0;
#|    return OKG_SUCCESS;
#|}
#|
#|#endif
# OMEGA-KERNEL-FILE-END
# OMEGA-KERNEL-FILE "kernel/native/tensor_graph.h"
#|#ifndef OMEGA_KERNEL_TENSOR_GRAPH_H
#|#define OMEGA_KERNEL_TENSOR_GRAPH_H
#|#include "tensor_gmp.h"
#|
#|#define OKG_GRAPH_MAX 64
#|#define OKG_GRAPH_CELLS 16384
#|
#|enum {
#|    OKG_INPUT_NODE,
#|    OKG_ADD_NODE,
#|    OKG_SUB_NODE,
#|    OKG_HADAMARD_NODE,
#|    OKG_MATMUL_NODE,
#|    OKG_TRANSPOSE_NODE,
#|    OKG_RELU_NODE,
#|    OKG_SUM_NODE,
#|    OKG_SQUARE_SUM_NODE,
#|    OKG_GRAPH_TAGS
#|};
#|
#|typedef struct {
#|    unsigned operation;
#|    size_t arguments[2];
#|    okg_matrix value;
#|    okg_matrix gradient;
#|} okg_graph_node;
#|
#|typedef struct {
#|    okg_graph_node nodes[OKG_GRAPH_MAX];
#|    size_t count;
#|    size_t output;
#|    size_t cells;
#|    okg_budget *budget;
#|    unsigned backend;
#|} okg_graph;
#|
#|static inline unsigned okg_graph_arity(unsigned operation)
#|{
#|    if (operation==OKG_INPUT_NODE) {
#|        return 0;
#|    }
#|    if (operation==OKG_ADD_NODE || operation==OKG_SUB_NODE ||
#|        operation==OKG_HADAMARD_NODE || operation==OKG_MATMUL_NODE) {
#|        return 2;
#|    }
#|    return 1;
#|}
#|
#|static inline void okg_graph_clear(okg_graph *graph)
#|{
#|    if (!graph) {
#|        return;
#|    }
#|    for (size_t i=0;i<graph->count && i<OKG_GRAPH_MAX;++i) {
#|        okg_clear(&graph->nodes[i].value);
#|        okg_clear(&graph->nodes[i].gradient);
#|    }
#|    graph->count=0;
#|    graph->cells=0;
#|}
#|
#|static inline int okg_fill(okg_matrix *out, size_t rows, size_t columns,
#|                            const mpq_t value, okg_budget *budget)
#|{
#|    int status=okg_allocate(out,rows,columns,budget);
#|    if (status) {
#|        return status;
#|    }
#|    mpz_set(out->denominator,mpq_denref(value));
#|    for (size_t i=0;i<out->count;++i) {
#|        mpz_set(out->numerators[i],mpq_numref(value));
#|    }
#|    status=okg_normalize(out);
#|    if (status) {
#|        okg_clear(out);
#|    }
#|    return status;
#|}
#|
#|static int okg_graph_forward(okg_graph *graph)
#|{
#|    if (!graph || !graph->budget || graph->count==0 || graph->count>OKG_GRAPH_MAX ||
#|        graph->output>=graph->count || okq_choose(graph->backend)==UINT_MAX) {
#|        return OKG_ARGUMENT;
#|    }
#|    graph->cells=0;
#|    for (size_t i=0;i<graph->count;++i) {
#|        okg_graph_node *node=&graph->nodes[i];
#|        if (node->operation>=OKG_GRAPH_TAGS) {
#|            return OKG_ARGUMENT;
#|        }
#|        unsigned arity=okg_graph_arity(node->operation);
#|        for (unsigned j=0;j<arity;++j) {
#|            if (node->arguments[j]>=i) {
#|                return OKG_ARGUMENT;
#|            }
#|        }
#|        const okg_matrix *a=arity ? &graph->nodes[node->arguments[0]].value : NULL;
#|        const okg_matrix *b=arity>1 ? &graph->nodes[node->arguments[1]].value : NULL;
#|        int status=OKG_SUCCESS;
#|        switch (node->operation) {
#|        case OKG_INPUT_NODE:
#|            if (!node->value.initialized || node->value.budget!=graph->budget) {
#|                return OKG_INPUT;
#|            }
#|            break;
#|        case OKG_ADD_NODE:
#|        case OKG_SUB_NODE:
#|            status=okg_add(&node->value,a,b,node->operation==OKG_SUB_NODE);
#|            break;
#|        case OKG_HADAMARD_NODE:
#|            status=okg_hadamard(&node->value,a,b);
#|            break;
#|        case OKG_MATMUL_NODE:
#|            status=okg_gemm(&node->value,a,b,graph->backend);
#|            break;
#|        case OKG_TRANSPOSE_NODE:
#|            status=okg_transpose(&node->value,a);
#|            break;
#|        case OKG_RELU_NODE:
#|            status=okg_relu(&node->value,a);
#|            break;
#|        case OKG_SUM_NODE:
#|        case OKG_SQUARE_SUM_NODE:
#|            status=okg_reduce(&node->value,a,node->operation==OKG_SQUARE_SUM_NODE);
#|            break;
#|        default:
#|            return OKG_ARGUMENT;
#|        }
#|        if (status) {
#|            return status;
#|        }
#|        if (node->value.count>OKG_GRAPH_CELLS-graph->cells) {
#|            return OKG_BUDGET;
#|        }
#|        graph->cells+=node->value.count;
#|    }
#|    return OKG_SUCCESS;
#|}
#|
#|static int okg_graph_backward(okg_graph *graph, const okg_matrix *seed)
#|{
#|    if (!graph || graph->count==0 || graph->count>OKG_GRAPH_MAX || graph->output>=graph->count) {
#|        return OKG_ARGUMENT;
#|    }
#|    for (size_t i=0;i<graph->count;++i) {
#|        if (graph->nodes[i].gradient.initialized) {
#|            return OKG_ARGUMENT;
#|        }
#|    }
#|    okg_graph_node *output=&graph->nodes[graph->output];
#|    int status;
#|    if (seed) {
#|        if (!seed->initialized || seed->rows!=output->value.rows ||
#|            seed->columns!=output->value.columns || seed->budget!=graph->budget) {
#|            return OKG_SHAPE;
#|        }
#|        status=okg_clone(&output->gradient,seed);
#|    } else {
#|        if (output->value.count!=1) {
#|            return OKG_SHAPE;
#|        }
#|        mpq_t one;
#|        mpq_init(one);
#|        mpq_set_ui(one,1,1);
#|        status=okg_fill(&output->gradient,1,1,one,graph->budget);
#|        mpq_clear(one);
#|    }
#|    if (status) {
#|        return status;
#|    }
#|    for (size_t cursor=graph->output+1;cursor>0;--cursor) {
#|        size_t index=cursor-1;
#|        okg_graph_node *node=&graph->nodes[index];
#|        if (!node->gradient.initialized || node->operation==OKG_INPUT_NODE) {
#|            continue;
#|        }
#|        okg_matrix *a=&graph->nodes[node->arguments[0]].value;
#|        okg_matrix *b=okg_graph_arity(node->operation)>1 ?
#|                       &graph->nodes[node->arguments[1]].value : NULL;
#|        okg_matrix first={0};
#|        okg_matrix second={0};
#|        okg_matrix temporary={0};
#|        mpq_t scalar;
#|        mpq_init(scalar);
#|        switch (node->operation) {
#|        case OKG_ADD_NODE:
#|            status=okg_clone(&first,&node->gradient);
#|            if (!status) {
#|                status=okg_clone(&second,&node->gradient);
#|            }
#|            break;
#|        case OKG_SUB_NODE:
#|            status=okg_clone(&first,&node->gradient);
#|            mpq_set_si(scalar,-1,1);
#|            if (!status) {
#|                status=okg_scale(&second,&node->gradient,scalar);
#|            }
#|            break;
#|        case OKG_HADAMARD_NODE:
#|            status=okg_hadamard(&first,&node->gradient,b);
#|            if (!status) {
#|                status=okg_hadamard(&second,&node->gradient,a);
#|            }
#|            break;
#|        case OKG_MATMUL_NODE:
#|            status=okg_transpose(&temporary,b);
#|            if (!status) {
#|                status=okg_gemm(&first,&node->gradient,&temporary,graph->backend);
#|            }
#|            okg_clear(&temporary);
#|            if (!status) {
#|                status=okg_transpose(&temporary,a);
#|            }
#|            if (!status) {
#|                status=okg_gemm(&second,&temporary,&node->gradient,graph->backend);
#|            }
#|            break;
#|        case OKG_TRANSPOSE_NODE:
#|            status=okg_transpose(&first,&node->gradient);
#|            break;
#|        case OKG_RELU_NODE:
#|            status=okg_relu_pullback(&first,a,&node->gradient);
#|            break;
#|        case OKG_SUM_NODE:
#|            mpz_set(mpq_numref(scalar),node->gradient.numerators[0]);
#|            mpz_set(mpq_denref(scalar),node->gradient.denominator);
#|            mpq_canonicalize(scalar);
#|            status=okg_fill(&first,a->rows,a->columns,scalar,graph->budget);
#|            break;
#|        case OKG_SQUARE_SUM_NODE:
#|            mpz_mul_ui(mpq_numref(scalar),node->gradient.numerators[0],2);
#|            mpz_set(mpq_denref(scalar),node->gradient.denominator);
#|            mpq_canonicalize(scalar);
#|            status=okg_scale(&first,a,scalar);
#|            break;
#|        default:
#|            status=OKG_ARGUMENT;
#|            break;
#|        }
#|        if (!status) {
#|            status=okg_accumulate(&graph->nodes[node->arguments[0]].gradient,&first);
#|        }
#|        if (!status && okg_graph_arity(node->operation)==2) {
#|            status=okg_accumulate(&graph->nodes[node->arguments[1]].gradient,&second);
#|        }
#|        mpq_clear(scalar);
#|        okg_clear(&first);
#|        okg_clear(&second);
#|        okg_clear(&temporary);
#|        if (status) {
#|            return status;
#|        }
#|    }
#|    return OKG_SUCCESS;
#|}
#|
#|#endif
# OMEGA-KERNEL-FILE-END
# OMEGA-KERNEL-FILE "kernel/omega/aarch64.omega"
#|modulo direct_aarch64;
#|importar "assembler.omega" como a;
#|exportar constant, load, store, unary, binary, jump, zero_branch, prologue, epilogue;
#|
#|# Linux AArch64, little endian. x19 is the BSS base; x9/x10 are expression
#|# operands. Syscall arguments use x0..x3, the syscall number uses x8.
#|funcao constant(s,reg,value) {
#|  a::word(s,3531603968+a::part(value,0,16)*32+reg);
#|  var i=1;
#|  enquanto(i<4) {
#|    a::word(s,4068474880+i*2097152+a::part(value,16*i,16)*32+reg);
#|    i=i+1;
#|  }
#|  retornar 0;
#|}
#|funcao load(s,reg,offset) {
#|  a::word(s,4181721088+(offset/8)*1024+19*32+reg);
#|  retornar 0;
#|}
#|funcao store(s,reg,offset) {
#|  a::word(s,4177526784+(offset/8)*1024+19*32+reg);
#|  retornar 0;
#|}
#|funcao byte(s,reg,offset) {
#|  a::word(s,956301312+offset*1024+19*32+reg);
#|  retornar 0;
#|}
#|funcao move(s,dst,src) {
#|  a::word(s,2852127712+src*65536+dst);
#|  retornar 0;
#|}
#|funcao reg(s,opcode,dst,left,right) {
#|  a::word(s,opcode+right*65536+left*32+dst);
#|  retornar 0;
#|}
#|funcao cmp(s,left,right) {
#|  reg(s,3942645791,0,left,right);
#|  retornar 0;
#|}
#|funcao conditional(s,condition,label) {
#|  a::fixup(s,"a64-cond",label,condition);
#|  retornar 0;
#|}
#|funcao jump(s,label) {
#|  a::fixup(s,"a64-b",label,0);
#|  retornar 0;
#|}
#|funcao zero_branch(s,label) {
#|  cmp(s,9,31);
#|  conditional(s,0,label);
#|  retornar 0;
#|}
#|funcao set(s,condition) {
#|  var inverse=condition+1;
#|  se(condition%2==1) { inverse=condition-1; }
#|  a::word(s,2594113504+inverse*4096+9);
#|  retornar 0;
#|}
#|funcao unary(s,op) {
#|  se(op=="-") {
#|    reg(s,3942645760,9,31,9);
#|    conditional(s,6,"error_overflow");
#|  } senao {
#|    cmp(s,9,31);
#|    set(s,0);
#|  }
#|  retornar 0;
#|}
#|funcao binary(s,op) {
#|  se(op=="+"||op=="-") {
#|    var opcode=2868903936;
#|    se(op=="-") { opcode=3942645760; }
#|    reg(s,opcode,9,9,10);
#|    conditional(s,6,"error_overflow");
#|    retornar 0;
#|  }
#|  se(op=="*") {
#|    reg(s,2600500224,11,9,10);
#|    reg(s,2604694528,12,9,10);
#|    a::word(s,2470444032+63*65536+63*1024+11*32+13);
#|    cmp(s,12,13);
#|    conditional(s,1,"error_overflow");
#|    move(s,9,11);
#|    retornar 0;
#|  }
#|  se(op=="/"||op=="%") {
#|    cmp(s,10,31);
#|    conditional(s,0,"error_zero");
#|    constant(s,11,-9223372036854775808);
#|    cmp(s,9,11);
#|    var normal=a::fresh(s,"div_normal_");
#|    conditional(s,1,normal);
#|    constant(s,11,-1);
#|    cmp(s,10,11);
#|    conditional(s,0,"error_overflow");
#|    a::mark(s,normal);
#|    reg(s,2596277248,11,9,10);
#|    a::word(s,2600501248+10*65536+9*1024+11*32+12);
#|    se(op=="/") {
#|      cmp(s,12,31);
#|      conditional(s,1,"error_nonintegral");
#|      move(s,9,11);
#|    } senao { move(s,9,12); }
#|    retornar 0;
#|  }
#|  cmp(s,9,10);
#|  var condition=0;
#|  se(op=="!=") { condition=1; }
#|  se(op=="<") { condition=11; }
#|  se(op=="<=") { condition=13; }
#|  se(op==">") { condition=12; }
#|  se(op==">=") { condition=10; }
#|  set(s,condition);
#|  retornar 0;
#|}
#|funcao syscall(s,number) {
#|  constant(s,8,number);
#|  a::word(s,3556769793);
#|  retornar 0;
#|}
#|funcao check_negative(s,label) {
#|  cmp(s,0,31);
#|  conditional(s,11,label);
#|  retornar 0;
#|}
#|funcao retry(s,label) {
#|  constant(s,11,-4);
#|  cmp(s,0,11);
#|  conditional(s,0,label);
#|  retornar 0;
#|}
#|funcao address(s,reg,offset) {
#|  a::word(s,2432696320+offset*1024+19*32+reg);
#|  retornar 0;
#|}
#|funcao prologue(s,parameters) {
#|  constant(s,19,6291456);
#|  a::word(s,4181721088+31*32+9);
#|  constant(s,10,2);
#|  cmp(s,9,10);
#|  conditional(s,1,"error_io");
#|  constant(s,0,-100);
#|  a::word(s,4181721088+2*1024+31*32+1);
#|  constant(s,2,0);
#|  constant(s,3,0);
#|  syscall(s,56);
#|  check_negative(s,"error_io");
#|  store(s,0,160);
#|  se(parameters>0) {
#|    a::mark(s,"read_loop");
#|    load(s,0,160);
#|    load(s,11,168);
#|    reg(s,2332033024,1,19,11);
#|    constant(s,2,parameters*8);
#|    reg(s,3405774848,2,2,11);
#|    syscall(s,63);
#|    retry(s,"read_loop");
#|    cmp(s,0,31);
#|    conditional(s,13,"error_io");
#|    load(s,11,168);
#|    reg(s,2332033024,11,11,0);
#|    store(s,11,168);
#|    constant(s,12,parameters*8);
#|    cmp(s,11,12);
#|    conditional(s,3,"read_loop");
#|  }
#|  a::mark(s,"read_tail");
#|  load(s,0,160);
#|  address(s,1,200);
#|  constant(s,2,1);
#|  syscall(s,63);
#|  retry(s,"read_tail");
#|  cmp(s,0,31);
#|  conditional(s,1,"error_io");
#|  load(s,0,160);
#|  syscall(s,57);
#|  retornar 0;
#|}
#|funcao epilogue(s) {
#|  a::mark(s,"success");
#|  store(s,9,192);
#|  constant(s,9,0);
#|  store(s,9,184);
#|  jump(s,"print_result");
#|  var errors=["error_overflow","error_zero","error_io","error_nonintegral"];
#|  var i=0;
#|  enquanto(i<4) {
#|    a::mark(s,errors[i]);
#|    constant(s,9,0);
#|    store(s,9,192);
#|    constant(s,9,i+1);
#|    store(s,9,184);
#|    jump(s,"print_result");
#|    i=i+1;
#|  }
#|  a::mark(s,"print_result");
#|  load(s,9,184);
#|  a::word(s,2432696320+48*1024+9*32+9);
#|  byte(s,9,128);
#|  load(s,9,192);
#|  constant(s,13,15);
#|  i=0;
#|  enquanto(i<16) {
