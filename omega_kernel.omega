#|    enquanto(i<len(values)) { sum=iv::add(sum,iv::scale(intervals[i],values[i][dimension])); i=i+1; }
#|    push(enclosure,sum); dimension=dimension+1;
#|  }
#|  var out=obj(); put(out,"weight_intervals",intervals); put(out,"normalized_midpoint_weights",midpoints);
#|  put(out,"value_intervals",enclosure); put(out,"key_midpoint",a::apply(u::transpose(keys),midpoints));
#|  retornar out;
#|}
#|funcao execute(r) {
#|  var keys=u::mat(r["keys"]); var values=u::mat(r["values"]); var capacity=u::count(r,"capacity",1,32);
#|  se(len(keys)!=len(values)||len(keys)>capacity||len(keys[0])>16||len(values[0])>16) { fail("Finite associative bank shape/capacity"); }
#|  var evicted=0;
#|  se(has(r,"new_key")) {
#|    var key=u::vector(r["new_key"]); var value=u::vector(r["new_value"]);
#|    se(len(key)!=len(keys[0])||len(value)!=len(values[0])) { fail("Associative insertion shape"); }
