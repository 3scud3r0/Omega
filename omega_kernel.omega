#|exportar execute;
#|
#|# Rational rank-revealing TT, using pivot columns and orthogonal projections.
#|# No claim of SVD-optimal truncation: the full reconstruction residual is exact.
#|# Already-factorized trains can be contracted without materializing dense tensors.
#|funcao train_read(raw) {
