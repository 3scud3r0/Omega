  }
  se((op=="unary")) {
    var operand=om_mod_4_expression(s,arch,(ast)[2],env,slots);
    om_mod_4_load(s,arch,om_mod_4_result_register(arch),operand);
    om_mod_4_unary(s,arch,(ast)[1]);
  }
  se((op=="binary")) {
    var left=om_mod_4_expression(s,arch,(ast)[2],env,slots);
    se((((ast)[1]=="&&")||((ast)[1]=="||"))) {
      var short=om_mod_3_fresh(s,"short_");
