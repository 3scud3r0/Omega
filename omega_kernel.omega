#|  var state=u::vector(r["state"]); var input=u::vector(r["input"]);
#|  var transition=u::mat(r["transition"]); var input_map=u::mat(r["input_map"]); var query_map=u::mat(r["query_map"]);
#|  var n=len(state);
#|  se(n<1||n>16||len(transition)!=n||len(transition[0])!=n||len(input_map)!=n||len(input_map[0])!=len(input)||len(query_map)!=len(keys[0])||len(query_map[0])!=n) { fail("SSM dimensions"); }
#|  var norm=0; var i=0;
#|  enquanto(i<n) {
#|    var row_sum=0; var j=0;
#|    enquanto(j<n) { row_sum=row_sum+m::abs(transition[i][j]); j=j+1; }
#|    norm=m::max(norm,row_sum); i=i+1;
#|  }
#|  se(norm>1) { fail("SSM recurrent infinity norm must be <=1"); }
