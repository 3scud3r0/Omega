funcao om_mod_30_canonical(x) {
  se(isnum(x)) {
    retornar (("[\"q\","+json(om_mod_30_format_q(x)))+"]");
  }
  se(isstr(x)) {
    retornar (("[\"s\","+json(x))+"]");
  }
  se(islist(x)) {
    var items=[];
    var i=0;
    enquanto((i<len(x))) {
      push(items,om_mod_30_canonical((x)[i]));
      i=(i+1);
    }
    retornar (("[\"a\",["+join(items,","))+"]]");
  }
  var names=keys(x);
  var i=1;
  enquanto((i<len(names))) {
    var j=i;
    enquanto(((j>0)&&((names)[j]<(names)[(j-1)]))) {
      var tmp=(names)[j];
      put(names,j,(names)[(j-1)]);
      put(names,(j-1),tmp);
      j=(j-1);
    }
    i=(i+1);
  }
  var items=[];
  i=0;
  enquanto((i<len(names))) {
    var key=(names)[i];
    push(items,(((("["+json(key))+",")+om_mod_30_canonical((x)[key]))+"]"));
    i=(i+1);
  }
  retornar (("[\"o\",["+join(items,","))+"]]");
}
