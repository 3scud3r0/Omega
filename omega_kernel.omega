#|}
#|funcao execute(r) {
#|  var count=u::count(r,"actors",1,256); var arena=u::count(r,"arena_bytes",4096,524288);
#|  var memory=u::count(r,"memory_bytes",4096,2147483648); var registers=u::count(r,"registers",1,16);
