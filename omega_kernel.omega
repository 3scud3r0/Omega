}
funcao om_mod_29_trig_interval(x,bits) {
  om_mod_29_precision(bits);
  se((om_mod_29_abs(x)>32)) {
    fail("Trigonometric domain is [-32,32]");
  }
  var shifts=(bits+14);
  var divisor=om_mod_29_pow_int(2,shifts);
  var u=(x/divisor);
  var scale=om_mod_29_pow_int(2,((bits+(2*shifts))+32));
  var error=((om_mod_29_pow_int(om_mod_29_abs(u),4)*5)/96);
  var s=om_mod_29_rounded(((u-(((u*u)*u)/6))-error),((u-(((u*u)*u)/6))+error),scale);
  var c=om_mod_29_rounded(((1-((u*u)/2))-error),((1-((u*u)/2))+error),scale);
  var i=0;
  enquanto((i<shifts)) {
    var product=om_mod_29_times(s,c);
    var ss=om_mod_29_times(s,s);
    var cc=om_mod_29_times(c,c);
    s=om_mod_29_rounded(om_mod_29_max((-1),(2*(product)[0])),om_mod_29_min(1,(2*(product)[1])),scale);
    c=om_mod_29_rounded(om_mod_29_max((-1),((cc)[0]-(ss)[1])),om_mod_29_min(1,((cc)[1]-(ss)[0])),scale);
    i=(i+1);
  }
  var output=obj();
  put(output,"sin",s);
  put(output,"cos",c);
  put(output,"small_angle",u);
  put(output,"doublings",shifts);
  retornar output;
}
