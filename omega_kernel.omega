funcao om_mod_4_block(s,arch,body,env,slots) {
  var i=0;
  enquanto((i<len(body))) {
    var statement=(body)[i];
    se(((statement)[0]=="let")) {
      var slot=om_mod_4_expression(s,arch,(statement)[2],env,slots);
      put(env,(statement)[1],slot);
    }
    se(((statement)[0]=="return")) {
      var slot=om_mod_4_expression(s,arch,(statement)[1],env,slots);
      om_mod_4_load(s,arch,om_mod_4_result_register(arch),slot);
      om_mod_4_jump(s,arch,"success");
    }
    se(((statement)[0]=="if")) {
      var slot=om_mod_4_expression(s,arch,(statement)[1],env,slots);
      om_mod_4_load(s,arch,om_mod_4_result_register(arch),slot);
