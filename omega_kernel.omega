# OMEGA-KERNEL-FILE "ciencia/core/intervalos.omega"
#|modulo science_intervals;
#|importar "../../std/math.omega" como m;
#|exportar box, point, add, sub, mul, div, scale, square, sqrt, exp, log, midpoint, encloses, intersect;
#|funcao box(lo,hi)  {
#|  se(lo>hi)  {
#|    fail("Empty interval");
#|  }
#|  retornar [lo,hi];
#|}
#|funcao point(x)  {
#|  retornar [x,x];
#|}
#|funcao add(a,b)  {
#|  retornar [a[0]+b[0],a[1]+b[1]];
#|}
#|funcao sub(a,b)  {
#|  retornar [a[0]-b[1],a[1]-b[0]];
