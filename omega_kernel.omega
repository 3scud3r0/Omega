#|    }
#|    se(p!=k)  {
#|      var row=a[p];
#|      put(a,p,a[k]);
#|      put(a,k,row);
#|      sign=-sign;
#|    }
#|    var pivot=a[k][k];
#|    var i=k+1;
#|    enquanto(i<n)  {
#|      var j=k+1;
#|      enquanto(j<n)  {
#|        put(a[i],j,check((pivot*a[i][j]-a[i][k]*a[k][j])/previous));
#|        j=j+1;
#|      }
#|      put(a[i],k,0);
#|      i=i+1;
#|    }
#|    previous=pivot;
#|    k=k+1;
#|  }
#|  retornar sign*a[n-1][n-1];
