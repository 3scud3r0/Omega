#|  put(out,"fast_reconstruction_matrix",transfer); put(out,"fast_reconstruction_offset",offset);
#|  put(out,"reconstruction_sign",-1); put(out,"marginal_normalization_included",0);
#|  se(has(r,"slow_state")) {
#|    var x=u::vector(r["slow_state"]); se(len(x)!=slow) { fail("Slow probe dimension"); }
#|    var fast=u::scale(u::add(a::apply(transfer,x),offset),-1);
#|    var full=slice(x,0,len(x)); i=0;
