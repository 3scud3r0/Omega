#|importar "../std/math.omega" como m;
#|importar "../omega_core/algebra.omega" como a;
#|exportar execute;
#|
#|# Finite FIFO key/value memory plus a linear state-space recurrence.
#|# Associative softmax weights are enclosed rationally, never called exact floats.
#|funcao retrieve(keys,values,query,beta,bits) {
#|  var scores=[]; var maximum=beta*u::dot(keys[0],query); var minimum=maximum; var i=0;
