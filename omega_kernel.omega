funcao om_mod_13_poly_clean(p) {
  var out=[];
  var i=0;
  enquanto((i<len(p))) {
    se((((p)[i])[0]!=0)) {
      push(out,(p)[i]);
    }
    i=(i+1);
  }
  i=1;
  enquanto((i<len(out))) {
    var j=i;
    enquanto((j>0)) {
      var k=0;
      enquanto(((k<len(((out)[j])[1]))&&((((out)[j])[1])[k]==(((out)[(j-1)])[1])[k]))) {
        k=(k+1);
      }
      se(((k==len(((out)[j])[1]))||((((out)[j])[1])[k]>=(((out)[(j-1)])[1])[k]))) {
        j=0;
      }
      senao {
        var t=(out)[j];
