#|  put(out,"squared_norm",squared_norm(cores)); put(out,"SVD_optimality_claimed",0); retornar out;
#|}
#|funcao execute(r) {
#|  var mode=u::text_field(r,"mode",24);
#|  se(mode=="compress") { retornar compress(r); }
#|  se(mode=="contract") {
