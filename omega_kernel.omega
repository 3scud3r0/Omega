funcao om_mod_29_exp_interval(x,bits) {
  var scale=om_mod_29_precision(bits);
  se((om_mod_29_abs(x)>32)) {
    fail("Exponential domain is [-32,32]");
  }
  se((x==0)) {
    retornar [1,1];
  }
  var u=om_mod_29_abs(x);
  var shifts=0;
  enquanto((u>1)) {
    u=(u/2);
    shifts=(shifts+1);
  }
  scale=om_mod_29_pow_int(2,((bits+(2*om_mod_29_ceil_q(om_mod_29_abs(x))))+24));
  var n=((bits+(2*om_mod_29_ceil_q(om_mod_29_abs(x))))+32);
  var sum=0;
  var term=1;
  var fact=1;
  var i=0;
  enquanto((i<n)) {
    sum=(sum+term);
    i=(i+1);
    term=((term*u)/i);
    fact=(fact*i);
  }
  var error=((n+1)/(fact*n));
  var interval=om_mod_29_rounded((sum-error),(sum+error),scale);
  i=0;
  enquanto((i<shifts)) {
    interval=om_mod_29_rounded(((interval)[0]*(interval)[0]),((interval)[1]*(interval)[1]),scale);
    i=(i+1);
  }
  se((x<0)) {
    se(((interval)[0]<=0)) {
      fail("Unproved positive exponential");
    }
    interval=om_mod_29_rounded((1/(interval)[1]),(1/(interval)[0]),scale);
  }
  retornar interval;
}
