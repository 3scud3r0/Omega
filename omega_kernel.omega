funcao om_mod_0_rref(raw) {
  var a=om_mod_0_copy(raw);
  var row=0;
  var col=0;
  var pivots=[];
  enquanto(((row<len(a))&&(col<len((a)[0])))) {
    var p=row;
    enquanto(((p<len(a))&&(((a)[p])[col]==0))) {
      p=(p+1);
    }
    se((p<len(a))) {
      var t=(a)[row];
      put(a,row,(a)[p]);
      put(a,p,t);
      var d=((a)[row])[col];
      var j=0;
      enquanto((j<len((a)[0]))) {
        put((a)[row],j,om_mod_0_check((((a)[row])[j]/d)));
        j=(j+1);
      }
      var i=0;
      enquanto((i<len(a))) {
        se((i!=row)) {
          var f=((a)[i])[col];
          j=0;
          enquanto((j<len((a)[0]))) {
            put((a)[i],j,om_mod_0_check((((a)[i])[j]-(f*((a)[row])[j]))));
            j=(j+1);
          }
        }
        i=(i+1);
      }
      push(pivots,col);
      row=(row+1);
    }
    col=(col+1);
  }
  var out=obj();
  put(out,"matrix",a);
  put(out,"pivots",pivots);
  put(out,"rank",row);
  retornar out;
}
