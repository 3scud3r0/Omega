#|funcao intersect(a,b)  {
#|  retornar box(m::max(a[0],b[0]),m::min(a[1],b[1]));
#|}
# OMEGA-KERNEL-FILE-END
# OMEGA-KERNEL-FILE "kernel/README.md"
#|# Ômega Kernel — três candidatos nativos em uma distribuição
#|
#|`omega_kernel.omega` é uma amalgamação determinística. O prefixo é um programa
#|Ômega executável e contém a resolução dos módulos importados. As seções C e
#|Python seguintes ficam em comentários `#|`, com nomes, tamanhos e SHA-256 no
#|manifesto. O extrator recupera os bytes sem executá-los. Os módulos canônicos
#|continuam disponíveis para revisão em `kernel/` e `omega_kernel/`.
#|
#|O arquivo inclui dependências reais do projeto e seus 16 motores anteriores,
#|acessíveis pela operação `engine`. A contagem do manifesto distingue código
#|dos novos componentes, dependências reutilizadas e a duplicação necessária
#|entre o prefixo ligado e os módulos originais. Quantidade de linhas não é
#|evidência de correção ou de capacidade científica.
#|
#|## 1. Kernel lógico embutido
#|
#|`kernel/native/logic.h` implementa um subconjunto predicativo e intensional de
#|teoria de tipos dependentes, com índices de De Bruijn, universos estratificados,
#|Pi, lambda, aplicação, let, Sigma, projeções, identidade, reflexividade,
#|transporte, naturais com recursor, Unit, Empty e racionais limitados. A igualdade
#|definicional usa beta/delta/zeta/iota, projeções e cálculo racional exato.
#|Uma definição só entra no ambiente depois de seu tipo e corpo serem checados.
#|Não há declaração de axiomas, definições opacas ou recursão geral.
#|
#|O verificador exige tipo esperado explícito; não aceita simplesmente qualquer
#|prova válida. O protocolo não aceita arestas futuras, constantes ainda não
#|checadas, campos desconhecidos ou declarações de axiomas. Não existe cache de
#|inferência que ignore o contexto. `kernel/omega/proof.omega` é uma implementação
#|independente da mesma linguagem, compilada pelo Ômega para comparação.
#|
#|O núcleo C recebe arenas do chamador e não usa malloc, GMP, OpenSSL, Lean ou
#|chamadas ao sistema. O adaptador JSON/stdio usa a libc. O limite padrão é de
#|4.096 nós recebidos, arena de 16.384 nós, 1.000.000 passos e profundidade 128;
#|os tetos configuráveis permanecem finitos. Racionais usam numerador de magnitude
#|até INT64_MAX e denominador positivo até INT64_MAX. Exaustão retorna
#|`resource-limit`, sem afirmar que uma proposição é falsa ou verdadeira.
#|
#|**Não é um importador de provas Lean/Coq, nem um CIC completo.** Não implementa
#|indutivos arbitrários, coindução, metavariáveis de universo, unificação, táticas,
#|eta, irrelevância de provas ou cumulatividade. A correção global deste novo
#|verificador ainda não foi formalmente demonstrada. Ele amplia a base confiável
#|e não substitui a política existente de aceitação Lean do restante do projeto.
#|
#|## 2. Tensores racionais
#|
#|`tensor.h` fornece batches SoA em arenas do chamador. AVX2, AVX-512 e NEON
#|calculam produtos intermediários elegíveis, com seleção por CPU e fallback
#|escalar exato; redução por MDC e estados de erro são explícitos por lane.
#|Não há truncamento, saturação nem promoção de overflow a resultado válido.
#|
#|`tensor_gmp.h` representa matrizes como uma grade de inteiros GMP e um
#|denominador comum. O GEMM usa blocos e normaliza uma vez por matriz de saída.
#|Entradas compactas ativam dot products SIMD int16 com acumulador int64 e
#|limites prévios; demais entradas usam `mpz_addmul`. O caminho geral continua
#|dependendo da GMP e pode alocar memória. Os limites de bits e reservas lógicas
#|complementam os limites de RAM/tempo impostos pelo supervisor do processo;
#|a reserva lógica não mede toda a memória interna da GMP.
#|
#|O grafo tem até 64 nós e 16.384 células de valores intermediários. Suporta
#|add/sub, Hadamard, matmul, transpose, ReLU, sum e sum-squares; o reverse mode
#|acumula arestas repetidas e usa subgradiente zero na origem da ReLU. Essas
#|operações são testáveis diferencialmente; sua implementação completa não possui
#|um teorema universal de refinamento para C.
#|
#|Certificados de cálculos matriciais pequenos recompõem as expressões e provam
#|igualdades particulares no kernel, com até 32 células de saída e racionais
#|dentro do domínio finito. Alterar o cálculo, a saída ou trocar o certificado por
#|uma proposição irrelevante impede a aceitação. Isso não prova uma lei física,
#|nem transforma dados experimentais em fatos deduzidos da lógica.
#|
#|## 3. Emissão direta de código de máquina
#|
#|Os módulos `source.omega`, `assembler.omega`, `x86_64.omega`, `aarch64.omega`,
#|`riscv64.omega` e `elf.omega` compilam uma função pura Ômega para ELF64 Linux.
#|Instruções, fixups e cabeçalhos são emitidos diretamente em Ômega, sem chamar
#|GCC, assembler ou linker para o programa resultante. O bootstrap das ferramentas
#|e o caminho de tensores ainda precisam do compilador C.
#|
#|O subconjunto tem parâmetros i64, constantes, variáveis locais imutáveis,
#|operações aritméticas, comparações, curto-circuito e árvores terminais se/senao.
#|Não suporta toda a linguagem Ômega, chamadas, loops, heap, strings ou tensores.
#|Overflow é erro; divisão só aceita quociente inteiro. Resto segue truncamento
#|em direção a zero; INT64_MIN/-1 é erro tanto em divisão como em resto.
#|
#|O ELF tem segmentos RX e RW separados, pilha não executável e nenhuma libc ou
#|interpretador dinâmico. Lê exatamente N inteiros little-endian de um arquivo
#|somente leitura indicado em argv[1], rejeitando dados faltantes ou excedentes.
#|Escreve 18 bytes: dígito de status, 16 hexadecimais maiúsculos do resultado e LF.
#|Status/exit: 0 sucesso, 1 overflow, 2 divisão por zero, 3 erro de IO/protocolo,
#|4 divisão não integral. Erros carregam resultado zero.
#|
#|O validador Python confere cabeçalhos, tamanho e permissões. Não é verificador
#|de instruções. Toda execução continua isolada por namespace, seccomp, mounts
#|explícitos e quotas. A política seccomp atual do projeto é do host x86-64;
#|AArch64/RISC-V podem ser executados nesse host com QEMU explicitamente fornecido.
#|Não se afirma validação em hardware ARM/RISC-V sem evidência própria.
#|
#|## Uso
#|
#|Na instalação do repositório, com GMP de desenvolvimento, compilador C e
#|Bubblewrap configurados:
#|
#|```sh
#|python -m omega_kernel build logic
#|python -m omega_kernel build tensor
#|python -m omega_kernel build workbench
#|python -m omega_kernel request verify proof.json
#|python -m omega_kernel request verify-omega proof.json
#|python -m omega_kernel request tensor tensor.json
#|python -m omega_kernel request graph graph.json
#|python -m omega_kernel certify-tensor tensor.json --output certificate.json
#|python -m omega_kernel verify-tensor certificate.json
#|python -m omega_kernel compile function.omega --architecture x86_64 --output program
#|python -m omega_kernel run function.omega 3 7
#|python -m omega_kernel inspect omega_kernel.omega
#|python -m omega_kernel extract omega_kernel.omega /tmp/omega-kernel-sources
#|```
#|
#|Também disponível por `omega kernel ...`. A extração é distribuição de fontes;
#|o adaptador Python usa os pacotes de infraestrutura da instalação do Ômega.
#|Para um bootstrap mínimo das fontes extraídas, `omega_selfhost/bootstrap.py`
#|pode compilar `omega_kernel_linked.omega` para C; compile esse C com o runtime
#|extraído e GMP/OpenSSL, e execute o resultado apenas no sandbox.
#|
#|Exemplo `tensor.json`:
#|
#|```json
#|{"operation":"gemm","a":{"rows":1,"columns":2,"values":["1/3","2/7"]},"b":{"rows":2,"columns":1,"values":[3,7]}}
#|```
#|
#|Exemplo `function.omega`:
#|
#|```text
#|funcao square_difference(a,b) {
#|  var sum=a+b;
#|  retornar sum*(a-b);
#|}
#|```
#|
#|## Manutenção e validação
#|
#|```sh
#|python -m omega_kernel.amalgamation --generate
#|python -m omega_kernel.amalgamation --check
#|python -m pytest testes/kernel -v
#|```
#|
#|Testes incluem comparação entre os verificadores C/Ômega, rejeição de provas
#|forjadas e escopo incorreto, limites, tensores contra referência exata,
#|gradientes, integridade de certificados, três ISAs, cabeçalhos adulterados,
#|fuzzing determinístico e ASan/UBSan. QEMU ausente é registrado como pendência,
#|não como sucesso. Benchmarks devem informar dimensões, CPU, backend, custo de
#|normalização e todas as dependências. Nenhum ganho de 50–100x ou tempo em
#|nanossegundos é prometido.
#|
#|Os resultados efetivamente executados ficam em `kernel/VALIDACAO.md`; antes
#|da execução a presença dos testes não é evidência de aprovação. Racionais exatos
#|eliminam arredondamento no domínio representado; não eliminam erro de modelo,
#|discretização, incerteza empírica ou oscilação de energia de Verlet.
# OMEGA-KERNEL-FILE-END
# OMEGA-KERNEL-FILE "kernel/native/json.h"
#|#ifndef OMEGA_KERNEL_JSON_H
#|#define OMEGA_KERNEL_JSON_H
#|
#|/* Bounded, allocation-free JSON tokenizer. Exact protocol numbers are decimal
#| * integers; strings used as keys/tags are unescaped ASCII by protocol design.
#| * Duplicate object keys are rejected at parse time, not overwritten later.
#| */
#|#include <stddef.h>
#|#include <stdint.h>
#|#include <limits.h>
#|
#|enum {
#|    OKJ_OBJECT,
#|    OKJ_ARRAY,
#|    OKJ_STRING,
#|    OKJ_INTEGER,
#|    OKJ_TRUE,
#|    OKJ_FALSE,
#|    OKJ_NULL
#|};
#|
#|typedef struct {
#|    uint32_t begin;
#|    uint32_t end;
#|    uint32_t next;
#|    uint32_t count;
#|    uint8_t tag;
#|} okj_token;
#|
#|typedef struct {
#|    const unsigned char *text;
#|    size_t length;
#|    size_t position;
#|    okj_token *tokens;
#|    size_t capacity;
#|    size_t count;
#|    unsigned depth_limit;
#|    int error;
#|} okj_parser;
#|
#|static inline int okj_space(unsigned char c)
#|{
#|    return c == ' ' || c == '\t' || c == '\n' || c == '\r';
#|}
#|
#|static inline void okj_skip(okj_parser *p)
#|{
#|    while (p->position < p->length && okj_space(p->text[p->position])) {
#|        p->position++;
#|    }
#|}
#|
#|static inline uint32_t okj_bad(okj_parser *p)
#|{
#|    p->error = 1;
#|    return UINT32_MAX;
#|}
#|
#|static inline uint32_t okj_allocate(okj_parser *p, unsigned tag, size_t begin)
#|{
#|    if (p->count >= p->capacity || begin > UINT32_MAX) {
#|        return okj_bad(p);
#|    }
#|    uint32_t id = (uint32_t)p->count++;
#|    p->tokens[id].begin = (uint32_t)begin;
#|    p->tokens[id].end = (uint32_t)begin;
#|    p->tokens[id].next = id + 1;
#|    p->tokens[id].count = 0;
#|    p->tokens[id].tag = (uint8_t)tag;
#|    return id;
#|}
#|
#|static inline int okj_equal_tokens(const okj_parser *p, uint32_t a, uint32_t b)
#|{
#|    if (a >= p->count || b >= p->count) {
#|        return 0;
#|    }
#|    const okj_token *x = &p->tokens[a];
#|    const okj_token *y = &p->tokens[b];
#|    if (x->tag != y->tag || x->end - x->begin != y->end - y->begin) {
#|        return 0;
#|    }
#|    for (uint32_t i = 0; i < x->end - x->begin; ++i) {
#|        if (p->text[x->begin + i] != p->text[y->begin + i]) {
#|            return 0;
#|        }
#|    }
#|    return 1;
#|}
#|
#|static inline int okj_name(const okj_parser *p, uint32_t id, const char *name)
#|{
#|    if (id >= p->count || p->tokens[id].tag != OKJ_STRING) {
#|        return 0;
#|    }
#|    const okj_token *t = &p->tokens[id];
#|    size_t i = 0;
#|    while (name[i]) {
#|        if (t->begin + i >= t->end || p->text[t->begin + i] != (unsigned char)name[i]) {
#|            return 0;
#|        }
#|        i++;
#|    }
#|    return t->begin + i == t->end;
#|}
#|
#|static uint32_t okj_value(okj_parser *, unsigned);
#|
#|static uint32_t okj_string(okj_parser *p)
#|{
#|    if (p->position >= p->length || p->text[p->position++] != '"') {
#|        return okj_bad(p);
#|    }
#|    size_t begin = p->position;
#|    while (p->position < p->length && p->text[p->position] != '"') {
#|        unsigned char c = p->text[p->position++];
#|        /* Protocol strings are deliberately canonical ASCII. */
#|        if (c < 32 || c > 126 || c == '\\') {
#|            return okj_bad(p);
#|        }
#|    }
#|    if (p->position == p->length) {
#|        return okj_bad(p);
#|    }
#|    uint32_t id = okj_allocate(p, OKJ_STRING, begin);
#|    if (id == UINT32_MAX) {
#|        return id;
#|    }
#|    p->tokens[id].end = (uint32_t)p->position++;
#|    return id;
#|}
#|
#|static uint32_t okj_integer_token(okj_parser *p)
#|{
#|    size_t begin = p->position;
#|    if (p->text[p->position] == '-') {
#|        p->position++;
#|    }
#|    if (p->position >= p->length || p->text[p->position] < '0' ||
#|        p->text[p->position] > '9') {
#|        return okj_bad(p);
#|    }
#|    if (p->text[p->position] == '0') {
#|        p->position++;
#|        if (p->position < p->length && p->text[p->position] >= '0' && p->text[p->position] <= '9') {
#|            return okj_bad(p);
#|        }
#|    } else {
#|        while (p->position < p->length && p->text[p->position] >= '0' && p->text[p->position] <= '9') {
#|            p->position++;
#|        }
#|    }
#|    if (p->position - begin > 21) {
#|        return okj_bad(p);
#|    }
#|    if (p->position < p->length && (p->text[p->position] == '.' ||
#|        p->text[p->position] == 'e' || p->text[p->position] == 'E')) {
#|        return okj_bad(p);
#|    }
#|    uint32_t id = okj_allocate(p, OKJ_INTEGER, begin);
#|    if (id != UINT32_MAX) {
#|        p->tokens[id].end = (uint32_t)p->position;
#|    }
#|    return id;
#|}
#|
#|static inline int okj_literal(okj_parser *p, const char *literal)
#|{
#|    size_t start = p->position;
#|    size_t i = 0;
#|    while (literal[i]) {
#|        if (start + i >= p->length || p->text[start + i] != (unsigned char)literal[i]) {
#|            return 0;
#|        }
#|        i++;
#|    }
#|    p->position += i;
#|    return 1;
#|}
#|
#|static uint32_t okj_value(okj_parser *p, unsigned depth)
#|{
#|    okj_skip(p);
#|    if (p->error || p->position >= p->length || depth > p->depth_limit) {
#|        return okj_bad(p);
#|    }
#|    unsigned char c = p->text[p->position];
#|    if (c == '"') {
#|        return okj_string(p);
#|    }
#|    if (c == '-' || (c >= '0' && c <= '9')) {
#|        return okj_integer_token(p);
#|    }
#|    if (c == '[' || c == '{') {
#|        int object = c == '{';
#|        uint32_t id = okj_allocate(p, object ? OKJ_OBJECT : OKJ_ARRAY, p->position++);
#|        if (id == UINT32_MAX) {
#|            return id;
#|        }
#|        okj_skip(p);
#|        unsigned char end = object ? '}' : ']';
#|        if (p->position < p->length && p->text[p->position] == end) {
#|            p->position++;
#|            p->tokens[id].end = (uint32_t)p->position;
#|            p->tokens[id].next = (uint32_t)p->count;
#|            return id;
#|        }
#|        for (;;) {
#|            if (object) {
#|                uint32_t key = okj_string(p);
#|                if (key == UINT32_MAX) {
#|                    return key;
#|                }
#|                uint32_t previous = id + 1;
#|                while (previous < key) {
#|                    if (okj_equal_tokens(p, previous, key)) {
#|                        return okj_bad(p);
#|                    }
#|                    uint32_t value = previous + 1;
#|                    if (value >= p->count || p->tokens[value].next <= previous) {
#|                        return okj_bad(p);
#|                    }
#|                    previous = p->tokens[value].next;
#|                }
#|                okj_skip(p);
#|                if (p->position >= p->length || p->text[p->position++] != ':') {
#|                    return okj_bad(p);
#|                }
#|            }
#|            if (okj_value(p, depth + 1) == UINT32_MAX) {
#|                return UINT32_MAX;
#|            }
#|            p->tokens[id].count++;
#|            okj_skip(p);
#|            if (p->position >= p->length) {
#|                return okj_bad(p);
#|            }
#|            c = p->text[p->position++];
#|            if (c == end) {
#|                break;
#|            }
#|            if (c != ',') {
#|                return okj_bad(p);
#|            }
#|            okj_skip(p);
#|        }
#|        p->tokens[id].end = (uint32_t)p->position;
#|        p->tokens[id].next = (uint32_t)p->count;
#|        return id;
#|    }
#|    size_t begin = p->position;
#|    unsigned tag;
#|    if (okj_literal(p, "true")) {
#|        tag = OKJ_TRUE;
#|    } else if (okj_literal(p, "false")) {
#|        tag = OKJ_FALSE;
#|    } else if (okj_literal(p, "null")) {
#|        tag = OKJ_NULL;
#|    } else {
#|        return okj_bad(p);
#|    }
#|    uint32_t id = okj_allocate(p, tag, begin);
#|    if (id != UINT32_MAX) {
#|        p->tokens[id].end = (uint32_t)p->position;
#|    }
#|    return id;
#|}
#|
#|static inline int okj_parse(okj_parser *p, const unsigned char *text, size_t length,
#|                           okj_token *arena, size_t capacity)
#|{
#|    if (!p || !text || !arena || length > 4u * 1024u * 1024u || capacity < 8) {
#|        return 0;
#|    }
#|    p->text = text;
#|    p->length = length;
#|    p->position = 0;
#|    p->tokens = arena;
#|    p->capacity = capacity;
#|    p->count = 0;
#|    p->depth_limit = 32;
#|    p->error = 0;
#|    if (okj_value(p, 0) != 0) {
#|        return 0;
#|    }
#|    okj_skip(p);
#|    return !p->error && p->position == length;
#|}
#|
#|static inline uint32_t okj_field(const okj_parser *p, uint32_t object, const char *key)
#|{
#|    if (object >= p->count || p->tokens[object].tag != OKJ_OBJECT) {
#|        return UINT32_MAX;
#|    }
#|    uint32_t cursor = object + 1;
#|    while (cursor < p->tokens[object].next) {
#|        uint32_t value = cursor + 1;
#|        if (value >= p->count) {
#|            return UINT32_MAX;
#|        }
#|        if (okj_name(p, cursor, key)) {
#|            return value;
#|        }
#|        cursor = p->tokens[value].next;
#|    }
#|    return UINT32_MAX;
#|}
#|
#|static inline uint32_t okj_element(const okj_parser *p, uint32_t array, size_t index)
#|{
#|    if (array >= p->count || p->tokens[array].tag != OKJ_ARRAY || index >= p->tokens[array].count) {
#|        return UINT32_MAX;
#|    }
#|    uint32_t cursor = array + 1;
#|    for (size_t i = 0; i < index; ++i) {
#|        if (cursor >= p->count) {
#|            return UINT32_MAX;
#|        }
#|        cursor = p->tokens[cursor].next;
#|    }
#|    return cursor < p->count ? cursor : UINT32_MAX;
#|}
#|
#|static inline int okj_i64(const okj_parser *p, uint32_t id, int64_t *out)
#|{
#|    if (id >= p->count || p->tokens[id].tag != OKJ_INTEGER || !out) {
#|        return 0;
#|    }
#|    size_t i = p->tokens[id].begin;
#|    size_t end = p->tokens[id].end;
#|    int negative = p->text[i] == '-';
#|    if (negative) {
#|        i++;
#|    }
#|    uint64_t value = 0;
#|    uint64_t limit = negative ? (uint64_t)INT64_MAX + 1 : INT64_MAX;
#|    for (; i < end; ++i) {
#|        unsigned digit = p->text[i] - '0';
#|        if (digit > 9 || value > (limit - digit) / 10) {
#|            return 0;
#|        }
#|        value = value * 10 + digit;
#|    }
#|    *out = negative ? -(int64_t)(value - (value != 0)) - (value != 0) : (int64_t)value;
#|    return 1;
#|}
#|
#|static inline int okj_range(const okj_parser *p, uint32_t id, int64_t low,
#|                           int64_t high, int64_t *out)
#|{
#|    return okj_i64(p, id, out) && *out >= low && *out <= high;
#|}
#|
#|static inline int okj_fields(const okj_parser *p, uint32_t object,
#|                             const char *const *allowed, size_t n)
#|{
#|    if (object >= p->count || p->tokens[object].tag != OKJ_OBJECT) {
#|        return 0;
#|    }
#|    uint32_t cursor = object + 1;
#|    while (cursor < p->tokens[object].next) {
#|        int known = 0;
#|        for (size_t i = 0; i < n; ++i) {
#|            known |= okj_name(p, cursor, allowed[i]);
#|        }
#|        if (!known || cursor + 1 >= p->count) {
#|            return 0;
#|        }
#|        cursor = p->tokens[cursor + 1].next;
#|    }
#|    return 1;
#|}
#|
#|#endif
# OMEGA-KERNEL-FILE-END
# OMEGA-KERNEL-FILE "kernel/native/logic.h"
#|#ifndef OMEGA_EMBEDDED_LOGIC_H
#|#define OMEGA_EMBEDDED_LOGIC_H
#|
#|/* Predicative intensional dependent type checker, not a Lean/Coq importer.
#| * No axioms, unification, tactics, general recursion, proof irrelevance or eta.
#| * The caller owns all arenas. Exhaustion is UNKNOWN, never successful checking.
#| * Conversion: beta, delta, zeta, projections, Nat recursion and bounded exact Q.
#| */
#|#include <stddef.h>
#|#include <stdint.h>
#|#include <limits.h>
#|#include "../../omega_selfhost/bounded_rational.h"
#|
#|#define OK_NONE UINT32_MAX
#|#define OK_CONTEXT_MAX 256u
#|#define OK_DEFINITIONS_MAX 256u
#|#define OK_LEVEL_MAX 31u
#|
#|typedef enum {
#|    OK_SORT,
#|    OK_VAR,
#|    OK_PI,
#|    OK_LAMBDA,
#|    OK_APP,
#|    OK_LET,
#|    OK_ANNOTATION,
#|    OK_SIGMA,
#|    OK_PAIR,
#|    OK_FIRST,
#|    OK_SECOND,
#|    OK_NAT,
#|    OK_ZERO,
#|    OK_SUCCESSOR,
#|    OK_NAT_LITERAL,
#|    OK_NAT_ADD,
#|    OK_NAT_MUL,
#|    OK_NAT_REC,
#|    OK_EQUALITY,
#|    OK_REFL,
#|    OK_TRANSPORT,
#|    OK_UNIT,
#|    OK_UNIT_VALUE,
#|    OK_EMPTY,
#|    OK_ABSURD,
#|    OK_CONSTANT,
#|    OK_RAT,
#|    OK_RAT_LITERAL,
#|    OK_RAT_ADD,
#|    OK_RAT_MUL,
#|    OK_RAT_NEG,
#|    OK_TAG_COUNT
#|} ok_tag;
#|
#|typedef enum {
#|    OK_SUCCESS,
#|    OK_BAD_NODE,
#|    OK_BAD_SCOPE,
#|    OK_TYPE_MISMATCH,
#|    OK_NOT_A_TYPE,
#|    OK_NOT_A_FUNCTION,
#|    OK_NOT_A_PAIR,
#|    OK_BAD_CONSTANT,
#|    OK_ARENA_LIMIT,
#|    OK_FUEL_LIMIT,
#|    OK_DEPTH_LIMIT,
#|    OK_CONTEXT_LIMIT,
#|    OK_UNIVERSE_LIMIT,
#|    OK_ARITHMETIC_LIMIT
#|} ok_error;
#|
#|typedef struct {
#|    uint32_t child[4];
#|    int64_t data[2];
#|    uint8_t tag;
#|} ok_term;
#|
#|typedef struct {
#|    uint32_t type;
#|    uint32_t body;
#|} ok_definition;
#|
#|typedef struct {
#|    ok_term *terms;
#|    size_t count;
#|    size_t capacity;
#|    uint64_t fuel;
#|    uint64_t initial_fuel;
#|    uint32_t depth_limit;
#|    uint32_t context[OK_CONTEXT_MAX];
#|    size_t context_size;
#|    ok_definition definitions[OK_DEFINITIONS_MAX];
#|    size_t definition_count;
#|    ok_error error;
#|    uint32_t error_node;
#|    uint32_t peak_depth;
#|} ok_checker;
#|
#|static inline uint32_t ok_fail(ok_checker *s, ok_error error, uint32_t node)
#|{
#|    if (s && s->error == OK_SUCCESS) {
#|        s->error = error;
#|        s->error_node = node;
#|    }
#|    return OK_NONE;
#|}
#|
#|static inline int ok_tick(ok_checker *s, uint32_t node, uint32_t depth)
#|{
#|    if (!s || s->error != OK_SUCCESS) {
#|        return 0;
#|    }
#|    if (depth > s->depth_limit) {
#|        ok_fail(s, OK_DEPTH_LIMIT, node);
#|        return 0;
#|    }
#|    if (depth > s->peak_depth) {
#|        s->peak_depth = depth;
#|    }
#|    if (s->fuel == 0) {
#|        ok_fail(s, OK_FUEL_LIMIT, node);
#|        return 0;
#|    }
#|    s->fuel--;
#|    return 1;
#|}
#|
#|static inline int ok_init(ok_checker *s, ok_term *arena, size_t capacity,
#|                          uint64_t fuel, uint32_t depth)
#|{
#|    if (!s || !arena || capacity < 16 || capacity > 65536 ||
#|        fuel == 0 || fuel > 10000000 || depth < 8 || depth > 256) {
#|        return 0;
#|    }
#|    s->terms = arena;
#|    s->capacity = capacity;
#|    s->count = 0;
#|    s->fuel = fuel;
#|    s->initial_fuel = fuel;
#|    s->depth_limit = depth;
#|    s->context_size = 0;
#|    s->definition_count = 0;
#|    s->error = OK_SUCCESS;
#|    s->error_node = OK_NONE;
#|    s->peak_depth = 0;
#|    return 1;
#|}
#|
#|static inline unsigned ok_arity(unsigned tag)
#|{
#|    switch (tag) {
#|    case OK_PI:
#|    case OK_LAMBDA:
#|    case OK_APP:
#|    case OK_SIGMA:
#|    case OK_ANNOTATION:
#|    case OK_REFL:
#|    case OK_ABSURD:
#|    case OK_NAT_ADD:
#|    case OK_NAT_MUL:
#|    case OK_RAT_ADD:
#|    case OK_RAT_MUL:
#|        return 2;
#|    case OK_LET:
#|    case OK_PAIR:
#|    case OK_EQUALITY:
#|    case OK_TRANSPORT:
#|        return 3;
#|    case OK_FIRST:
#|    case OK_SECOND:
#|    case OK_SUCCESSOR:
#|    case OK_RAT_NEG:
#|        return 1;
#|    case OK_NAT_REC:
#|        return 4;
#|    default:
#|        return 0;
#|    }
#|}
#|
#|static inline unsigned ok_data_arity(unsigned tag)
#|{
#|    if (tag == OK_RAT_LITERAL) {
#|        return 2;
#|    }
#|    if (tag == OK_SORT || tag == OK_VAR || tag == OK_CONSTANT ||
#|        tag == OK_NAT_LITERAL) {
#|        return 1;
#|    }
#|    return 0;
#|}
#|
#|static inline const ok_term *ok_get(ok_checker *s, uint32_t id)
#|{
#|    if (!s || id >= s->count) {
#|        ok_fail(s, OK_BAD_NODE, id);
#|        return NULL;
#|    }
#|    return &s->terms[id];
#|}
#|
#|static inline uint32_t ok_new(ok_checker *s, unsigned tag,
#|                            uint32_t a, uint32_t b, uint32_t c, uint32_t d,
#|                            int64_t x, int64_t y)
#|{
#|    if (!s || s->error != OK_SUCCESS || tag >= OK_TAG_COUNT) {
#|        return ok_fail(s, OK_BAD_NODE, OK_NONE);
#|    }
#|    if (s->count >= s->capacity) {
#|        return ok_fail(s, OK_ARENA_LIMIT, OK_NONE);
#|    }
#|    /* Keep shifts safe even when callers bypass the JSON wire decoder. */
#|    if ((tag == OK_SORT && (x < 0 || x > OK_LEVEL_MAX + 1)) ||
#|        ((tag == OK_VAR || tag == OK_CONSTANT) && (x < 0 || x >= 256)) ||
#|        (tag == OK_NAT_LITERAL && x < 0) ||
#|        (tag == OK_RAT_LITERAL && (x == INT64_MIN || y <= 0))) {
#|        return ok_fail(s, OK_BAD_NODE, OK_NONE);
#|    }
#|    uint32_t children[4] = {a, b, c, d};
#|    for (unsigned i = 0; i < ok_arity(tag); ++i) {
#|        if (children[i] >= s->count) {
#|            return ok_fail(s, OK_BAD_NODE, children[i]);
#|        }
#|    }
#|    uint32_t id = (uint32_t)s->count++;
#|    ok_term *term = &s->terms[id];
#|    term->tag = (uint8_t)tag;
#|    for (unsigned i = 0; i < 4; ++i) {
#|        term->child[i] = children[i];
#|    }
#|    term->data[0] = x;
#|    term->data[1] = y;
#|    return id;
#|}
#|
#|static inline uint32_t ok_atom(ok_checker *s, unsigned tag)
#|{
#|    return ok_new(s, tag, 0, 0, 0, 0, 0, 0);
#|}
#|
#|static inline uint32_t ok_unary(ok_checker *s, unsigned tag, uint32_t a)
#|{
#|    return ok_new(s, tag, a, 0, 0, 0, 0, 0);
#|}
#|
#|static inline uint32_t ok_binary(ok_checker *s, unsigned tag, uint32_t a, uint32_t b)
#|{
#|    return ok_new(s, tag, a, b, 0, 0, 0, 0);
#|}
#|
#|static inline uint32_t ok_sort(ok_checker *s, int64_t level)
#|{
#|    if (level < 0 || level > OK_LEVEL_MAX + 1) {
#|        return ok_fail(s, OK_UNIVERSE_LIMIT, OK_NONE);
#|    }
#|    return ok_new(s, OK_SORT, 0, 0, 0, 0, level, 0);
#|}
#|
#|static inline uint32_t ok_variable(ok_checker *s, int64_t index)
#|{
#|    if (index < 0 || index >= OK_CONTEXT_MAX) {
#|        return ok_fail(s, OK_BAD_SCOPE, OK_NONE);
#|    }
#|    return ok_new(s, OK_VAR, 0, 0, 0, 0, index, 0);
#|}
#|
#|static inline uint32_t ok_nat_literal(ok_checker *s, int64_t n)
#|{
#|    if (n < 0) {
#|        return ok_fail(s, OK_BAD_NODE, OK_NONE);
#|    }
#|    return ok_new(s, OK_NAT_LITERAL, 0, 0, 0, 0, n, 0);
#|}
#|
#|static inline unsigned ok_binder_child(unsigned tag, unsigned child)
#|{
#|    return ((tag == OK_PI || tag == OK_LAMBDA || tag == OK_SIGMA) && child == 1) ||
#|           (tag == OK_LET && child == 2);
#|}
#|
#|static uint32_t ok_shift(ok_checker *, uint32_t, int32_t, uint32_t, uint32_t);
#|static uint32_t ok_substitute(ok_checker *, uint32_t, uint32_t, uint32_t, uint32_t);
#|static uint32_t ok_whnf(ok_checker *, uint32_t, uint32_t);
#|static uint32_t ok_infer(ok_checker *, uint32_t, uint32_t);
#|static int ok_convert(ok_checker *, uint32_t, uint32_t, uint32_t);
#|static int ok_check(ok_checker *, uint32_t, uint32_t, uint32_t);
#|
#|static uint32_t ok_shift(ok_checker *s, uint32_t id, int32_t amount,
#|                         uint32_t cutoff, uint32_t depth)
#|{
#|    if (!ok_tick(s, id, depth)) {
#|        return OK_NONE;
#|    }
#|    const ok_term *source = ok_get(s, id);
#|    if (!source) {
#|        return OK_NONE;
#|    }
#|    ok_term term = *source;
#|    if (term.tag == OK_VAR && term.data[0] >= cutoff) {
#|        int64_t index = term.data[0] + amount;
#|        return ok_variable(s, index);
#|    }
#|    unsigned arity = ok_arity(term.tag);
#|    int changed = 0;
#|    for (unsigned i = 0; i < arity; ++i) {
#|        uint32_t next = ok_shift(s, term.child[i], amount,
#|                                 cutoff + ok_binder_child(term.tag, i), depth + 1);
#|        if (next == OK_NONE) {
#|            return OK_NONE;
#|        }
#|        changed |= next != term.child[i];
#|        term.child[i] = next;
#|    }
#|    if (!changed) {
#|        return id;
#|    }
#|    return ok_new(s, term.tag, term.child[0], term.child[1], term.child[2],
#|                   term.child[3], term.data[0], term.data[1]);
#|}
#|
#|static uint32_t ok_substitute(ok_checker *s, uint32_t id, uint32_t index,
#|                              uint32_t value, uint32_t depth)
#|{
#|    if (!ok_tick(s, id, depth)) {
#|        return OK_NONE;
#|    }
#|    const ok_term *source = ok_get(s, id);
#|    if (!source) {
#|        return OK_NONE;
#|    }
#|    ok_term term = *source;
#|    if (term.tag == OK_VAR && term.data[0] == index) {
#|        return value;
#|    }
#|    unsigned arity = ok_arity(term.tag);
#|    int changed = 0;
#|    for (unsigned i = 0; i < arity; ++i) {
#|        uint32_t replacement = value;
#|        uint32_t binder = ok_binder_child(term.tag, i);
#|        if (binder) {
#|            replacement = ok_shift(s, value, 1, 0, depth + 1);
#|        }
#|        uint32_t next = ok_substitute(s, term.child[i], index + binder,
#|                                      replacement, depth + 1);
#|        if (next == OK_NONE) {
#|            return OK_NONE;
#|        }
#|        changed |= next != term.child[i];
#|        term.child[i] = next;
#|    }
#|    if (!changed) {
#|        return id;
#|    }
#|    return ok_new(s, term.tag, term.child[0], term.child[1], term.child[2],
#|                   term.child[3], term.data[0], term.data[1]);
#|}
#|
#|static inline uint32_t ok_instantiate(ok_checker *s, uint32_t body,
#|                                     uint32_t argument, uint32_t depth)
#|{
#|    uint32_t lifted = ok_shift(s, argument, 1, 0, depth + 1);
#|    uint32_t replaced = ok_substitute(s, body, 0, lifted, depth + 1);
#|    return ok_shift(s, replaced, -1, 0, depth + 1);
#|}
#|
#|static inline int ok_natural_value(ok_checker *s, uint32_t id, int64_t *out)
#|{
#|    const ok_term *term = ok_get(s, id);
#|    if (!term) {
#|        return 0;
#|    }
#|    if (term->tag == OK_ZERO) {
#|        *out = 0;
#|        return 1;
#|    }
#|    if (term->tag == OK_NAT_LITERAL && term->data[0] >= 0) {
#|        *out = term->data[0];
#|        return 1;
#|    }
#|    return 0;
#|}
#|
#|static inline uint32_t ok_q_literal(ok_checker *s, omega_q64 q)
#|{
#|    return ok_new(s, OK_RAT_LITERAL, 0, 0, 0, 0,
#|                   q.numerator, (int64_t)q.denominator);
#|}
#|
#|static uint32_t ok_whnf(ok_checker *s, uint32_t id, uint32_t depth)
#|{
#|    for (;;) {
#|        if (!ok_tick(s, id, depth)) {
#|            return OK_NONE;
#|        }
#|        const ok_term *source = ok_get(s, id);
#|        if (!source) {
#|            return OK_NONE;
#|        }
#|        ok_term term = *source;
#|        if (term.tag == OK_CONSTANT) {
#|            if (term.data[0] < 0 || (uint64_t)term.data[0] >= s->definition_count) {
#|                return ok_fail(s, OK_BAD_CONSTANT, id);
#|            }
#|            id = s->definitions[term.data[0]].body;
#|            continue;
#|        }
#|        if (term.tag == OK_ANNOTATION) {
#|            id = term.child[0];
#|            continue;
#|        }
#|        if (term.tag == OK_LET) {
#|            id = ok_instantiate(s, term.child[2], term.child[1], depth + 1);
#|            continue;
#|        }
#|        if (term.tag == OK_APP) {
#|            uint32_t function = ok_whnf(s, term.child[0], depth + 1);
#|            const ok_term *fn = ok_get(s, function);
#|            if (!fn) {
#|                return OK_NONE;
#|            }
#|            if (fn->tag == OK_LAMBDA) {
#|                id = ok_instantiate(s, fn->child[1], term.child[1], depth + 1);
#|                continue;
#|            }
#|            return function == term.child[0] ? id :
#|                ok_binary(s, OK_APP, function, term.child[1]);
#|        }
#|        if (term.tag == OK_FIRST || term.tag == OK_SECOND) {
#|            uint32_t pair = ok_whnf(s, term.child[0], depth + 1);
#|            const ok_term *p = ok_get(s, pair);
#|            if (!p) {
#|                return OK_NONE;
#|            }
#|            if (p->tag == OK_PAIR) {
#|                id = p->child[term.tag == OK_FIRST ? 1 : 2];
#|                continue;
#|            }
#|            return pair == term.child[0] ? id : ok_unary(s, term.tag, pair);
#|        }
#|        if (term.tag == OK_ZERO) {
#|            return ok_nat_literal(s, 0);
#|        }
#|        if (term.tag == OK_SUCCESSOR) {
#|            uint32_t child = ok_whnf(s, term.child[0], depth + 1);
#|            int64_t value;
#|            if (ok_natural_value(s, child, &value)) {
#|                if (value == INT64_MAX) {
#|                    return ok_fail(s, OK_ARITHMETIC_LIMIT, id);
#|                }
#|                return ok_nat_literal(s, value + 1);
#|            }
#|            return child == term.child[0] ? id : ok_unary(s, OK_SUCCESSOR, child);
#|        }
#|        if (term.tag == OK_NAT_ADD || term.tag == OK_NAT_MUL) {
#|            uint32_t left = ok_whnf(s, term.child[0], depth + 1);
#|            uint32_t right = ok_whnf(s, term.child[1], depth + 1);
#|            int64_t a;
#|            int64_t b;
#|            int left_numeric = ok_natural_value(s, left, &a);
#|            int right_numeric = ok_natural_value(s, right, &b);
#|            if (s->error != OK_SUCCESS) {
#|                return OK_NONE;
#|            }
#|            if (left_numeric && right_numeric) {
#|                __int128 value = term.tag == OK_NAT_ADD ?
#|                    (__int128)a + b : (__int128)a * b;
#|                if (value > INT64_MAX) {
#|                    return ok_fail(s, OK_ARITHMETIC_LIMIT, id);
#|                }
#|                return ok_nat_literal(s, (int64_t)value);
#|            }
#|            if (left_numeric && a == 0) {
#|                return term.tag == OK_NAT_ADD ? right : ok_nat_literal(s, 0);
#|            }
#|            const ok_term *lhs = ok_get(s, left);
#|            uint32_t predecessor = OK_NONE;
#|            if (left_numeric && a > 0) {
#|                predecessor = ok_nat_literal(s, a - 1);
#|            } else if (lhs && lhs->tag == OK_SUCCESSOR) {
#|                predecessor = lhs->child[0];
#|            }
#|            if (predecessor != OK_NONE) {
#|                uint32_t tail = ok_binary(s, term.tag, predecessor, right);
#|                id = term.tag == OK_NAT_ADD ?
#|                    ok_unary(s, OK_SUCCESSOR, tail) :
#|                    ok_binary(s, OK_NAT_ADD, right, tail);
#|                continue;
#|            }
#|            return left == term.child[0] && right == term.child[1] ? id :
#|                ok_binary(s, term.tag, left, right);
#|        }
#|        if (term.tag == OK_NAT_REC) {
#|            uint32_t n = ok_whnf(s, term.child[3], depth + 1);
#|            int64_t value;
#|            uint32_t predecessor = OK_NONE;
#|            if (ok_natural_value(s, n, &value)) {
#|                if (value == 0) {
#|                    id = term.child[1];
#|                    continue;
#|                }
#|                predecessor = ok_nat_literal(s, value - 1);
#|            } else {
#|                const ok_term *natural = ok_get(s, n);
#|                if (natural && natural->tag == OK_SUCCESSOR) {
#|                    predecessor = natural->child[0];
#|                }
#|            }
#|            if (predecessor != OK_NONE) {
#|                uint32_t rec = ok_new(s, OK_NAT_REC, term.child[0], term.child[1],
#|                                      term.child[2], predecessor, 0, 0);
#|                uint32_t applied = ok_binary(s, OK_APP, term.child[2], predecessor);
#|                id = ok_binary(s, OK_APP, applied, rec);
#|                continue;
#|            }
#|            return n == term.child[3] ? id :
#|                ok_new(s, OK_NAT_REC, term.child[0], term.child[1], term.child[2], n, 0, 0);
#|        }
#|        if (term.tag == OK_TRANSPORT) {
#|            uint32_t equality = ok_whnf(s, term.child[1], depth + 1);
#|            const ok_term *proof = ok_get(s, equality);
#|            if (proof && proof->tag == OK_REFL) {
#|                id = term.child[2];
#|                continue;
#|            }
#|            return equality == term.child[1] ? id :
#|                ok_new(s, OK_TRANSPORT, term.child[0], equality, term.child[2], 0, 0, 0);
#|        }
#|        if (term.tag == OK_RAT_LITERAL) {
#|            if (term.data[0] == INT64_MIN || term.data[1] <= 0) {
#|                return ok_fail(s, OK_BAD_NODE, id);
#|            }
#|            omega_q64 q;
#|            if (omega_q64_make(&q, term.data[0], (uint64_t)term.data[1]) != OMEGA_Q_OK) {
#|                return ok_fail(s, OK_ARITHMETIC_LIMIT, id);
#|            }
#|            if (q.numerator == term.data[0] && q.denominator == (uint64_t)term.data[1]) {
#|                return id;
#|            }
#|            return ok_q_literal(s, q);
#|        }
#|        if (term.tag == OK_RAT_ADD || term.tag == OK_RAT_MUL || term.tag == OK_RAT_NEG) {
#|            uint32_t left = ok_whnf(s, term.child[0], depth + 1);
#|            uint32_t right = term.tag == OK_RAT_NEG ? left :
#|                ok_whnf(s, term.child[1], depth + 1);
#|            const ok_term *a = ok_get(s, left);
#|            const ok_term *b = ok_get(s, right);
#|            if (!a || !b) {
#|                return OK_NONE;
#|            }
#|            if (a->tag == OK_RAT_LITERAL && b->tag == OK_RAT_LITERAL) {
#|                omega_q64 x = {a->data[0], (uint64_t)a->data[1]};
#|                omega_q64 y = {b->data[0], (uint64_t)b->data[1]};
#|                omega_q64 q;
#|                int status;
#|                if (term.tag == OK_RAT_NEG) {
#|                    status = omega_q64_make(&q, -(__int128)x.numerator, x.denominator);
#|                } else if (term.tag == OK_RAT_ADD) {
#|                    status = omega_q64_add(&q, x, y);
#|                } else {
#|                    status = omega_q64_mul(&q, x, y);
#|                }
#|                if (status != OMEGA_Q_OK) {
#|                    return ok_fail(s, OK_ARITHMETIC_LIMIT, id);
#|                }
#|                return ok_q_literal(s, q);
#|            }
#|            if (left == term.child[0] && (term.tag == OK_RAT_NEG || right == term.child[1])) {
#|                return id;
#|            }
#|            return term.tag == OK_RAT_NEG ? ok_unary(s, OK_RAT_NEG, left) :
#|                ok_binary(s, term.tag, left, right);
#|        }
#|        return id;
#|    }
#|}
#|
#|static int ok_convert(ok_checker *s, uint32_t left, uint32_t right, uint32_t depth)
#|{
#|    if (!ok_tick(s, left, depth)) {
#|        return 0;
#|    }
#|    if (left == right && left < s->count) {
#|        return 1;
#|    }
#|    left = ok_whnf(s, left, depth + 1);
#|    right = ok_whnf(s, right, depth + 1);
#|    const ok_term *a = ok_get(s, left);
#|    const ok_term *b = ok_get(s, right);
#|    if (!a || !b || s->error != OK_SUCCESS) {
#|        return 0;
#|    }
#|    if (left == right) {
#|        return 1;
#|    }
#|    if (a->tag != b->tag || a->data[0] != b->data[0] || a->data[1] != b->data[1]) {
#|        return 0;
#|    }
#|    ok_term x = *a;
#|    ok_term y = *b;
#|    for (unsigned i = 0; i < ok_arity(x.tag); ++i) {
#|        if (!ok_convert(s, x.child[i], y.child[i], depth + 1)) {
#|            return 0;
#|        }
#|    }
#|    return 1;
#|}
#|
#|static inline int ok_push(ok_checker *s, uint32_t type, uint32_t node)
#|{
#|    if (s->context_size >= OK_CONTEXT_MAX) {
#|        ok_fail(s, OK_CONTEXT_LIMIT, node);
#|        return 0;
#|    }
#|    s->context[s->context_size++] = type;
#|    return 1;
#|}
#|
#|static inline int64_t ok_type_level(ok_checker *s, uint32_t type, uint32_t depth)
#|{
#|    uint32_t inferred = ok_infer(s, type, depth + 1);
#|    uint32_t reduced = ok_whnf(s, inferred, depth + 1);
#|    const ok_term *sort = ok_get(s, reduced);
#|    if (!sort || sort->tag != OK_SORT) {
#|        ok_fail(s, OK_NOT_A_TYPE, type);
#|        return -1;
#|    }
#|    return sort->data[0];
#|}
#|
#|static uint32_t ok_infer(ok_checker *s, uint32_t id, uint32_t depth)
#|{
#|    if (!ok_tick(s, id, depth)) {
#|        return OK_NONE;
#|    }
#|    const ok_term *source = ok_get(s, id);
#|    if (!source) {
#|        return OK_NONE;
#|    }
#|    ok_term term = *source;
#|    switch (term.tag) {
#|    case OK_SORT:
#|        if (term.data[0] < 0 || term.data[0] > OK_LEVEL_MAX) {
#|            return ok_fail(s, OK_UNIVERSE_LIMIT, id);
#|        }
#|        return ok_sort(s, term.data[0] + 1);
#|    case OK_VAR:
#|        if (term.data[0] < 0 || (uint64_t)term.data[0] >= s->context_size) {
#|            return ok_fail(s, OK_BAD_SCOPE, id);
#|        }
#|        return ok_shift(s, s->context[s->context_size - 1 - term.data[0]],
#|                         (int32_t)term.data[0] + 1, 0, depth + 1);
#|    case OK_PI:
#|    case OK_SIGMA: {
#|        int64_t domain_level = ok_type_level(s, term.child[0], depth + 1);
#|        if (domain_level < 0 || !ok_push(s, term.child[0], id)) {
#|            return OK_NONE;
#|        }
#|        int64_t codomain_level = ok_type_level(s, term.child[1], depth + 1);
#|        s->context_size--;
#|        if (codomain_level < 0) {
#|            return OK_NONE;
#|        }
#|        return ok_sort(s, domain_level > codomain_level ? domain_level : codomain_level);
#|    }
#|    case OK_LAMBDA: {
#|        if (ok_type_level(s, term.child[0], depth + 1) < 0 ||
#|            !ok_push(s, term.child[0], id)) {
#|            return OK_NONE;
#|        }
#|        uint32_t body_type = ok_infer(s, term.child[1], depth + 1);
#|        s->context_size--;
#|        return ok_binary(s, OK_PI, term.child[0], body_type);
#|    }
#|    case OK_APP: {
#|        uint32_t function_type = ok_whnf(s, ok_infer(s, term.child[0], depth + 1), depth + 1);
#|        const ok_term *type = ok_get(s, function_type);
#|        if (!type || type->tag != OK_PI) {
#|            return ok_fail(s, OK_NOT_A_FUNCTION, id);
#|        }
#|        uint32_t domain = type->child[0];
#|        uint32_t codomain = type->child[1];
#|        if (!ok_check(s, term.child[1], domain, depth + 1)) {
#|            return OK_NONE;
#|        }
#|        return ok_instantiate(s, codomain, term.child[1], depth + 1);
#|    }
#|    case OK_LET: {
#|        if (ok_type_level(s, term.child[0], depth + 1) < 0 ||
#|            !ok_check(s, term.child[1], term.child[0], depth + 1) ||
#|            !ok_push(s, term.child[0], id)) {
#|            return OK_NONE;
#|        }
#|        uint32_t body_type = ok_infer(s, term.child[2], depth + 1);
#|        s->context_size--;
#|        return ok_instantiate(s, body_type, term.child[1], depth + 1);
#|    }
#|    case OK_ANNOTATION:
#|        if (ok_type_level(s, term.child[1], depth + 1) < 0 ||
#|            !ok_check(s, term.child[0], term.child[1], depth + 1)) {
#|            return OK_NONE;
#|        }
#|        return term.child[1];
#|    case OK_PAIR: {
#|        if (ok_type_level(s, term.child[0], depth + 1) < 0) {
#|            return OK_NONE;
#|        }
#|        uint32_t sigma = ok_whnf(s, term.child[0], depth + 1);
#|        const ok_term *type = ok_get(s, sigma);
#|        if (!type || type->tag != OK_SIGMA) {
#|            return ok_fail(s, OK_NOT_A_PAIR, id);
#|        }
#|        uint32_t domain = type->child[0];
#|        uint32_t codomain = type->child[1];
#|        if (!ok_check(s, term.child[1], domain, depth + 1)) {
#|            return OK_NONE;
#|        }
#|        uint32_t second_type = ok_instantiate(s, codomain, term.child[1], depth + 1);
#|        if (!ok_check(s, term.child[2], second_type, depth + 1)) {
#|            return OK_NONE;
#|        }
#|        return term.child[0];
#|    }
#|    case OK_FIRST:
#|    case OK_SECOND: {
#|        uint32_t sigma = ok_whnf(s, ok_infer(s, term.child[0], depth + 1), depth + 1);
#|        const ok_term *type = ok_get(s, sigma);
#|        if (!type || type->tag != OK_SIGMA) {
#|            return ok_fail(s, OK_NOT_A_PAIR, id);
#|        }
#|        if (term.tag == OK_FIRST) {
#|            return type->child[0];
#|        }
#|        uint32_t codomain = type->child[1];
#|        return ok_instantiate(s, codomain, ok_unary(s, OK_FIRST, term.child[0]), depth + 1);
#|    }
#|    case OK_NAT:
#|    case OK_RAT:
#|    case OK_UNIT:
#|    case OK_EMPTY:
#|        return ok_sort(s, 0);
#|    case OK_UNIT_VALUE:
#|        return ok_atom(s, OK_UNIT);
#|    case OK_ZERO:
#|        return ok_atom(s, OK_NAT);
#|    case OK_NAT_LITERAL:
#|        if (term.data[0] < 0) {
#|            return ok_fail(s, OK_BAD_NODE, id);
#|        }
#|        return ok_atom(s, OK_NAT);
#|    case OK_SUCCESSOR:
#|    case OK_NAT_ADD:
#|    case OK_NAT_MUL: {
#|        uint32_t natural = ok_atom(s, OK_NAT);
#|        for (unsigned i = 0; i < ok_arity(term.tag); ++i) {
#|            if (!ok_check(s, term.child[i], natural, depth + 1)) {
#|                return OK_NONE;
#|            }
#|        }
#|        return natural;
#|    }
#|    case OK_NAT_REC: {
#|        uint32_t motive_type = ok_whnf(s, ok_infer(s, term.child[0], depth + 1), depth + 1);
#|        const ok_term *motive = ok_get(s, motive_type);
#|        if (!motive || motive->tag != OK_PI) {
#|            return ok_fail(s, OK_NOT_A_FUNCTION, id);
#|        }
#|        uint32_t domain = motive->child[0];
#|        uint32_t codomain = motive->child[1];
#|        uint32_t natural = ok_atom(s, OK_NAT);
#|        const ok_term *result_sort = ok_get(s, ok_whnf(s, codomain, depth + 1));
#|        if (!ok_convert(s, domain, natural, depth + 1) ||
#|            !result_sort || result_sort->tag != OK_SORT) {
#|            return ok_fail(s, OK_NOT_A_TYPE, id);
#|        }
#|        uint32_t zero_type = ok_binary(s, OK_APP, term.child[0], ok_nat_literal(s, 0));
#|        if (!ok_check(s, term.child[1], zero_type, depth + 1)) {
#|            return OK_NONE;
#|        }
#|        uint32_t shifted_motive = ok_shift(s, term.child[0], 1, 0, depth + 1);
#|        uint32_t induction_type = ok_binary(s, OK_APP, shifted_motive, ok_variable(s, 0));
#|        uint32_t motive_two = ok_shift(s, term.child[0], 2, 0, depth + 1);
#|        uint32_t successor = ok_unary(s, OK_SUCCESSOR, ok_variable(s, 1));
#|        uint32_t conclusion = ok_binary(s, OK_APP, motive_two, successor);
#|        uint32_t step_type = ok_binary(s, OK_PI, natural,
#|                                      ok_binary(s, OK_PI, induction_type, conclusion));
#|        if (!ok_check(s, term.child[2], step_type, depth + 1) ||
#|            !ok_check(s, term.child[3], natural, depth + 1)) {
#|            return OK_NONE;
#|        }
#|        return ok_binary(s, OK_APP, term.child[0], term.child[3]);
#|    }
#|    case OK_EQUALITY: {
#|        int64_t level = ok_type_level(s, term.child[0], depth + 1);
#|        if (level < 0 || !ok_check(s, term.child[1], term.child[0], depth + 1) ||
#|            !ok_check(s, term.child[2], term.child[0], depth + 1)) {
#|            return OK_NONE;
#|        }
#|        return ok_sort(s, level);
#|    }
#|    case OK_REFL:
#|        if (ok_type_level(s, term.child[0], depth + 1) < 0 ||
#|            !ok_check(s, term.child[1], term.child[0], depth + 1)) {
#|            return OK_NONE;
#|        }
#|        return ok_new(s, OK_EQUALITY, term.child[0], term.child[1], term.child[1], 0, 0, 0);
#|    case OK_TRANSPORT: {
#|        uint32_t equality = ok_whnf(s, ok_infer(s, term.child[1], depth + 1), depth + 1);
#|        const ok_term *eq = ok_get(s, equality);
#|        if (!eq || eq->tag != OK_EQUALITY) {
#|            return ok_fail(s, OK_TYPE_MISMATCH, id);
#|        }
#|        uint32_t base = eq->child[0];
#|        uint32_t left = eq->child[1];
#|        uint32_t right = eq->child[2];
#|        uint32_t motive_type = ok_whnf(s, ok_infer(s, term.child[0], depth + 1), depth + 1);
#|        const ok_term *motive = ok_get(s, motive_type);
#|        if (!motive || motive->tag != OK_PI) {
#|            return ok_fail(s, OK_NOT_A_FUNCTION, id);
#|        }
#|        uint32_t domain = motive->child[0];
#|        uint32_t codomain = motive->child[1];
#|        const ok_term *sort = ok_get(s, ok_whnf(s, codomain, depth + 1));
#|        if (!ok_convert(s, domain, base, depth + 1) || !sort || sort->tag != OK_SORT) {
#|            return ok_fail(s, OK_NOT_A_TYPE, id);
#|        }
#|        if (!ok_check(s, term.child[2], ok_binary(s, OK_APP, term.child[0], left), depth + 1)) {
#|            return OK_NONE;
#|        }
#|        return ok_binary(s, OK_APP, term.child[0], right);
#|    }
#|    case OK_ABSURD:
#|        if (ok_type_level(s, term.child[0], depth + 1) < 0 ||
#|            !ok_check(s, term.child[1], ok_atom(s, OK_EMPTY), depth + 1)) {
#|            return OK_NONE;
#|        }
#|        return term.child[0];
#|    case OK_CONSTANT:
#|        if (term.data[0] < 0 || (uint64_t)term.data[0] >= s->definition_count) {
#|            return ok_fail(s, OK_BAD_CONSTANT, id);
#|        }
#|        return s->definitions[term.data[0]].type;
#|    case OK_RAT_LITERAL:
#|        if (term.data[0] == INT64_MIN || term.data[1] <= 0) {
#|            return ok_fail(s, OK_BAD_NODE, id);
#|        }
#|        return ok_atom(s, OK_RAT);
#|    case OK_RAT_ADD:
#|    case OK_RAT_MUL:
#|    case OK_RAT_NEG: {
#|        uint32_t rational = ok_atom(s, OK_RAT);
#|        for (unsigned i = 0; i < ok_arity(term.tag); ++i) {
#|            if (!ok_check(s, term.child[i], rational, depth + 1)) {
#|                return OK_NONE;
#|            }
#|        }
#|        return rational;
#|    }
#|    default:
#|        return ok_fail(s, OK_BAD_NODE, id);
#|    }
#|}
#|
#|static int ok_check(ok_checker *s, uint32_t term, uint32_t expected, uint32_t depth)
#|{
#|    uint32_t inferred = ok_infer(s, term, depth + 1);
#|    if (inferred == OK_NONE || !ok_convert(s, inferred, expected, depth + 1)) {
#|        ok_fail(s, OK_TYPE_MISMATCH, term);
#|        return 0;
#|    }
#|    return s->error == OK_SUCCESS;
#|}
#|
#|static inline int ok_define(ok_checker *s, uint32_t type, uint32_t body)
#|{
#|    if (!s || s->context_size != 0 || s->definition_count >= OK_DEFINITIONS_MAX) {
#|        ok_fail(s, OK_BAD_CONSTANT, body);
#|        return 0;
#|    }
#|    if (ok_type_level(s, type, 0) < 0 || !ok_check(s, body, type, 0)) {
#|        return 0;
#|    }
#|    s->definitions[s->definition_count].type = type;
#|    s->definitions[s->definition_count].body = body;
#|    s->definition_count++;
#|    return 1;
#|}
#|
#|static inline int ok_verify(ok_checker *s, uint32_t proof, uint32_t expected)
#|{
#|    if (!s || s->context_size != 0 || s->error != OK_SUCCESS) {
#|        return 0;
#|    }
#|    if (ok_type_level(s, expected, 0) < 0) {
#|        return 0;
#|    }
#|    return ok_check(s, proof, expected, 0) && s->error == OK_SUCCESS;
#|}
#|
#|static inline int ok_is_resource_error(ok_error error)
#|{
#|    return error == OK_ARENA_LIMIT || error == OK_FUEL_LIMIT ||
#|           error == OK_DEPTH_LIMIT || error == OK_CONTEXT_LIMIT ||
#|           error == OK_UNIVERSE_LIMIT || error == OK_ARITHMETIC_LIMIT;
#|}
#|
#|#endif
# OMEGA-KERNEL-FILE-END
# OMEGA-KERNEL-FILE "kernel/native/main.c"
#|/* Linux JSON adapter. The proof checker itself is the allocation-free logic.h;
#| * stdio, JSON storage and optional GMP tensors are outside that core's TCB. */
#|#include <stdio.h>
#|#include <stdlib.h>
#|#include <stdint.h>
#|#include <inttypes.h>
#|#include <string.h>
#|#include "json.h"
#|#include "sha256.h"
#|#include "logic.h"
#|#include "tensor.h"
#|#ifdef OMEGA_KERNEL_GMP
#|#include "tensor_graph.h"
#|#endif
#|
#|#define OK_INPUT_BYTES (4u*1024u*1024u)
#|#define OK_JSON_TOKENS 65536u
#|#define OK_TERM_CAPACITY 16384u
#|#define OK_BATCH_CAPACITY 4096u
#|
#|static unsigned char input_buffer[OK_INPUT_BYTES+1];
#|static okj_token json_tokens[OK_JSON_TOKENS];
#|static ok_term term_arena[OK_TERM_CAPACITY];
#|static int64_t batch_an[OK_BATCH_CAPACITY];
#|static int64_t batch_bn[OK_BATCH_CAPACITY];
#|static int64_t batch_cn[OK_BATCH_CAPACITY];
#|static uint64_t batch_ad[OK_BATCH_CAPACITY];
#|static uint64_t batch_bd[OK_BATCH_CAPACITY];
#|static uint64_t batch_cd[OK_BATCH_CAPACITY];
#|static uint8_t batch_status[OK_BATCH_CAPACITY];
#|
#|static const char *const term_names[OK_TAG_COUNT] = {
#|    "sort", "var", "pi", "lambda", "app", "let", "annotation", "sigma",
#|    "pair", "first", "second", "nat", "zero", "successor", "nat-literal",
#|    "nat-add", "nat-mul", "nat-rec", "equality", "refl", "transport", "unit",
#|    "unit-value", "empty", "absurd", "constant", "rat", "rat-literal",
#|    "rat-add", "rat-mul", "rat-neg"
#|};
#|
#|static const char *const error_names[] = {
#|    "success", "bad-node", "scope", "type-mismatch", "not-a-type",
#|    "not-a-function", "not-a-pair", "constant-not-previously-checked",
#|    "arena-limit", "fuel-limit", "depth-limit", "context-limit",
#|    "universe-limit", "arithmetic-limit"
#|};
#|
#|static void result_prefix(const char *operation, const char *digest)
#|{
#|    printf("{\"format\":\"omega-kernel-native-result-1\","
#|           "\"operation\":\"%s\",\"input_sha256\":\"%s\",",operation,digest);
#|}
#|
#|static int malformed(const char *operation, const char *digest)
#|{
#|    result_prefix(operation,digest);
#|    puts("\"accepted\":false,\"verified\":false,\"status\":\"malformed-request\"}");
#|    return 3;
#|}
#|
#|static int protocol_fields(const okj_parser *p, uint32_t object,
#|                           const char *const *keys, size_t count)
#|{
#|    return object<p->count && p->tokens[object].tag==OKJ_OBJECT &&
#|           okj_fields(p,object,keys,count);
#|}
