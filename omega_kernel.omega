#|        return 0;
#|    } else if (!o_equal(a->a[i], b->a[i]))
#|      return 0;
#|  }
#|  return 1;
#|}
#|static int o_equal(V a, V b) {
#|  o_enter();
#|  int result = o_equal_inner(a, b);
#|  --omega_depth;
#|  return result;
