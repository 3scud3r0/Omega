  var j=0;
  enquanto((j<len(p))) {
    var e=slice(((p)[j])[1],0,len(((p)[j])[1]));
    se(((i<0)||(i>=len(e)))) {
      fail("Derivative variable outside polynomial");
    }
    se(((e)[i]>0)) {
      var c=om_mod_0_check((((p)[j])[0]*(e)[i]));
      put(e,i,((e)[i]-1));
      om_mod_13_poly_insert(out,c,e);
    }
    j=(j+1);
  }
  retornar om_mod_13_poly_clean(out);
}
funcao om_mod_13_poly_eval(p,x) {
  var v=0;
  var i=0;
  enquanto((i<len(p))) {
    se((len(((p)[i])[1])!=len(x))) {
      fail("Polynomial evaluation dimension");
    }
    var t=((p)[i])[0];
    var j=0;
    enquanto((j<len(x))) {
      t=om_mod_0_check((t*om_mod_0_power((x)[j],(((p)[i])[1])[j])));
      j=(j+1);
    }
    v=om_mod_0_check((v+t));
    i=(i+1);
  }
  retornar v;
}
funcao om_mod_13_poly_extend(p,n) {
  var out=[];
  var i=0;
  enquanto((i<len(p))) {
    var e=slice(((p)[i])[1],0,len(((p)[i])[1]));
    se((len(e)>n)) {
      fail("Cannot discard polynomial variables");
    }
    enquanto((len(e)<n)) {
      push(e,0);
    }
    push(out,[((p)[i])[0],e]);
    i=(i+1);
  }
  retornar out;
}
funcao om_mod_13_poly_insert(p,c,e) {
  om_mod_0_check(c);
  se((c==0)) {
    retornar p;
  }
  var i=0;
  enquanto((i<len(p))) {
    se(om_mod_13_same(((p)[i])[1],e)) {
      put((p)[i],0,om_mod_0_check((((p)[i])[0]+c)));
      retornar p;
    }
    i=(i+1);
  }
  se((len(p)>=512)) {
    fail("Sparse polynomial term budget");
  }
  push(p,[c,slice(e,0,len(e))]);
  retornar p;
}
funcao om_mod_13_poly_mul(a,b) {
  var c=[];
  var i=0;
  enquanto((i<len(a))) {
    var j=0;
    enquanto((j<len(b))) {
      var e=om_mod_0_add(((a)[i])[1],((b)[j])[1]);
      var k=0;
      var degree=0;
      enquanto((k<len(e))) {
        degree=(degree+(e)[k]);
        k=(k+1);
      }
      se((degree>24)) {
        fail("Intermediate polynomial degree budget");
      }
      om_mod_13_poly_insert(c,om_mod_0_check((((a)[i])[0]*((b)[j])[0])),e);
      j=(j+1);
    }
    i=(i+1);
  }
  retornar om_mod_13_poly_clean(c);
}
funcao om_mod_13_poly_power(p,k,n) {
  om_mod_0_integer(k,0,12);
  var q=om_mod_13_poly_const(1,n);
  var i=0;
  enquanto((i<k)) {
    q=om_mod_13_poly_mul(q,p);
    i=(i+1);
  }
  retornar q;
}
funcao om_mod_13_poly_read(raw,n) {
  om_mod_0_integer(n,1,16);
  se(((!islist(raw))||(len(raw)>256))) {
    fail("Sparse polynomial input budget");
  }
  var p=[];
  var i=0;
  enquanto((i<len(raw))) {
    se(((!islist((raw)[i]))||(len((raw)[i])!=2))) {
      fail("Polynomial term [coefficient, exponents]");
    }
    var e=om_mod_0_vector(((raw)[i])[1]);
    se((len(e)!=n)) {
      fail("Polynomial exponent dimension");
    }
    var degree=0;
    var j=0;
    enquanto((j<n)) {
      om_mod_0_integer((e)[j],0,12);
      degree=(degree+(e)[j]);
      j=(j+1);
    }
    se((degree>12)) {
      fail("Polynomial total degree budget");
    }
    om_mod_13_poly_insert(p,om_mod_0_val(((raw)[i])[0]),e);
    i=(i+1);
  }
  retornar om_mod_13_poly_clean(p);
}
funcao om_mod_13_poly_scale(a,x) {
  var c=[];
  var i=0;
  enquanto((i<len(a))) {
    om_mod_13_poly_insert(c,om_mod_0_check((((a)[i])[0]*x)),((a)[i])[1]);
    i=(i+1);
  }
  retornar om_mod_13_poly_clean(c);
}
funcao om_mod_13_poly_text(p) {
  var code="0";
  var i=0;
  enquanto((i<len(p))) {
    var term=(("("+text(((p)[i])[0]))+")");
    var j=0;
    enquanto((j<len(((p)[i])[1]))) {
      var k=0;
      enquanto((k<(((p)[i])[1])[j])) {
        term=(((term+"*x[")+text(j))+"]");
        k=(k+1);
      }
      j=(j+1);
    }
    code=(((code+"+(")+term)+")");
    i=(i+1);
  }
  retornar code;
}
funcao om_mod_13_poly_var(i,n) {
  om_mod_0_integer(i,0,(n-1));
  var e=om_mod_0_zeros(n);
  put(e,i,1);
  retornar [[1,e]];
}
funcao om_mod_13_probability(raw) {
  var p=om_mod_0_vector(raw);
  se(((len(p)<1)||(len(p)>256))) {
    fail("Probability vector size");
  }
  var total=0;
  var i=0;
  enquanto((i<len(p))) {
    om_mod_0_nonnegative((p)[i]);
    total=(total+(p)[i]);
    i=(i+1);
  }
  se((total!=1)) {
    fail("Probability mass must sum exactly to one");
  }
  retornar p;
}
funcao om_mod_13_same(a,b) {
  se((len(a)!=len(b))) {
    retornar 0;
  }
  var i=0;
  enquanto((i<len(a))) {
    se(((a)[i]!=(b)[i])) {
      retornar 0;
    }
    i=(i+1);
  }
  retornar 1;
}
funcao om_mod_13_symmetric_positive(a) {
  var n=len(a);
  se((((n<1)||(n>16))||(len((a)[0])!=n))) {
    fail("SPD matrix dimension 1..16");
  }
  var i=0;
  enquanto((i<n)) {
    var principal=[];
    var j=0;
    enquanto((j<n)) {
      se((((a)[i])[j]!=((a)[j])[i])) {
        fail("Symmetric matrix required");
      }
      se((j<=i)) {
        push(principal,slice((a)[j],0,(i+1)));
      }
      j=(j+1);
    }
    se((om_mod_0_determinant(principal)<=0)) {
      fail("Positive-definite matrix required");
    }
    i=(i+1);
  }
  retornar 1;
}
funcao om_mod_12_execute(r) {
  var belief=om_mod_13_probability((r)["belief"]);
  var states=len(belief);
  var likelihood=om_mod_0_mat((r)["likelihood"]);
  var preferences=om_mod_13_probability((r)["preferences"]);
  se(((((states>8)||(len(likelihood)!=states))||(len(preferences)>8))||(len((likelihood)[0])!=len(preferences)))) {
    fail("POMDP states/observations 1..8");
  }
  var i=0;
  enquanto((i<states)) {
    om_mod_13_probability((likelihood)[i]);
    i=(i+1);
  }
  i=0;
  enquanto((i<len(preferences))) {
    om_mod_0_positive((preferences)[i]);
    i=(i+1);
  }
  var raw=(r)["transitions"];
  se((((!islist(raw))||(len(raw)<1))||(len(raw)>4))) {
    fail("POMDP actions 1..4");
  }
  var transitions=[];
  i=0;
  enquanto((i<len(raw))) {
    var matrix=om_mod_0_mat((raw)[i]);
    se(((len(matrix)!=states)||(len((matrix)[0])!=states))) {
      fail("Transition shape mismatch");
    }
    var j=0;
    enquanto((j<states)) {
      om_mod_13_probability((matrix)[j]);
      j=(j+1);
    }
    push(transitions,matrix);
    i=(i+1);
  }
  var allowed=om_mod_0_vector((r)["allowed_actions"]);
  se((len(allowed)!=len(transitions))) {
    fail("Action mask shape");
  }
  i=0;
  enquanto((i<len(allowed))) {
    om_mod_0_integer((allowed)[i],0,1);
    i=(i+1);
  }
  se(has(r,"previous_action")) {
    belief=om_mod_12_predict(belief,(transitions)[om_mod_0_count(r,"previous_action",0,(len(transitions)-1))]);
  }
  var source="not-supplied";
  var sequence=(-1);
  se(has(r,"observation")) {
    source=om_mod_0_text_field(r,"source",256);
    se((len(source)==0)) {
      fail("Observation provenance required");
    }
    sequence=om_mod_0_count(r,"sequence",0,1000000000000);
    se((has(r,"last_sequence")&&(sequence<=om_mod_0_q(r,"last_sequence")))) {
      fail("Stale observation sequence");
    }
    belief=om_mod_12_posterior(belief,likelihood,om_mod_0_count(r,"observation",0,(len(preferences)-1)));
  }
  var bits=om_mod_0_integer(om_mod_0_num(r,"bits",32),12,80);
  var horizon=om_mod_0_integer(om_mod_0_num(r,"horizon",1),1,3);
  var meter=[0];
  var out=om_mod_12_plan(belief,transitions,likelihood,preferences,allowed,horizon,bits,meter);
  put(out,"model","finite-POMDP-Bayes-and-interval-expected-free-energy");
  put(out,"belief",belief);
  put(out,"source",source);
  put(out,"sequence",sequence);
  put(out,"policy_nodes",(meter)[0]);
  put(out,"external_action_executed",0);
  put(out,"sensor_origin_authenticated",0);
  put(out,"formal_admission",0);
  retornar out;
}
funcao om_mod_12_immediate(predicted,likelihood,preferences,bits) {
  var observations=om_mod_13_apply(om_mod_0_transpose(likelihood),predicted);
  var cost=[0,0];
  var i=0;
  enquanto((i<len(observations))) {
    se(((observations)[i]>0)) {
      var logratio=om_mod_29_log_interval(((observations)[i]/(preferences)[i]),bits);
      cost=om_mod_1_add(cost,om_mod_1_scale(logratio,(observations)[i]));
    }
    i=(i+1);
  }
  i=0;
  enquanto((i<len(predicted))) {
    se(((predicted)[i]>0)) {
      cost=om_mod_1_add(cost,om_mod_1_scale(om_mod_13_entropy((likelihood)[i],bits),(predicted)[i]));
    }
    i=(i+1);
  }
  retornar [cost,observations];
}
funcao om_mod_12_plan(belief,transitions,likelihood,preferences,allowed,horizon,bits,meter) {
  put(meter,0,((meter)[0]+1));
  se(((meter)[0]>256)) {
    fail("Active inference policy tree budget 256");
  }
  var costs=[];
  var actions=[];
  var action=0;
  var chosen=(-1);
  var chosen_upper=0;
  var lower=0;
  enquanto((action<len(transitions))) {
    se((allowed)[action]) {
      var prior=om_mod_12_predict(belief,(transitions)[action]);
      var now=om_mod_12_immediate(prior,likelihood,preferences,bits);
      var value=(now)[0];
      se((horizon>1)) {
        var observation=0;
        enquanto((observation<len(preferences))) {
          se((((now)[1])[observation]>0)) {
            var next=om_mod_12_posterior(prior,likelihood,observation);
            var future=om_mod_12_plan(next,transitions,likelihood,preferences,allowed,(horizon-1),bits,meter);
            value=om_mod_1_add(value,om_mod_1_scale((future)["optimal_value_interval"],((now)[1])[observation]));
          }
          observation=(observation+1);
        }
      }
      push(actions,action);
      push(costs,value);
      se((chosen<0)) {
        chosen=action;
        chosen_upper=(value)[1];
        lower=(value)[0];
      }
      senao {
        lower=om_mod_29_min(lower,(value)[0]);
        se(((value)[1]<chosen_upper)) {
          chosen=action;
          chosen_upper=(value)[1];
        }
      }
    }
    action=(action+1);
  }
  se((chosen<0)) {
    fail("No action authorized in the supplied admissibility mask");
  }
  var out=obj();
  put(out,"action_proposal",chosen);
  put(out,"actions",actions);
  put(out,"cost_intervals",costs);
  put(out,"optimal_value_interval",[lower,chosen_upper]);
  put(out,"selection_regret_upper",(chosen_upper-lower));
  retornar out;
}
funcao om_mod_12_posterior(prior,likelihood,observation) {
  var mass=0;
  var p=[];
  var i=0;
  enquanto((i<len(prior))) {
    var v=((prior)[i]*((likelihood)[i])[observation]);
    push(p,v);
    mass=(mass+v);
    i=(i+1);
  }
  se((mass==0)) {
    fail("Observation has zero model evidence; do not fabricate a posterior");
  }
  retornar om_mod_0_scale(p,(1/mass));
}
funcao om_mod_12_predict(belief,transition) {
  retornar om_mod_13_apply(om_mod_0_transpose(transition),belief);
}
funcao om_mod_14_bounded_rational(x) {
  om_mod_0_check(x);
  se(((om_mod_29_abs(qnum(x))>9223372036854775807)||(qden(x)>9223372036854775807))) {
    fail("Microactor exact rational exceeds signed 63-bit magnitude storage");
  }
  retornar x;
}
funcao om_mod_14_execute(r) {
  var count=om_mod_0_count(r,"actors",1,256);
  var arena=om_mod_0_count(r,"arena_bytes",4096,524288);
  var memory=om_mod_0_count(r,"memory_bytes",4096,2147483648);
  var registers=om_mod_0_count(r,"registers",1,16);
  var mailbox=om_mod_0_count(r,"mailbox_capacity",1,64);
  var quantum=om_mod_0_count(r,"quantum",1,64);
  var turns=om_mod_0_count(r,"max_turns",1,100000);
  var raw=(r)["program"];
  se((((!islist(raw))||(len(raw)<1))||(len(raw)>128))) {
    fail("Microactor shared program length 1..128");
  }
  se(((arena%8)!=0)) {
    fail("Microactor arena stride must be aligned to eight bytes");
  }
  var reserved=(((count*arena)+(len(raw)*64))+256);
  se((reserved>memory)) {
    fail("Microactor arena reservation exceeds memory quota");
  }
  se((((256+(registers*16))+(mailbox*32))>arena)) {
    fail("Actor layout does not fit arena");
  }
  var code=[];
  var i=0;
  enquanto((i<len(raw))) {
    push(code,om_mod_14_instruction((raw)[i],count,registers,len(raw)));
    i=(i+1);
  }
  var actors=[];
  i=0;
  enquanto((i<count)) {
    var actor=obj();
    var state=om_mod_0_zeros(registers);
    put(state,0,i);
    se(has(r,"initial")) {
      se(((!islist((r)["initial"]))||(len((r)["initial"])!=count))) {
        fail("Initial actor array shape");
      }
      state=om_mod_0_vector(((r)["initial"])[i]);
      se((len(state)!=registers)) {
        fail("Initial register shape");
      }
      var j=0;
      enquanto((j<registers)) {
        om_mod_14_bounded_rational((state)[j]);
        j=(j+1);
      }
    }
    var slots=om_mod_0_zeros(mailbox);
    put(actor,"registers",state);
    put(actor,"mailbox",slots);
    put(actor,"head",0);
    put(actor,"tail",0);
    put(actor,"count",0);
    put(actor,"pc",0);
    put(actor,"halted",0);
    put(actor,"status","ready");
    put(actor,"executed",0);
    push(actors,actor);
    i=(i+1);
  }
  var turn=0;
  var idle=0;
  var completed=0;
  var instructions=0;
  var messages=0;
  var peak=0;
  var deadlock=0;
  enquanto((((turn<turns)&&(completed<count))&&(!deadlock))) {
    var id=(turn%count);
    var actor=(actors)[id];
    var progress=0;
    var used=0;
    var stop=(actor)["halted"];
    enquanto(((used<quantum)&&(!stop))) {
      var pc=(actor)["pc"];
      se(((pc<0)||(pc>=len(code)))) {
        fail("Microactor PC outside shared program");
      }
      var command=(code)[pc];
      var op=(command)[0];
      var reg=(command)[1];
      var next=(pc+1);
      se((op=="set")) {
        put((actor)["registers"],reg,(command)[3]);
      }
      se((op=="add")) {
        put((actor)["registers"],reg,om_mod_14_bounded_rational((((actor)["registers"])[reg]+(command)[3])));
      }
      se((op=="mul")) {
        put((actor)["registers"],reg,om_mod_14_bounded_rational((((actor)["registers"])[reg]*(command)[3])));
      }
      se(((op=="assert")&&(((actor)["registers"])[reg]!=(command)[3]))) {
        fail("Microactor assertion failed");
      }
      se((op=="jump")) {
        next=(command)[2];
      }
      se(((op=="jnz")&&(((actor)["registers"])[reg]!=0))) {
        next=(command)[2];
      }
      se((op=="send")) {
        var recipient=(actors)[(command)[2]];
        se(((recipient)["count"]==mailbox)) {
          put(actor,"status","blocked_send");
          stop=1;
        }
        senao {
          put((recipient)["mailbox"],(recipient)["tail"],((actor)["registers"])[reg]);
          put(recipient,"tail",(((recipient)["tail"]+1)%mailbox));
          put(recipient,"count",((recipient)["count"]+1));
          peak=om_mod_29_max(peak,(recipient)["count"]);
          messages=(messages+1);
        }
      }
      se((op=="recv")) {
        se(((actor)["count"]==0)) {
          put(actor,"status","blocked_receive");
          stop=1;
        }
        senao {
          put((actor)["registers"],reg,((actor)["mailbox"])[(actor)["head"]]);
          put((actor)["mailbox"],(actor)["head"],0);
          put(actor,"head",(((actor)["head"]+1)%mailbox));
          put(actor,"count",((actor)["count"]-1));
        }
      }
      se((!stop)) {
        put(actor,"pc",next);
        put(actor,"status","ready");
        put(actor,"executed",((actor)["executed"]+1));
        progress=1;
        used=(used+1);
        instructions=(instructions+1);
        se((op=="halt")) {
          put(actor,"halted",1);
          put(actor,"status","halted");
          completed=(completed+1);
          stop=1;
        }
        se((op=="yield")) {
          stop=1;
        }
      }
    }
    se(progress) {
      idle=0;
    }
    senao {
      idle=(idle+1);
    }
    se(((idle>=count)&&(completed<count))) {
      deadlock=1;
    }
    turn=(turn+1);
  }
  var states=[];
  var statuses=[];
  var mail_counts=[];
  var pcs=[];
  i=0;
  enquanto((i<count)) {
    push(states,((actors)[i])["registers"]);
    push(statuses,((actors)[i])["status"]);
    push(mail_counts,((actors)[i])["count"]);
    push(pcs,((actors)[i])["pc"]);
    i=(i+1);
  }
  var out=om_mod_0_result("bounded-cooperative-stackless-microactor-reference",states);
  put(out,"statuses",statuses);
  put(out,"program_counters",pcs);
  put(out,"mailbox_counts",mail_counts);
  put(out,"turns",turn);
  put(out,"instructions",instructions);
  put(out,"messages",messages);
  put(out,"mailbox_peak",peak);
  put(out,"completed",completed);
  put(out,"deadlock",deadlock);
  put(out,"turn_budget_exhausted",(((turn==turns)&&(completed<count))&&(!deadlock)));
  put(out,"logical_reserved_bytes",reserved);
  put(out,"shared_program",code);
  put(out,"process_RSS_bound_is_per_actor_reservation",0);
  put(out,"M_to_N_fibers_implemented",0);
  retornar out;
}
funcao om_mod_14_instruction(raw,actors,registers,length) {
  var op=om_mod_0_text_field(raw,"op",16);
  var reg=0;
  var target=0;
  var value=0;
  se(((((op=="set")||(op=="add"))||(op=="mul"))||(op=="assert"))) {
    reg=om_mod_0_count(raw,"register",0,(registers-1));
    value=om_mod_14_bounded_rational(om_mod_0_q(raw,"value"));
  }
  senao {
    se((op=="send")) {
      reg=om_mod_0_count(raw,"register",0,(registers-1));
      target=om_mod_0_count(raw,"target",0,(actors-1));
    }
    senao {
      se((op=="recv")) {
        reg=om_mod_0_count(raw,"register",0,(registers-1));
      }
      senao {
        se(((op=="jump")||(op=="jnz"))) {
          target=om_mod_0_count(raw,"target",0,(length-1));
          se((op=="jnz")) {
            reg=om_mod_0_count(raw,"register",0,(registers-1));
          }
        }
        senao {
          se(((op!="yield")&&(op!="halt"))) {
            fail("Unknown microactor opcode");
          }
        }
      }
    }
  }
  retornar [op,reg,target,value];
}
funcao om_mod_15_as_polynomial(ast,n) {
  se(((ast)[0]=="const")) {
    retornar om_mod_13_poly_const(om_mod_0_val((ast)[1]),n);
  }
  se(((ast)[0]=="var")) {
    retornar om_mod_13_poly_var(om_mod_0_val((ast)[1]),n);
  }
  var left=om_mod_15_as_polynomial((ast)[1],n);
  var right=om_mod_15_as_polynomial((ast)[2],n);
  se(((ast)[0]=="add")) {
    retornar om_mod_13_poly_add(left,right);
  }
  retornar om_mod_13_poly_mul(left,right);
}
funcao om_mod_15_execute(r) {
  var variables=om_mod_0_count(r,"variables",1,8);
  var rounds=om_mod_0_integer(om_mod_0_num(r,"rounds",8),1,32);
  var g=obj();
  put(g,"nodes",[]);
  put(g,"parent",[]);
  put(g,"ledger",[]);
  put(g,"limited",0);
  put(g,"limit",om_mod_0_integer(om_mod_0_num(r,"max_nodes",256),16,1024));
  var entry=om_mod_15_ingest(g,(r)["expression"],variables,0,[0]);
  var iteration=0;
  var saturated=0;
  enquanto((((iteration<rounds)&&(!(g)["limited"]))&&(!saturated))) {
    var size=len((g)["nodes"]);
    var changed=0;
    var i=0;
    enquanto(((i<size)&&(!(g)["limited"]))) {
      changed=(changed+om_mod_15_rewrite(g,i));
      i=(i+1);
    }
    changed=(changed+om_mod_15_rebuild(g));
    saturated=((changed==0)&&(len((g)["nodes"])==size));
    iteration=(iteration+1);
  }
  var costs=[];
  var best=[];
  var i=0;
  enquanto((i<len((g)["nodes"]))) {
    push(costs,1000000);
    push(best,(-1));
    i=(i+1);
  }
  var changed=1;
  var passes=0;
  enquanto((changed&&(passes<=len((g)["nodes"])))) {
    changed=0;
    i=0;
    enquanto((i<len((g)["nodes"]))) {
      var node=((g)["nodes"])[i];
      var cost=1;
      var j=0;
      enquanto((j<len((node)[2]))) {
        cost=(cost+(costs)[om_mod_15_root(g,((node)[2])[j])]);
        j=(j+1);
      }
      var class=om_mod_15_root(g,i);
      se((cost<(costs)[class])) {
        put(costs,class,cost);
        put(best,class,i);
        changed=1;
      }
      i=(i+1);
    }
    passes=(passes+1);
  }
  se(((best)[om_mod_15_root(g,entry)]<0)) {
    fail("Egraph has no finite extraction");
  }
  var expression=om_mod_15_extracted(g,entry,best,0);
  var original=om_mod_15_as_polynomial((r)["expression"],variables);
  var equivalent=om_mod_15_as_polynomial(expression,variables);
  se((len(om_mod_13_poly_add(original,om_mod_13_poly_scale(equivalent,(-1))))!=0)) {
    fail("Extracted expression polynomial equivalence failed");
  }
  var out=om_mod_0_result("bounded-ring-egraph-saturation",expression);
  put(out,"nodes",len((g)["nodes"]));
  put(out,"cost",(costs)[om_mod_15_root(g,entry)]);
  put(out,"ledger",(g)["ledger"]);
  put(out,"saturated",saturated);
  put(out,"budget_limited",((g)["limited"]||((!saturated)&&(iteration==rounds))));
  put(out,"polynomial_equivalence_checked",1);
  put(out,"global_optimum_claimed",0);
  retornar out;
}
funcao om_mod_15_extracted(g,id,best,depth) {
  se((depth>128)) {
    fail("Egraph extraction depth budget");
  }
  var node=((g)["nodes"])[(best)[om_mod_15_root(g,id)]];
  se((((node)[0]=="const")||((node)[0]=="var"))) {
    retornar [(node)[0],(node)[1]];
  }
  retornar [(node)[0],om_mod_15_extracted(g,((node)[2])[0],best,(depth+1)),om_mod_15_extracted(g,((node)[2])[1],best,(depth+1))];
}
funcao om_mod_15_ingest(g,ast,variables,depth,meter) {
  put(meter,0,((meter)[0]+1));
  se(((((depth>24)||((meter)[0]>128))||(!islist(ast)))||(len(ast)<1))) {
    fail("Egraph input AST budget");
  }
  var op=(ast)[0];
  var id=(-1);
  se(((op=="const")&&(len(ast)==2))) {
    id=om_mod_15_intern(g,op,om_mod_0_val((ast)[1]),[]);
  }
  senao {
    se(((op=="var")&&(len(ast)==2))) {
      id=om_mod_15_intern(g,op,om_mod_0_integer(om_mod_0_val((ast)[1]),0,(variables-1)),[]);
    }
    senao {
      se((((op!="add")&&(op!="mul"))||(len(ast)!=3))) {
        fail("Egraph supports const, var, add, mul with exact arity");
      }
      var left=om_mod_15_ingest(g,(ast)[1],variables,(depth+1),meter);
      var right=om_mod_15_ingest(g,(ast)[2],variables,(depth+1),meter);
      id=om_mod_15_intern(g,op,0,[left,right]);
    }
  }
  se((id<0)) {
    fail("Input exceeds egraph node capacity");
  }
  retornar id;
}
funcao om_mod_15_intern(g,op,payload,children) {
  var canonical=[];
  var j=0;
  enquanto((j<len(children))) {
    push(canonical,om_mod_15_root(g,(children)[j]));
    j=(j+1);
  }
  var nodes=(g)["nodes"];
  var i=0;
  enquanto((i<len(nodes))) {
    se((((((nodes)[i])[0]==op)&&(((nodes)[i])[1]==payload))&&(len(((nodes)[i])[2])==len(canonical)))) {
      var equal=1;
      j=0;
      enquanto((j<len(canonical))) {
        se((om_mod_15_root(g,(((nodes)[i])[2])[j])!=(canonical)[j])) {
          equal=0;
        }
        j=(j+1);
      }
      se(equal) {
        retornar i;
      }
    }
    i=(i+1);
  }
  se((len(nodes)>=(g)["limit"])) {
    put(g,"limited",1);
    retornar (-1);
  }
  var id=len(nodes);
  push(nodes,[op,payload,canonical]);
  push((g)["parent"],id);
  retornar id;
}
funcao om_mod_15_matching(g,id,op) {
  var i=0;
  enquanto((i<len((g)["nodes"]))) {
    se(((om_mod_15_root(g,i)==om_mod_15_root(g,id))&&((((g)["nodes"])[i])[0]==op))) {
      retornar i;
    }
    i=(i+1);
  }
  retornar (-1);
}
funcao om_mod_15_merge(g,x,y,rule) {
  se(((x<0)||(y<0))) {
    retornar 0;
  }
  var rx=om_mod_15_root(g,x);
  var ry=om_mod_15_root(g,y);
  se((rx==ry)) {
    retornar 0;
  }
  se((rx>ry)) {
    var t=rx;
    rx=ry;
    ry=t;
  }
  put((g)["parent"],ry,rx);
  push((g)["ledger"],[rule,x,y]);
  retornar 1;
}
funcao om_mod_15_rebuild(g) {
  var changed=0;
  var i=0;
  enquanto((i<len((g)["nodes"]))) {
    var node=((g)["nodes"])[i];
    var j=0;
    enquanto((j<i)) {
      var other=((g)["nodes"])[j];
      se(((((node)[0]==(other)[0])&&((node)[1]==(other)[1]))&&(len((node)[2])==len((other)[2])))) {
        var equal=1;
        var k=0;
        enquanto((k<len((node)[2]))) {
          se((om_mod_15_root(g,((node)[2])[k])!=om_mod_15_root(g,((other)[2])[k]))) {
            equal=0;
          }
          k=(k+1);
        }
        se(equal) {
          changed=(changed+om_mod_15_merge(g,i,j,"congruence"));
        }
      }
      j=(j+1);
    }
    i=(i+1);
  }
  retornar changed;
}
funcao om_mod_15_rewrite(g,id) {
  var node=((g)["nodes"])[id];
  var op=(node)[0];
  var changed=0;
  se(((op!="add")&&(op!="mul"))) {
    retornar 0;
  }
  var x=((node)[2])[0];
  var y=((node)[2])[1];
  var xc=om_mod_15_matching(g,x,"const");
  var yc=om_mod_15_matching(g,y,"const");
  se(((xc>=0)&&(yc>=0))) {
    var value=((((g)["nodes"])[xc])[1]+(((g)["nodes"])[yc])[1]);
    se((op=="mul")) {
      value=((((g)["nodes"])[xc])[1]*(((g)["nodes"])[yc])[1]);
    }
    changed=(changed+om_mod_15_merge(g,id,om_mod_15_intern(g,"const",om_mod_0_check(value),[]),"constant-fold"));
  }
  se((yc>=0)) {
    var value=(((g)["nodes"])[yc])[1];
    se((((op=="add")&&(value==0))||((op=="mul")&&(value==1)))) {
      changed=(changed+om_mod_15_merge(g,id,x,"identity"));
    }
    se(((op=="mul")&&(value==0))) {
      changed=(changed+om_mod_15_merge(g,id,y,"annihilator"));
    }
  }
  se((xc>=0)) {
    var value=(((g)["nodes"])[xc])[1];
    se((((op=="add")&&(value==0))||((op=="mul")&&(value==1)))) {
      changed=(changed+om_mod_15_merge(g,id,y,"identity"));
    }
    se(((op=="mul")&&(value==0))) {
      changed=(changed+om_mod_15_merge(g,id,x,"annihilator"));
    }
  }
  changed=(changed+om_mod_15_merge(g,id,om_mod_15_intern(g,op,0,[y,x]),"commute"));
  var nested=om_mod_15_matching(g,x,op);
  se((nested>=0)) {
    var children=(((g)["nodes"])[nested])[2];
    var inner=om_mod_15_intern(g,op,0,[(children)[1],y]);
    se((inner>=0)) {
      changed=(changed+om_mod_15_merge(g,id,om_mod_15_intern(g,op,0,[(children)[0],inner]),"associate"));
    }
  }
  se((op=="mul")) {
    var sum=om_mod_15_matching(g,y,"add");
    se((sum>=0)) {
      var children=(((g)["nodes"])[sum])[2];
      var left=om_mod_15_intern(g,"mul",0,[x,(children)[0]]);
      var right=om_mod_15_intern(g,"mul",0,[x,(children)[1]]);
      se(((left>=0)&&(right>=0))) {
        changed=(changed+om_mod_15_merge(g,id,om_mod_15_intern(g,"add",0,[left,right]),"distribute"));
      }
    }
  }
  retornar changed;
}
funcao om_mod_15_root(g,id) {
  var p=(g)["parent"];
  enquanto(((p)[id]!=id)) {
    put(p,id,(p)[(p)[id]]);
    id=(p)[id];
  }
  retornar id;
}
funcao om_mod_16_block(h,r0,r1,c0,c1) {
  var out=[];
  var i=r0;
  enquanto((i<r1)) {
    push(out,slice((h)[i],c0,c1));
    i=(i+1);
  }
  retornar out;
}
funcao om_mod_16_coarse(r) {
  var values=om_mod_0_vector((r)["values"]);
  var weights=om_mod_0_vector((r)["weights"]);
  var groups=om_mod_0_vector((r)["groups"]);
  var bins=om_mod_0_count(r,"bins",1,64);
  var n=len(values);
  se(((((n<1)||(n>1024))||(len(weights)!=n))||(len(groups)!=n))) {
    fail("Coarse field shape");
  }
  var mass=om_mod_0_zeros(bins);
  var weighted=om_mod_0_zeros(bins);
  var i=0;
  enquanto((i<n)) {
    var g=om_mod_0_integer((groups)[i],0,(bins-1));
    om_mod_0_positive((weights)[i]);
    put(mass,g,om_mod_0_check(((mass)[g]+(weights)[i])));
    put(weighted,g,om_mod_0_check(((weighted)[g]+((weights)[i]*(values)[i]))));
    i=(i+1);
  }
  var means=[];
  i=0;
  enquanto((i<bins)) {
    om_mod_0_positive((mass)[i]);
    push(means,((weighted)[i]/(mass)[i]));
    i=(i+1);
  }
  var unresolved=0;
  var total=0;
  var macro=0;
  i=0;
  enquanto((i<n)) {
    unresolved=om_mod_0_check((unresolved+((weights)[i]*om_mod_0_power(((values)[i]-(means)[(groups)[i]]),2))));
    total=(total+(((weights)[i]*(values)[i])*(values)[i]));
    i=(i+1);
  }
  i=0;
  enquanto((i<bins)) {
    macro=(macro+(((mass)[i]*(means)[i])*(means)[i]));
    i=(i+1);
  }
  se((total!=(macro+unresolved))) {
    fail("Weighted variance decomposition failed");
  }
  var out=om_mod_0_result("weighted-conservative-block-homogenization",means);
  put(out,"block_mass",mass);
  put(out,"weighted_sums",weighted);
  put(out,"unresolved_variance",unresolved);
  put(out,"fine_quadratic_moment",total);
  put(out,"coarse_quadratic_moment",macro);
  retornar out;
}
funcao om_mod_16_execute(r) {
  var mode=om_mod_0_text_field(r,"mode",24);
  se((mode=="gaussian")) {
    retornar om_mod_16_gaussian(r);
  }
  se((mode=="coarse")) {
    retornar om_mod_16_coarse(r);
  }
  fail("Multiscale mode gaussian or coarse required");
  retornar 0;
}
funcao om_mod_16_gaussian(r) {
  var h=om_mod_0_mat((r)["hessian"]);
  var b=om_mod_0_vector((r)["linear"]);
  var n=len(h);
  se((((n<2)||(n>12))||(len(b)!=n))) {
    fail("Gaussian multiscale dimension 2..12");
  }
  om_mod_13_symmetric_positive(h);
  var slow=om_mod_0_count(r,"slow",1,(n-1));
  var ss=om_mod_16_block(h,0,slow,0,slow);
  var sf=om_mod_16_block(h,0,slow,slow,n);
  var fs=om_mod_16_block(h,slow,n,0,slow);
  var ff=om_mod_16_block(h,slow,n,slow,n);
  var inv=om_mod_13_inverse(ff);
  var transfer=om_mod_0_mul(inv,fs);
  var bf=slice(b,slow,n);
  var offset=om_mod_13_apply(inv,bf);
  var correction=om_mod_0_mul(sf,transfer);
  var effective=[];
  var i=0;
  enquanto((i<slow)) {
    push(effective,om_mod_0_add((ss)[i],om_mod_0_scale((correction)[i],(-1))));
    i=(i+1);
  }
  om_mod_13_symmetric_positive(effective);
  var linear=om_mod_0_add(slice(b,0,slow),om_mod_0_scale(om_mod_13_apply(sf,offset),(-1)));
  var constant=(om_mod_0_num(r,"constant",0)-(om_mod_0_dot(bf,offset)/2));
  var out=om_mod_0_result("exact-quadratic-Schur-coarse-graining",effective);
  put(out,"linear",linear);
  put(out,"constant",constant);
  put(out,"fast_reconstruction_matrix",transfer);
  put(out,"fast_reconstruction_offset",offset);
  put(out,"reconstruction_sign",(-1));
  put(out,"marginal_normalization_included",0);
  se(has(r,"slow_state")) {
    var x=om_mod_0_vector((r)["slow_state"]);
    se((len(x)!=slow)) {
      fail("Slow probe dimension");
    }
    var fast=om_mod_0_scale(om_mod_0_add(om_mod_13_apply(transfer,x),offset),(-1));
    var full=slice(x,0,len(x));
    i=0;
    enquanto((i<len(fast))) {
      push(full,(fast)[i]);
      i=(i+1);
    }
    var original=(((om_mod_0_dot(full,om_mod_13_apply(h,full))/2)+om_mod_0_dot(b,full))+om_mod_0_num(r,"constant",0));
    var reduced=(((om_mod_0_dot(x,om_mod_13_apply(effective,x))/2)+om_mod_0_dot(linear,x))+constant);
    se((original!=reduced)) {
      fail("Schur energy correspondence failed");
    }
    var residual=om_mod_0_add(om_mod_13_apply(ff,fast),om_mod_0_add(om_mod_13_apply(fs,x),bf));
    se((om_mod_13_norm2(residual)!=0)) {
      fail("Fast conditional equilibrium failed");
    }
    put(out,"fast_state",fast);
    put(out,"original_energy",original);
    put(out,"effective_energy",reduced);
    put(out,"fast_stationarity_residual",residual);
  }
  retornar out;
}
funcao om_mod_17_execute(r) {
  var points=om_mod_0_mat((r)["samples"]);
  var y=om_mod_0_vector((r)["derivatives"]);
  var dimension=len((points)[0]);
  var exponents=(r)["exponents"];
  se((((((dimension>4)||(len(points)!=len(y)))||(!islist(exponents)))||(len(exponents)<1))||(len(exponents)>20))) {
    fail("SINDy shapes/budget: 32 samples, 4 variables, 20 features");
  }
  var basis=[];
  var i=0;
  enquanto((i<len(exponents))) {
    var parsed=om_mod_13_poly_read([[1,(exponents)[i]]],dimension);
    var j=0;
    enquanto((j<i)) {
      se(om_mod_13_same((basis)[j],((parsed)[0])[1])) {
        fail("Duplicate polynomial library feature");
      }
      j=(j+1);
    }
    push(basis,((parsed)[0])[1]);
    i=(i+1);
  }
  var design=om_mod_17_library(points,basis);
  var threshold=om_mod_0_nonnegative(om_mod_0_q(r,"threshold"));
  var ridge=om_mod_0_nonnegative(om_mod_0_num(r,"ridge",0));
  var iterations=om_mod_0_integer(om_mod_0_num(r,"iterations",10),1,32);
  var active=[];
  i=0;
  enquanto((i<len(basis))) {
    push(active,i);
    i=(i+1);
  }
  var history=[];
  var stable=0;
  var step=0;
  var coefficients=om_mod_0_zeros(len(basis));
  enquanto(((step<iterations)&&(!stable))) {
    var fit=om_mod_17_least_squares(design,y,active,ridge);
    var retained=[];
    coefficients=om_mod_0_zeros(len(basis));
    i=0;
    enquanto((i<len(active))) {
      put(coefficients,(active)[i],(fit)[i]);
      se(((om_mod_29_abs((fit)[i])>=threshold)&&((fit)[i]!=0))) {
        push(retained,(active)[i]);
      }
      i=(i+1);
    }
    push(history,[slice(active,0,len(active)),fit,om_mod_17_squared_error(design,y,coefficients)]);
    stable=om_mod_13_same(active,retained);
    active=retained;
    step=(step+1);
  }
  var fit=om_mod_17_least_squares(design,y,active,ridge);
  coefficients=om_mod_0_zeros(len(basis));
  i=0;
  enquanto((i<len(active))) {
    put(coefficients,(active)[i],(fit)[i]);
    i=(i+1);
  }
  var polynomial=[];
  i=0;
  enquanto((i<len(basis))) {
    se(((coefficients)[i]!=0)) {
      push(polynomial,[(coefficients)[i],(basis)[i]]);
    }
    i=(i+1);
  }
  var out=om_mod_0_result("sequential-thresholded-exact-least-squares",coefficients);
  put(out,"polynomial",polynomial);
  put(out,"support",active);
  put(out,"history",history);
  put(out,"training_squared_error",om_mod_17_squared_error(design,y,coefficients));
  put(out,"support_stabilized",stable);
  put(out,"source",(("funcao predict(x) { retornar "+om_mod_13_poly_text(polynomial))+"; }\n"));
  put(out,"empirical_law_proven",0);
  put(out,"derivatives_are_supplied_measurements",1);
  se(has(r,"holdout_samples")) {
    var holdout=om_mod_0_mat((r)["holdout_samples"]);
    var targets=om_mod_0_vector((r)["holdout_derivatives"]);
    se(((len((holdout)[0])!=dimension)||(len(holdout)!=len(targets)))) {
      fail("SINDy held-out shape");
    }
    put(out,"holdout_squared_error",om_mod_17_squared_error(om_mod_17_library(holdout,basis),targets,coefficients));
  }
  retornar out;
}
funcao om_mod_17_least_squares(design,target,active,ridge) {
  var k=len(active);
  se((k==0)) {
    retornar [];
  }
  var gram=[];
  var rhs=[];
  var i=0;
  enquanto((i<k)) {
    var row=[];
    var j=0;
    enquanto((j<k)) {
      var value=0;
      var sample=0;
      enquanto((sample<len(design))) {
        value=om_mod_0_check((value+(((design)[sample])[(active)[i]]*((design)[sample])[(active)[j]])));
        sample=(sample+1);
      }
      se((i==j)) {
        value=(value+ridge);
      }
      push(row,value);
      j=(j+1);
    }
    var value=0;
    var sample=0;
    enquanto((sample<len(design))) {
      value=om_mod_0_check((value+(((design)[sample])[(active)[i]]*(target)[sample])));
      sample=(sample+1);
    }
    push(gram,row);
    push(rhs,value);
    i=(i+1);
  }
  retornar om_mod_0_solve(gram,rhs);
}
funcao om_mod_17_library(points,exponents) {
  var out=[];
  var i=0;
  enquanto((i<len(points))) {
    var row=[];
    var j=0;
    enquanto((j<len(exponents))) {
      push(row,om_mod_13_poly_eval([[1,(exponents)[j]]],(points)[i]));
      j=(j+1);
    }
    push(out,row);
    i=(i+1);
  }
  retornar out;
}
funcao om_mod_17_squared_error(design,y,coefficients) {
  var total=0;
  var i=0;
  enquanto((i<len(y))) {
    var e=(om_mod_0_dot((design)[i],coefficients)-(y)[i]);
    total=om_mod_0_check((total+(e*e)));
    i=(i+1);
  }
  retornar total;
}
funcao om_mod_18_dual(g,phase_number) {
  var rows=len((g)["basic"]);
  var n=(len((g)["nonbasic"])-1);
  var objective=rows;
  se((phase_number==1)) {
    objective=(rows+1);
  }
  var y=om_mod_0_zeros(rows);
  var j=0;
  enquanto((j<=n)) {
    var label=((g)["nonbasic"])[j];
    se((label>=n)) {
      put(y,(label-n),(((g)["tableau"])[objective])[j]);
    }
    j=(j+1);
  }
  retornar y;
}
funcao om_mod_18_execute(r) {
  var matrix=om_mod_0_mat((r)["A"]);
  var b=om_mod_0_vector((r)["b"]);
  var c=om_mod_0_vector((r)["c"]);
  var rows=len(matrix);
  var n=len(c);
  se((((((rows>24)||(n<1))||(n>12))||(len((matrix)[0])!=n))||(len(b)!=rows))) {
    fail("LP dimension budget m<=24, n<=12");
  }
  var t=[];
  var basic=[];
  var nonbasic=[];
  var i=0;
  enquanto((i<rows)) {
    var row=slice((matrix)[i],0,n);
    push(row,(-1));
    push(row,(b)[i]);
    push(t,row);
    push(basic,(n+i));
    i=(i+1);
  }
  var objective=om_mod_0_scale(c,(-1));
  push(objective,0);
  push(objective,0);
  push(t,objective);
  var artificial=om_mod_0_zeros((n+2));
  put(artificial,n,1);
  push(t,artificial);
  i=0;
  enquanto((i<n)) {
    push(nonbasic,i);
    i=(i+1);
  }
  push(nonbasic,(-1));
  var g=obj();
  put(g,"tableau",t);
  put(g,"basic",basic);
  put(g,"nonbasic",nonbasic);
  put(g,"pivots",0);
  put(g,"limit",om_mod_0_integer(om_mod_0_num(r,"max_pivots",1000),1,4000));
  var minimum=0;
  i=1;
  enquanto((i<rows)) {
    se((((t)[i])[(n+1)]<((t)[minimum])[(n+1)])) {
      minimum=i;
    }
    i=(i+1);
  }
  se((((t)[minimum])[(n+1)]<0)) {
    om_mod_18_pivot(g,minimum,n);
    var unbounded=om_mod_18_phase(g,1);
    se((unbounded>=0)) {
      fail("Auxiliary simplex unexpectedly unbounded");
    }
    se((((t)[(rows+1)])[(n+1)]!=0)) {
      var y=om_mod_18_dual(g,1);
      var aty=om_mod_13_apply(om_mod_0_transpose(matrix),y);
      i=0;
      enquanto((i<len(y))) {
        se(((y)[i]<0)) {
          fail("Invalid Farkas dual sign");
        }
        i=(i+1);
      }
      i=0;
      enquanto((i<len(aty))) {
        se(((aty)[i]<0)) {
          fail("Invalid Farkas dual coefficients");
        }
        i=(i+1);
      }
      se((om_mod_0_dot(y,b)>=0)) {
        fail("Farkas contradiction certificate missing");
      }
      var out=om_mod_0_result("exact-two-phase-simplex",[]);
      put(out,"status","infeasible");
      put(out,"farkas",y);
      put(out,"contradiction",om_mod_0_dot(y,b));
      put(out,"pivots",(g)["pivots"]);
      retornar out;
    }
    i=0;
    enquanto((i<rows)) {
      se(((basic)[i]==(-1))) {
        var enter=(-1);
        var j=0;
        enquanto((j<=n)) {
          se(((((t)[i])[j]!=0)&&((nonbasic)[j]!=(-1)))) {
            se(((enter<0)||((nonbasic)[j]<(nonbasic)[enter]))) {
              enter=j;
            }
          }
          j=(j+1);
        }
        se((enter>=0)) {
          om_mod_18_pivot(g,i,enter);
        }
      }
      i=(i+1);
    }
  }
  var ray_column=om_mod_18_phase(g,2);
  var x=om_mod_0_zeros(n);
  i=0;
  enquanto((i<rows)) {
    se((((basic)[i]>=0)&&((basic)[i]<n))) {
      put(x,(basic)[i],((t)[i])[(n+1)]);
    }
    i=(i+1);
  }
  om_mod_18_feasible(matrix,b,x);
  var out=om_mod_0_result("exact-two-phase-simplex",x);
  put(out,"pivots",(g)["pivots"]);
  se((ray_column>=0)) {
    var direction=om_mod_0_zeros(n);
    se((((nonbasic)[ray_column]>=0)&&((nonbasic)[ray_column]<n))) {
      put(direction,(nonbasic)[ray_column],1);
    }
    i=0;
    enquanto((i<rows)) {
      se((((basic)[i]>=0)&&((basic)[i]<n))) {
        put(direction,(basic)[i],(-((t)[i])[ray_column]));
      }
      i=(i+1);
    }
    i=0;
    enquanto((i<n)) {
      se(((direction)[i]<0)) {
        fail("Unbounded ray nonnegativity failed");
      }
      i=(i+1);
    }
    var image=om_mod_13_apply(matrix,direction);
    i=0;
    enquanto((i<rows)) {
      se(((image)[i]>0)) {
        fail("Unbounded ray constraint failed");
      }
      i=(i+1);
    }
    se((om_mod_0_dot(c,direction)<=0)) {
      fail("Ray does not improve objective");
    }
    put(out,"status","unbounded");
    put(out,"ray",direction);
    retornar out;
  }
  var y=om_mod_18_dual(g,2);
  var aty=om_mod_13_apply(om_mod_0_transpose(matrix),y);
  i=0;
  enquanto((i<rows)) {
    se(((y)[i]<0)) {
      fail("Dual sign certificate failed");
    }
    i=(i+1);
  }
  i=0;
  enquanto((i<n)) {
    se(((aty)[i]<(c)[i])) {
      fail("Dual feasibility failed");
    }
    i=(i+1);
  }
  var optimum=om_mod_0_dot(c,x);
  se((optimum!=om_mod_0_dot(y,b))) {
    fail("Strong duality certificate failed");
  }
  put(out,"status","optimal");
  put(out,"objective",optimum);
  put(out,"dual",y);
  put(out,"duality_gap",0);
  retornar out;
}
funcao om_mod_18_feasible(matrix,b,x) {
  var i=0;
  enquanto((i<len(x))) {
    se(((x)[i]<0)) {
      fail("Negative primal certificate variable");
    }
    i=(i+1);
  }
  i=0;
  enquanto((i<len(matrix))) {
    se((om_mod_0_dot((matrix)[i],x)>(b)[i])) {
      fail("Primal certificate violates constraint");
    }
    i=(i+1);
  }
  retornar 1;
}
funcao om_mod_18_phase(g,phase_number) {
  var t=(g)["tableau"];
  var rows=len((g)["basic"]);
  var n=(len((g)["nonbasic"])-1);
  var objective=rows;
  se((phase_number==1)) {
    objective=(rows+1);
  }
  var running=1;
  enquanto(running) {
    var enter=(-1);
    var j=0;
    enquanto((j<=n)) {
      se((((phase_number==1)||(((g)["nonbasic"])[j]!=(-1)))&&(((t)[objective])[j]<0))) {
        se(((enter<0)||(((g)["nonbasic"])[j]<((g)["nonbasic"])[enter]))) {
          enter=j;
        }
      }
      j=(j+1);
    }
    se((enter<0)) {
      retornar (-1);
    }
    var leave=(-1);
    var i=0;
    enquanto((i<rows)) {
      se((((t)[i])[enter]>0)) {
        se((leave<0)) {
          leave=i;
        }
        senao {
          var ratio=(((t)[i])[(n+1)]/((t)[i])[enter]);
          var best=(((t)[leave])[(n+1)]/((t)[leave])[enter]);
          se(((ratio<best)||((ratio==best)&&(((g)["basic"])[i]<((g)["basic"])[leave])))) {
            leave=i;
          }
        }
      }
      i=(i+1);
    }
    se((leave<0)) {
      retornar enter;
    }
    om_mod_18_pivot(g,leave,enter);
  }
  retornar (-1);
}
funcao om_mod_18_pivot(g,row,column) {
  se(((g)["pivots"]>=(g)["limit"])) {
    fail("Simplex pivot budget exhausted; no SAT/UNSAT claim");
  }
  put(g,"pivots",((g)["pivots"]+1));
  var t=(g)["tableau"];
  var rows=len(t);
  var columns=len((t)[0]);
  var p=((t)[row])[column];
  se((p==0)) {
    fail("Zero simplex pivot");
  }
  var i=0;
  enquanto((i<rows)) {
    se((i!=row)) {
      var j=0;
      enquanto((j<columns)) {
        se((j!=column)) {
          put((t)[i],j,om_mod_0_check((((t)[i])[j]-((((t)[row])[j]*((t)[i])[column])/p))));
        }
        j=(j+1);
      }
    }
    i=(i+1);
  }
  var j=0;
  enquanto((j<columns)) {
    se((j!=column)) {
      put((t)[row],j,om_mod_0_check((((t)[row])[j]/p)));
    }
    j=(j+1);
  }
  i=0;
  enquanto((i<rows)) {
    se((i!=row)) {
      put((t)[i],column,om_mod_0_check(((-((t)[i])[column])/p)));
    }
    i=(i+1);
  }
  put((t)[row],column,(1/p));
  var old=((g)["basic"])[row];
  put((g)["basic"],row,((g)["nonbasic"])[column]);
  put((g)["nonbasic"],column,old);
  retornar 0;
}
funcao om_mod_19_analytic(a,op,order,radius,bits) {
  var input=a;
  var range=om_mod_19_interval_of(a,radius);
  var rho=om_mod_29_max(om_mod_29_abs((range)[0]),om_mod_29_abs((range)[1]));
  se((op=="log")) {
    input=om_mod_19_plus(a,om_mod_19_constant((-1),order),radius,bits);
    range=om_mod_19_interval_of(input,radius);
    rho=om_mod_29_max(om_mod_29_abs((range)[0]),om_mod_29_abs((range)[1]));
    se((rho>=1)) {
      fail("Taylor log requires |x-1|<1 on the full domain");
    }
  }
  se((rho>16)) {
    fail("Analytic Taylor expansion magnitude budget");
  }
  var out=om_mod_19_constant(0,order);
  var term=om_mod_19_constant(1,order);
  var factorial=1;
  var k=0;
  enquanto((k<=order)) {
    var coefficient=0;
    se((op=="exp")) {
      coefficient=(1/factorial);
    }
    se(((op=="sin")&&((k%2)==1))) {
      coefficient=(om_mod_0_power((-1),qfloor((k/2)))/factorial);
    }
    se(((op=="log")&&(k>0))) {
      coefficient=(om_mod_0_power((-1),(k+1))/k);
    }
    se((coefficient!=0)) {
      out=om_mod_19_plus(out,om_mod_19_scaled(term,coefficient,radius,bits),radius,bits);
    }
    term=om_mod_19_times(term,input,radius,bits);
    k=(k+1);
    factorial=(factorial*k);
  }
  var tail=(om_mod_0_power(rho,(order+1))/factorial);
  se((op=="exp")) {
    tail=(tail*(om_mod_29_exp_interval(rho,bits))[1]);
  }
  se((op=="log")) {
    tail=(om_mod_0_power(rho,(order+1))/((order+1)*(1-rho)));
  }
  put(out,"remainder",om_mod_1_add((out)["remainder"],[(-tail),tail]));
  retornar om_mod_19_bounded(out,radius,bits);
}
funcao om_mod_19_bounded(p,radius,bits) {
  var a=[];
  var error=0;
  var i=0;
  var unit=om_mod_0_power(2,bits);
  enquanto((i<len((p)["coefficients"]))) {
    var v=om_mod_0_check(((p)["coefficients"])[i]);
    var rounded=(qfloor((v*unit))/unit);
    error=(error+(om_mod_29_abs((v-rounded))*om_mod_0_power(radius,i)));
    push(a,rounded);
    i=(i+1);
  }
  var rem=om_mod_1_add((p)["remainder"],[(-error),error]);
  rem=[(qfloor(((rem)[0]*unit))/unit),((-qfloor(((-(rem)[1])*unit)))/unit)];
  om_mod_0_check((rem)[0]);
  om_mod_0_check((rem)[1]);
  retornar om_mod_19_model(a,rem);
}
funcao om_mod_19_constant(x,order) {
  var a=om_mod_0_zeros((order+1));
  put(a,0,x);
  retornar om_mod_19_model(a,[0,0]);
}
funcao om_mod_19_evaluate_ast(ast,center,radius,order,bits,depth,meter) {
  put(meter,0,((meter)[0]+1));
  se((((((depth>24)||((meter)[0]>256))||(!islist(ast)))||(len(ast)<1))||(!isstr((ast)[0])))) {
    fail("Taylor expression AST budget/shape");
  }
  var op=(ast)[0];
  se(((op=="const")&&(len(ast)==2))) {
    retornar om_mod_19_bounded(om_mod_19_constant(om_mod_0_val((ast)[1]),order),radius,bits);
  }
  se(((op=="var")&&(len(ast)==1))) {
    var a=om_mod_19_constant(center,order);
    put((a)["coefficients"],1,1);
    retornar om_mod_19_bounded(a,radius,bits);
  }
  se((((op=="add")||(op=="mul"))&&(len(ast)==3))) {
    var a=om_mod_19_evaluate_ast((ast)[1],center,radius,order,bits,(depth+1),meter);
    var b=om_mod_19_evaluate_ast((ast)[2],center,radius,order,bits,(depth+1),meter);
    se((op=="add")) {
      retornar om_mod_19_plus(a,b,radius,bits);
    }
    retornar om_mod_19_times(a,b,radius,bits);
  }
  se(((((op=="exp")||(op=="sin"))||(op=="log"))&&(len(ast)==2))) {
    retornar om_mod_19_analytic(om_mod_19_evaluate_ast((ast)[1],center,radius,order,bits,(depth+1),meter),op,order,radius,bits);
  }
  fail("Unsupported Taylor AST operation/arity");
  retornar 0;
}
funcao om_mod_19_execute(r) {
  var center=om_mod_0_q(r,"center");
  var radius=om_mod_0_nonnegative(om_mod_0_q(r,"radius"));
  var order=om_mod_0_count(r,"order",1,12);
  var bits=om_mod_0_integer(om_mod_0_num(r,"bits",48),8,128);
  se(((radius>16)||(om_mod_29_abs(center)>16))) {
    fail("Taylor domain magnitude budget");
  }
  var result=om_mod_19_evaluate_ast((r)["expression"],center,radius,order,bits,0,[0]);
  put(result,"range",om_mod_19_interval_of(result,radius));
  put(result,"center",center);
  put(result,"radius",radius);
  put(result,"model","quantized-univariate-Taylor-with-rational-remainder");
  put(result,"formal_admission",0);
  retornar result;
}
funcao om_mod_19_interval_of(p,radius) {
  var y=[0,0];
  var i=len((p)["coefficients"]);
  enquanto((i>0)) {
    i=(i-1);
    y=om_mod_1_add(om_mod_1_mul(y,[(-radius),radius]),om_mod_1_point(((p)["coefficients"])[i]));
  }
  retornar om_mod_1_add(y,(p)["remainder"]);
}
funcao om_mod_19_model(coefficients,remainder) {
  var r=obj();
  put(r,"coefficients",coefficients);
  put(r,"remainder",remainder);
  retornar r;
}
funcao om_mod_19_plus(a,b,radius,bits) {
  retornar om_mod_19_bounded(om_mod_19_model(om_mod_0_add((a)["coefficients"],(b)["coefficients"]),om_mod_1_add((a)["remainder"],(b)["remainder"])),radius,bits);
}
funcao om_mod_19_scaled(a,k,radius,bits) {
  retornar om_mod_19_bounded(om_mod_19_model(om_mod_0_scale((a)["coefficients"],k),om_mod_1_scale((a)["remainder"],k)),radius,bits);
}
funcao om_mod_19_times(a,b,radius,bits) {
  var ac=(a)["coefficients"];
  var bc=(b)["coefficients"];
  var order=(len(ac)-1);
  var coefficients=om_mod_0_zeros((order+1));
  var tail=0;
  var i=0;
  enquanto((i<=order)) {
    var j=0;
    enquanto((j<=order)) {
      var v=om_mod_0_check(((ac)[i]*(bc)[j]));
      se(((i+j)<=order)) {
        put(coefficients,(i+j),om_mod_0_check(((coefficients)[(i+j)]+v)));
      }
      senao {
        tail=(tail+(om_mod_29_abs(v)*om_mod_0_power(radius,(i+j))));
      }
      j=(j+1);
    }
    i=(i+1);
  }
  var ar=om_mod_19_interval_of(om_mod_19_model(ac,[0,0]),radius);
  var br=om_mod_19_interval_of(om_mod_19_model(bc,[0,0]),radius);
  var error=om_mod_1_add(om_mod_1_mul(ar,(b)["remainder"]),om_mod_1_mul(br,(a)["remainder"]));
  error=om_mod_1_add(error,om_mod_1_mul((a)["remainder"],(b)["remainder"]));
  retornar om_mod_19_bounded(om_mod_19_model(coefficients,om_mod_1_add(error,[(-tail),tail])),radius,bits);
}
funcao om_mod_20_amplitude(cores,indices) {
  se((len(indices)!=len(cores))) {
    fail("TT index dimension");
  }
  var state=[1];
  var k=0;
  enquanto((k<len(cores))) {
    var index=om_mod_0_integer((indices)[k],0,(len(((cores)[k])[0])-1));
    var next=om_mod_0_zeros(len((((cores)[k])[0])[0]));
    var i=0;
    enquanto((i<len(state))) {
      var j=0;
      enquanto((j<len(next))) {
        put(next,j,om_mod_0_check(((next)[j]+((state)[i]*((((cores)[k])[i])[index])[j]))));
        j=(j+1);
      }
      i=(i+1);
    }
    state=next;
    k=(k+1);
  }
  retornar (state)[0];
}
funcao om_mod_20_compress(r) {
  var dimensions=om_mod_0_vector((r)["dimensions"]);
  var values=om_mod_0_vector((r)["values"]);
  se(((len(dimensions)<1)||(len(dimensions)>8))) {
    fail("Dense TT order 1..8");
  }
  var size=1;
  var k=0;
  enquanto((k<len(dimensions))) {
    om_mod_0_integer((dimensions)[k],1,8);
    size=(size*(dimensions)[k]);
    se((size>1024)) {
      fail("Dense TT materialization budget 1024");
    }
    k=(k+1);
  }
  se((size!=len(values))) {
    fail("Dense tensor element count mismatch");
  }
  var cap=om_mod_0_integer(om_mod_0_num(r,"max_rank",8),1,8);
  var cores=[];
  var remaining=size;
  var previous=1;
  var remainder=[values];
  var exact_ranks=[];
  k=0;
  enquanto((k<(len(dimensions)-1))) {
    remaining=(remaining/(dimensions)[k]);
    var unfolding=[];
    var left=0;
    enquanto((left<previous)) {
      var s=0;
      enquanto((s<(dimensions)[k])) {
        push(unfolding,slice((remainder)[left],(s*remaining),((s+1)*remaining)));
        s=(s+1);
      }
      left=(left+1);
    }
    var split=om_mod_20_factor(unfolding,cap);
    var basis=(split)[0];
    remainder=(split)[1];
    push(exact_ranks,(split)[2]);
    var next=len(remainder);
    var core=[];
    left=0;
    enquanto((left<previous)) {
      var physical=[];
      var s=0;
      enquanto((s<(dimensions)[k])) {
        push(physical,(basis)[((left*(dimensions)[k])+s)]);
        s=(s+1);
      }
      push(core,physical);
      left=(left+1);
    }
    push(cores,core);
    previous=next;
    k=(k+1);
  }
  var last=[];
  var left=0;
  enquanto((left<previous)) {
    var physical=[];
    var s=0;
    enquanto((s<(dimensions)[k])) {
      push(physical,[((remainder)[left])[s]]);
      s=(s+1);
    }
    push(last,physical);
    left=(left+1);
  }
  push(cores,last);
  om_mod_20_train_read(cores);
  var residual=0;
  var reconstructed=[];
  var index=0;
  enquanto((index<size)) {
    var indices=om_mod_0_zeros(len(dimensions));
    var remaining_index=index;
    k=len(dimensions);
    enquanto((k>0)) {
      k=(k-1);
      put(indices,k,(remaining_index%(dimensions)[k]));
      remaining_index=qfloor((remaining_index/(dimensions)[k]));
    }
    var value=om_mod_20_amplitude(cores,indices);
    push(reconstructed,value);
    residual=om_mod_0_check((residual+((value-(values)[index])*(value-(values)[index]))));
    index=(index+1);
  }
  var out=om_mod_0_result("pivoted-rational-TT-with-exact-reconstruction-residual",cores);
  put(out,"unfolding_ranks",exact_ranks);
  put(out,"squared_Frobenius_error",residual);
  put(out,"exact",(residual==0));
  put(out,"dense_reconstruction",reconstructed);
  put(out,"squared_norm",om_mod_20_squared_norm(cores));
  put(out,"SVD_optimality_claimed",0);
  retornar out;
}
funcao om_mod_20_execute(r) {
  var mode=om_mod_0_text_field(r,"mode",24);
  se((mode=="compress")) {
    retornar om_mod_20_compress(r);
  }
  se((mode=="contract")) {
    var cores=om_mod_20_train_read((r)["cores"]);
    var out=om_mod_0_result("finite-bond-tensor-train-contraction",om_mod_20_squared_norm(cores));
    se(has(r,"indices")) {
      put(out,"amplitude",om_mod_20_amplitude(cores,om_mod_0_vector((r)["indices"])));
    }
    retornar out;
  }
  fail("TT mode compress or contract required");
  retornar 0;
}
funcao om_mod_20_factor(matrix,cap) {
  var reduced=om_mod_0_rref(matrix);
  var pivots=(reduced)["pivots"];
  var rank=om_mod_29_min(len(pivots),cap);
  se((rank==0)) {
    var basis=[];
    var i=0;
    enquanto((i<len(matrix))) {
      push(basis,[0]);
      i=(i+1);
    }
    retornar [basis,[om_mod_0_zeros(len((matrix)[0]))],0];
  }
  var basis=[];
  var i=0;
  enquanto((i<len(matrix))) {
    var row=[];
    var j=0;
    enquanto((j<rank)) {
      push(row,((matrix)[i])[(pivots)[j]]);
      j=(j+1);
    }
    push(basis,row);
    i=(i+1);
  }
  var transpose=om_mod_0_transpose(basis);
  var gram=om_mod_0_mul(transpose,basis);
  var remainder=om_mod_0_mul(om_mod_13_inverse(gram),om_mod_0_mul(transpose,matrix));
  retornar [basis,remainder,len(pivots)];
}
funcao om_mod_20_squared_norm(cores) {
  var transfer=[[1]];
  var k=0;
  enquanto((k<len(cores))) {
    var core=(cores)[k];
    var right=len(((core)[0])[0]);
    var next=[];
    var i=0;
    enquanto((i<right)) {
      var row=[];
      var j=0;
      enquanto((j<right)) {
        var value=0;
        var x=0;
        enquanto((x<len(core))) {
          var y=0;
          enquanto((y<len(core))) {
            var s=0;
            enquanto((s<len((core)[0]))) {
              value=om_mod_0_check((value+((((transfer)[x])[y]*(((core)[x])[s])[i])*(((core)[y])[s])[j])));
              s=(s+1);
            }
            y=(y+1);
          }
          x=(x+1);
        }
        push(row,value);
        j=(j+1);
      }
      push(next,row);
      i=(i+1);
    }
    transfer=next;
    k=(k+1);
  }
  retornar om_mod_0_nonnegative(((transfer)[0])[0]);
}
funcao om_mod_20_train_read(raw) {
  se((((!islist(raw))||(len(raw)<1))||(len(raw)>64))) {
    fail("Tensor train length 1..64");
  }
  var cores=[];
  var previous=1;
  var total=0;
  var k=0;
  enquanto((k<len(raw))) {
    var core=(raw)[k];
    se((((((!islist(core))||(len(core)!=previous))||(len(core)<1))||(len(core)>8))||(!islist((core)[0])))) {
      fail("TT left bond mismatch");
    }
    var physical=len((core)[0]);
    se((((physical<1)||(physical>8))||(!islist(((core)[0])[0])))) {
      fail("TT physical dimension 1..8");
    }
    var right=len(((core)[0])[0]);
    se(((right<1)||(right>8))) {
      fail("TT bond dimension 1..8");
    }
    var parsed=[];
    var i=0;
    enquanto((i<len(core))) {
      se(((!islist((core)[i]))||(len((core)[i])!=physical))) {
        fail("TT ragged physical axis");
      }
      var row=[];
      var s=0;
      enquanto((s<physical)) {
        var vector=om_mod_0_vector(((core)[i])[s]);
        se((len(vector)!=right)) {
          fail("TT ragged right bond");
        }
        total=(total+right);
        se((total>10000)) {
          fail("TT scalar storage budget");
        }
        push(row,vector);
        s=(s+1);
      }
      push(parsed,row);
      i=(i+1);
    }
    push(cores,parsed);
    previous=right;
    k=(k+1);
  }
  se((previous!=1)) {
    fail("Final TT bond must equal one");
  }
  retornar cores;
}
funcao om_mod_23_derive(raw,d) {
  om_mod_0_integer(d,1,3);
  var n=((3*d)+1);
  var lagrangian=om_mod_13_poly_extend(om_mod_13_poly_read(raw,((2*d)+1)),n);
  var momenta=[];
  var equations=[];
  var hessian=[];
  var cyclic=[];
  var energy=om_mod_13_poly_scale(lagrangian,(-1));
  var i=0;
  enquanto((i<d)) {
    var momentum=om_mod_13_poly_diff(lagrangian,(d+i));
    push(momenta,momentum);
    var equation=om_mod_13_poly_add(om_mod_23_total_derivative(momentum,d),om_mod_13_poly_scale(om_mod_13_poly_diff(lagrangian,i),(-1)));
    push(equations,equation);
    push(cyclic,(len(om_mod_13_poly_diff(lagrangian,i))==0));
    energy=om_mod_13_poly_add(energy,om_mod_13_poly_mul(om_mod_13_poly_var((d+i),n),momentum));
    var row=[];
    var j=0;
    enquanto((j<d)) {
      push(row,om_mod_13_poly_diff(momentum,(d+j)));
      j=(j+1);
    }
    push(hessian,row);
    i=(i+1);
  }
  var residual=om_mod_13_poly_add(om_mod_23_total_derivative(energy,d),om_mod_13_poly_diff(lagrangian,(2*d)));
  i=0;
  enquanto((i<d)) {
    residual=om_mod_13_poly_add(residual,om_mod_13_poly_scale(om_mod_13_poly_mul(om_mod_13_poly_var((d+i),n),(equations)[i]),(-1)));
    i=(i+1);
  }
  se((len(residual)!=0)) {
    fail("Internal polynomial Noether identity failed");
  }
  var rotations=[];
  i=0;
  enquanto((i<d)) {
    var j=(i+1);
    enquanto((j<d)) {
      var change=om_mod_13_poly_add(om_mod_13_poly_mul(om_mod_13_poly_var(i,n),om_mod_13_poly_diff(lagrangian,j)),om_mod_13_poly_scale(om_mod_13_poly_mul(om_mod_13_poly_var(j,n),om_mod_13_poly_diff(lagrangian,i)),(-1)));
      change=om_mod_13_poly_add(change,om_mod_13_poly_mul(om_mod_13_poly_var((d+i),n),om_mod_13_poly_diff(lagrangian,(d+j))));
      change=om_mod_13_poly_add(change,om_mod_13_poly_scale(om_mod_13_poly_mul(om_mod_13_poly_var((d+j),n),om_mod_13_poly_diff(lagrangian,(d+i))),(-1)));
      var charge=om_mod_13_poly_add(om_mod_13_poly_mul(om_mod_13_poly_var(i,n),(momenta)[j]),om_mod_13_poly_scale(om_mod_13_poly_mul(om_mod_13_poly_var(j,n),(momenta)[i]),(-1)));
      var rotation=obj();
      put(rotation,"plane",[i,j]);
      put(rotation,"variation",change);
      put(rotation,"invariant",(len(change)==0));
      put(rotation,"charge",charge);
      push(rotations,rotation);
      j=(j+1);
    }
    i=(i+1);
  }
  var out=om_mod_0_result("polynomial-Euler-Lagrange-and-off-shell-Noether",equations);
  put(out,"coordinates",d);
  put(out,"variables","q[0:d], v[0:d], t, acceleration[0:d]");
  put(out,"lagrangian",lagrangian);
  put(out,"momenta",momenta);
  put(out,"velocity_hessian",hessian);
  put(out,"energy",energy);
  put(out,"time_translation_invariant",(len(om_mod_13_poly_diff(lagrangian,(2*d)))==0));
  put(out,"cyclic_coordinates",cyclic);
  put(out,"rotation_symmetries",rotations);
  put(out,"noether_identity_residual",residual);
  put(out,"conservation_requires_EL_solution",1);
  retornar out;
}
funcao om_mod_23_execute(r) {
  retornar om_mod_23_derive((r)["lagrangian"],om_mod_0_count(r,"coordinates",1,3));
}
funcao om_mod_23_total_derivative(p,d) {
  var n=((3*d)+1);
  var result=om_mod_13_poly_diff(p,(2*d));
  var j=0;
  enquanto((j<d)) {
    result=om_mod_13_poly_add(result,om_mod_13_poly_mul(om_mod_13_poly_diff(p,j),om_mod_13_poly_var((d+j),n)));
    result=om_mod_13_poly_add(result,om_mod_13_poly_mul(om_mod_13_poly_diff(p,(d+j)),om_mod_13_poly_var((((2*d)+1)+j),n)));
    j=(j+1);
  }
  retornar result;
}
funcao om_mod_21_energy(potential,q,p,mass) {
  var e=om_mod_13_poly_eval(potential,q);
  var i=0;
  enquanto((i<len(q))) {
    e=om_mod_0_check((e+(((p)[i]*(p)[i])/(2*(mass)[i]))));
    i=(i+1);
  }
  retornar e;
}
funcao om_mod_21_execute(r) {
  var mode=om_mod_0_text_field(r,"mode",24);
  se((mode=="simulate")) {
    retornar om_mod_21_simulate(r);
  }
  se((mode=="derive")) {
    retornar om_mod_23_derive((r)["lagrangian"],om_mod_0_count(r,"coordinates",1,3));
  }
  se((mode=="dec")) {
    retornar om_mod_21_exterior(r);
  }
  fail("Action engine mode must be simulate, derive or dec");
  retornar 0;
}
funcao om_mod_21_exterior(r) {
  var vertices=om_mod_0_count(r,"vertices",1,8);
  var facets=(r)["simplices"];
  se((((!islist(facets))||(len(facets)<1))||(len(facets)>16))) {
    fail("Simplicial facet budget 1..16");
  }
  var cells=[[],[],[],[]];
  var i=0;
  var top=0;
  enquanto((i<vertices)) {
    push((cells)[0],[i]);
    i=(i+1);
  }
  i=0;
  enquanto((i<len(facets))) {
    var facet=om_mod_0_vector((facets)[i]);
    var d=len(facet);
    se(((d<1)||(d>4))) {
      fail("Simplices must have 1..4 vertices");
    }
    top=om_mod_29_max(top,(d-1));
    var j=0;
    enquanto((j<d)) {
      om_mod_0_integer((facet)[j],0,(vertices-1));
      se(((j>0)&&((facet)[j]<=(facet)[(j-1)]))) {
        fail("Use canonical strictly increasing simplex orientation");
      }
      j=(j+1);
    }
    var mask=1;
    enquanto((mask<om_mod_0_power(2,d))) {
      var face=[];
      j=0;
      enquanto((j<d)) {
        se(((qfloor((mask/om_mod_0_power(2,j)))%2)==1)) {
          push(face,(facet)[j]);
        }
        j=(j+1);
      }
      se((om_mod_21_index_of((cells)[(len(face)-1)],face)<0)) {
        push((cells)[(len(face)-1)],face);
      }
      mask=(mask+1);
    }
    i=(i+1);
  }
  var boundaries=[];
  var degree=1;
  enquanto((degree<=top)) {
    var boundary=[];
    i=0;
    enquanto((i<len((cells)[(degree-1)]))) {
      push(boundary,om_mod_0_zeros(len((cells)[degree])));
      i=(i+1);
    }
    i=0;
    enquanto((i<len((cells)[degree]))) {
      var j=0;
      enquanto((j<=degree)) {
        var face=[];
        var k=0;
        enquanto((k<=degree)) {
          se((k!=j)) {
            push(face,(((cells)[degree])[i])[k]);
          }
          k=(k+1);
        }
        put((boundary)[om_mod_21_index_of((cells)[(degree-1)],face)],i,om_mod_0_power((-1),j));
        j=(j+1);
      }
      i=(i+1);
    }
    push(boundaries,boundary);
    degree=(degree+1);
  }
  degree=1;
  enquanto((degree<len(boundaries))) {
    var composed=om_mod_0_mul((boundaries)[(degree-1)],(boundaries)[degree]);
    i=0;
    enquanto((i<len(composed))) {
      se((om_mod_13_norm2((composed)[i])!=0)) {
        fail("Boundary squared is not zero");
      }
      i=(i+1);
    }
    degree=(degree+1);
  }
  var out=om_mod_0_result("finite-oriented-simplicial-exterior-calculus",boundaries);
  put(out,"cells",slice(cells,0,(top+1)));
  put(out,"boundary_squared_zero_checked",1);
  se(has(r,"form")) {
    degree=om_mod_0_count(r,"degree",0,top);
    var form=om_mod_0_vector((r)["form"]);
    se((len(form)!=len((cells)[degree]))) {
      fail("Cochain dimension mismatch");
    }
    var derivative=[];
    se((degree<top)) {
      derivative=om_mod_13_apply(om_mod_0_transpose((boundaries)[degree]),form);
    }
    put(out,"exterior_derivative",derivative);
    se(((degree+1)<top)) {
      put(out,"second_exterior_derivative",om_mod_13_apply(om_mod_0_transpose((boundaries)[(degree+1)]),derivative));
    }
  }
  retornar out;
}
funcao om_mod_21_gradient(p,q) {
  var g=[];
  var i=0;
  enquanto((i<len(q))) {
    push(g,om_mod_13_poly_eval(om_mod_13_poly_diff(p,i),q));
    i=(i+1);
  }
  retornar g;
}
funcao om_mod_21_hessian(p,q) {
  var h=[];
  var i=0;
  enquanto((i<len(q))) {
    var row=[];
    var j=0;
    enquanto((j<len(q))) {
      push(row,om_mod_13_poly_eval(om_mod_13_poly_diff(om_mod_13_poly_diff(p,i),j),q));
      j=(j+1);
    }
    push(h,row);
    i=(i+1);
  }
  retornar h;
}
funcao om_mod_21_index_of(cells,cell) {
  var i=0;
  enquanto((i<len(cells))) {
    se(om_mod_13_same((cells)[i],cell)) {
      retornar i;
    }
    i=(i+1);
  }
  retornar (-1);
}
funcao om_mod_21_simulate(r) {
  var q=om_mod_0_vector((r)["position"]);
  var p=om_mod_0_vector((r)["momentum"]);
  var mass=om_mod_0_vector((r)["mass"]);
  var d=len(q);
  var steps=om_mod_0_count(r,"steps",1,256);
  var h=om_mod_0_positive(om_mod_0_q(r,"dt"));
  se(((((d<1)||(d>3))||(len(p)!=d))||(len(mass)!=d))) {
    fail("Separable mechanical system dimensions 1..3");
  }
  var potential=om_mod_13_poly_read((r)["potential"],d);
  var i=0;
  enquanto((i<d)) {
    om_mod_0_positive((mass)[i]);
    i=(i+1);
  }
  var initial=om_mod_21_energy(potential,q,p,mass);
  var trace=[];
  var positions=[slice(q,0,d)];
  var jacobian=[];
  var k=0;
  var maximum_drift=0;
  enquanto((k<steps)) {
    var g=om_mod_21_gradient(potential,q);
    var half=[];
    var nextq=[];
    i=0;
    enquanto((i<d)) {
      push(half,om_mod_0_check(((p)[i]-((h*(g)[i])/2))));
      push(nextq,om_mod_0_check(((q)[i]+((h*(half)[i])/(mass)[i]))));
      i=(i+1);
    }
    var nextg=om_mod_21_gradient(potential,nextq);
    var nextp=[];
    i=0;
    enquanto((i<d)) {
      push(nextp,om_mod_0_check(((half)[i]-((h*(nextg)[i])/2))));
      i=(i+1);
    }
    se((k==0)) {
      jacobian=om_mod_21_symplectic_jacobian(potential,q,nextq,mass,h);
    }
    q=nextq;
    p=nextp;
    push(positions,slice(q,0,d));
    var e=om_mod_21_energy(potential,q,p,mass);
    maximum_drift=om_mod_29_max(maximum_drift,om_mod_29_abs((e-initial)));
    push(trace,[q,p,e]);
    k=(k+1);
  }
  var residuals=[];
  k=1;
  enquanto((k<steps)) {
    var g=om_mod_21_gradient(potential,(positions)[k]);
    var residual=[];
    i=0;
    enquanto((i<d)) {
      var equation=om_mod_0_check(((((mass)[i]*(((2*((positions)[k])[i])-((positions)[(k-1)])[i])-((positions)[(k+1)])[i]))/h)-(h*(g)[i])));
      se((equation!=0)) {
        fail("Discrete Euler-Lagrange residual failed");
      }
      push(residual,equation);
      i=(i+1);
    }
    push(residuals,residual);
    k=(k+1);
  }
  var out=om_mod_0_result("separable-polynomial-variational-Verlet",trace);
  put(out,"position",q);
  put(out,"momentum",p);
  put(out,"initial_energy",initial);
  put(out,"physical_energy_drift",(om_mod_21_energy(potential,q,p,mass)-initial));
  put(out,"maximum_energy_drift",maximum_drift);
  put(out,"jacobian_at_initial_state",jacobian);
  put(out,"symplectic_identity_checked",1);
  put(out,"DEL_residuals",residuals);
  put(out,"general_energy_preservation_claimed",0);
  retornar out;
}
funcao om_mod_21_symplectic_jacobian(potential,q,nextq,mass,h) {
  var d=len(q);
  var kick1=om_mod_0_eye((2*d));
  var kick2=om_mod_0_eye((2*d));
  var drift=om_mod_0_eye((2*d));
  var h1=om_mod_21_hessian(potential,q);
  var h2=om_mod_21_hessian(potential,nextq);
  var i=0;
  var form=[];
  enquanto((i<(2*d))) {
    push(form,om_mod_0_zeros((2*d)));
    i=(i+1);
  }
  i=0;
  enquanto((i<d)) {
    put((drift)[i],(d+i),(h/(mass)[i]));
    put((form)[i],(d+i),1);
    put((form)[(d+i)],i,(-1));
    var j=0;
    enquanto((j<d)) {
      put((kick1)[(d+i)],j,(((-h)*((h1)[i])[j])/2));
      put((kick2)[(d+i)],j,(((-h)*((h2)[i])[j])/2));
      j=(j+1);
    }
    i=(i+1);
  }
  var jacobian=om_mod_0_mul(kick2,om_mod_0_mul(drift,kick1));
  var preserved=om_mod_0_mul(om_mod_0_transpose(jacobian),om_mod_0_mul(form,jacobian));
  i=0;
  enquanto((i<(2*d))) {
    se((!om_mod_13_same((preserved)[i],(form)[i]))) {
      fail("Verlet symplectic identity failed");
    }
    i=(i+1);
  }
  retornar jacobian;
}
funcao om_mod_22_counts(raw,n) {
  var values=om_mod_0_vector(raw);
  se((len(values)!=n)) {
    fail("Chemical multiset shape");
  }
  var i=0;
  enquanto((i<n)) {
    om_mod_0_integer((values)[i],0,1000000000);
    i=(i+1);
  }
  retornar values;
}
funcao om_mod_22_execute(r) {
  var mode=om_mod_0_text_field(r,"mode",24);
  se((mode=="reactions")) {
    retornar om_mod_22_reactions(r);
  }
  se((mode=="repair")) {
    retornar om_mod_22_repair(r);
  }
  fail("Constructor mode reactions or repair required");
  retornar 0;
}
funcao om_mod_22_reactions(r) {
  var names=(r)["species"];
  se((((!islist(names))||(len(names)<1))||(len(names)>16))) {
    fail("Abstract chemistry species 1..16");
  }
  var n=len(names);
  var i=0;
  enquanto((i<n)) {
    se((((!isstr((names)[i]))||(len((names)[i])<1))||(len((names)[i])>64))) {
      fail("Species label required");
    }
    var j=0;
    enquanto((j<i)) {
      se(((names)[i]==(names)[j])) {
        fail("Duplicate species label");
      }
      j=(j+1);
    }
    i=(i+1);
  }
  var state=om_mod_22_counts((r)["state"],n);
  var capacity=om_mod_22_counts((r)["capacities"],n);
  var conservation=om_mod_0_mat((r)["conservation"]);
  se(((len(conservation)>8)||(len((conservation)[0])!=n))) {
    fail("Conservation matrix shape");
  }
  i=0;
  enquanto((i<n)) {
    om_mod_0_positive(((conservation)[0])[i]);
    se(((state)[i]>(capacity)[i])) {
      fail("Initial population exceeds capacity");
    }
    i=(i+1);
  }
  var raw=(r)["rules"];
  se((((!islist(raw))||(len(raw)<1))||(len(raw)>32))) {
    fail("Catalytic rule budget 1..32");
  }
  var rules=[];
  i=0;
  enquanto((i<len(raw))) {
    var consume=om_mod_22_counts(((raw)[i])["consume"],n);
    var produce=om_mod_22_counts(((raw)[i])["produce"],n);
    var catalyst=om_mod_22_counts(((raw)[i])["catalyst"],n);
    var change=om_mod_0_add(produce,om_mod_0_scale(consume,(-1)));
    se((om_mod_13_norm2(change)==0)) {
      fail("No-op reaction is not a productive constructor");
    }
    se((om_mod_13_norm2(om_mod_13_apply(conservation,change))!=0)) {
      fail("Reaction violates a declared conserved quantity");
    }
    push(rules,[consume,produce,catalyst,change]);
    i=(i+1);
  }
  var initial=om_mod_13_apply(conservation,state);
  var trace=[];
  var limit=om_mod_0_count(r,"max_events",1,512);
  var step=0;
  var quiescent=0;
  enquanto(((step<limit)&&(!quiescent))) {
    var selected=(-1);
    i=0;
    enquanto(((i<len(rules))&&(selected<0))) {
      var enabled=1;
      var j=0;
      enquanto((j<n)) {
        se((((state)[j]<((((rules)[i])[0])[j]+(((rules)[i])[2])[j]))||(((state)[j]+(((rules)[i])[3])[j])>(capacity)[j]))) {
          enabled=0;
        }
        j=(j+1);
      }
      se(enabled) {
        selected=i;
      }
      i=(i+1);
    }
    se((selected<0)) {
      quiescent=1;
    }
    senao {
      state=om_mod_0_add(state,((rules)[selected])[3]);
      se((!om_mod_13_same(om_mod_13_apply(conservation,state),initial))) {
        fail("Conservation ledger corrupted");
      }
      push(trace,[selected,slice(state,0,n)]);
      step=(step+1);
    }
  }
  var out=om_mod_0_result("bounded-conservative-catalytic-Petri-net",state);
  put(out,"trace",trace);
  put(out,"conserved_totals",initial);
  put(out,"quiescent",quiescent);
  put(out,"event_budget_exhausted",((!quiescent)&&(step==limit)));
  put(out,"physical_life_claimed",0);
  retornar out;
}
funcao om_mod_22_repair(r) {
  var blueprint=om_mod_0_text_field(r,"blueprint",65536);
  var candidate=om_mod_0_text_field(r,"candidate",65536);
  var expected=om_mod_0_text_field(r,"expected_sha256",64);
  se(((len(expected)!=64)||(sha256(blueprint)!=expected))) {
    fail("Blueprint does not match the externally supplied trust anchor");
  }
  var good=(sha256(candidate)==expected);
  var out=om_mod_0_result("content-addressed-repair-proposal",blueprint);
  put(out,"repair_needed",(!good));
  put(out,"candidate_sha256",sha256(candidate));
  put(out,"blueprint_sha256",expected);
  put(out,"applied",0);
  put(out,"trust_anchor_authenticated",0);
  retornar out;
}
funcao om_mod_24_backdoor_separated(nodes,k,x,y,z) {
  var n=len(nodes);
  var size=(n+k);
  var graph=om_mod_24_zero_matrix(size);
  var i=0;
  enquanto((i<n)) {
    var j=0;
    enquanto((j<len(((nodes)[i])[0]))) {
      put((graph)[(((nodes)[i])[0])[j]],i,1);
      j=(j+1);
    }
    se((((nodes)[i])[1]>=0)) {
      put((graph)[(n+((nodes)[i])[1])],i,1);
    }
    i=(i+1);
  }
  var reachable=om_mod_0_copy(graph);
  var middle=0;
  enquanto((middle<size)) {
    i=0;
    enquanto((i<size)) {
      var j=0;
      enquanto((j<size)) {
        se((((reachable)[i])[middle]&&((reachable)[middle])[j])) {
          put((reachable)[i],j,1);
        }
        j=(j+1);
      }
      i=(i+1);
    }
    middle=(middle+1);
  }
  i=0;
  enquanto((i<len(z))) {
    se(((((z)[i]==x)||((z)[i]==y))||((reachable)[x])[(z)[i]])) {
      fail("Backdoor controls cannot include treatment, outcome or descendants of treatment");
    }
    i=(i+1);
  }
  put(graph,x,om_mod_0_zeros(size));
  var ancestors=om_mod_0_zeros(size);
  put(ancestors,x,1);
  put(ancestors,y,1);
  i=0;
  enquanto((i<len(z))) {
    put(ancestors,(z)[i],1);
    i=(i+1);
  }
  var pass=0;
  enquanto((pass<size)) {
    i=0;
    enquanto((i<size)) {
      var j=0;
      enquanto((j<size)) {
        se((((graph)[i])[j]&&(ancestors)[j])) {
          put(ancestors,i,1);
        }
        j=(j+1);
      }
      i=(i+1);
    }
    pass=(pass+1);
  }
  var moral=om_mod_24_zero_matrix(size);
  var child=0;
  enquanto((child<size)) {
    se((ancestors)[child]) {
      var parents=[];
      i=0;
      enquanto((i<size)) {
        se((((graph)[i])[child]&&(ancestors)[i])) {
          push(parents,i);
          put((moral)[i],child,1);
          put((moral)[child],i,1);
        }
        i=(i+1);
      }
      i=0;
      enquanto((i<len(parents))) {
        var j=0;
        enquanto((j<i)) {
          put((moral)[(parents)[i]],(parents)[j],1);
          put((moral)[(parents)[j]],(parents)[i],1);
          j=(j+1);
        }
        i=(i+1);
      }
    }
    child=(child+1);
  }
  var blocked=om_mod_0_zeros(size);
  i=0;
  enquanto((i<len(z))) {
    put(blocked,(z)[i],1);
    i=(i+1);
  }
  var seen=om_mod_0_zeros(size);
  put(seen,x,1);
  var queue=[x];
  var position=0;
  enquanto((position<len(queue))) {
    var current=(queue)[position];
    i=0;
    enquanto((i<size)) {
      se(((((moral)[current])[i]&&(!(blocked)[i]))&&(!(seen)[i]))) {
        put(seen,i,1);
        push(queue,i);
      }
      i=(i+1);
    }
    position=(position+1);
  }
  retornar (!(seen)[y]);
}
funcao om_mod_24_evaluate(nodes,noise,intervention) {
  var values=[];
  var i=0;
  enquanto((i<len(nodes))) {
    se(((intervention)[i]>=0)) {
      push(values,(intervention)[i]);
    }
    senao {
      var index=0;
      var j=0;
      enquanto((j<len(((nodes)[i])[0]))) {
        index=((2*index)+(values)[(((nodes)[i])[0])[j]]);
        j=(j+1);
      }
      se((((nodes)[i])[1]>=0)) {
        index=((2*index)+(noise)[((nodes)[i])[1]]);
      }
      push(values,(((nodes)[i])[2])[index]);
    }
    i=(i+1);
  }
  retornar values;
}
funcao om_mod_24_event_mask(raw,n) {
  var mask=[];
  var i=0;
  enquanto((i<n)) {
    push(mask,(-1));
    i=(i+1);
  }
  se(((!islist(raw))||(len(raw)>n))) {
    fail("Causal event list budget");
  }
  i=0;
  enquanto((i<len(raw))) {
    var pair=om_mod_0_vector((raw)[i]);
    se((len(pair)!=2)) {
      fail("Causal event [node,binary value]");
    }
    var node=om_mod_0_integer((pair)[0],0,(n-1));
    var value=om_mod_0_integer((pair)[1],0,1);
    se(((mask)[node]!=(-1))) {
      fail("Duplicate causal event variable");
    }
    put(mask,node,value);
    i=(i+1);
  }
  retornar mask;
}
funcao om_mod_24_execute(r) {
  var raw=(r)["nodes"];
  var worlds_raw=(r)["noise_worlds"];
  se(((((((!islist(raw))||(len(raw)<1))||(len(raw)>12))||(!islist(worlds_raw)))||(len(worlds_raw)<1))||(len(worlds_raw)>256))) {
    fail("SCM node/world budget");
  }
  var worlds=[];
  var probabilities=[];
  var k=len(((worlds_raw)[0])["values"]);
  om_mod_0_integer(k,1,8);
  var i=0;
  enquanto((i<len(worlds_raw))) {
    var values=om_mod_0_vector(((worlds_raw)[i])["values"]);
    se((len(values)!=k)) {
      fail("Exogenous world dimension mismatch");
    }
    var j=0;
    enquanto((j<k)) {
      om_mod_0_integer((values)[j],0,1);
      j=(j+1);
    }
    j=0;
    enquanto((j<i)) {
      se(om_mod_13_same(values,(worlds)[j])) {
        fail("Duplicate exogenous world");
      }
      j=(j+1);
    }
    push(worlds,values);
    push(probabilities,om_mod_0_q((worlds_raw)[i],"probability"));
    i=(i+1);
  }
  om_mod_13_probability(probabilities);
  var nodes=[];
  i=0;
  enquanto((i<len(raw))) {
    var parents=om_mod_0_vector(((raw)[i])["parents"]);
    var noise=om_mod_0_integer(om_mod_0_num((raw)[i],"noise",(-1)),(-1),(k-1));
    var j=0;
    se((len(parents)>8)) {
      fail("SCM parent budget");
    }
    enquanto((j<len(parents))) {
      om_mod_0_integer((parents)[j],0,(i-1));
      var previous=0;
      enquanto((previous<j)) {
        se(((parents)[previous]==(parents)[j])) {
          fail("Duplicate causal parent");
        }
        previous=(previous+1);
      }
      j=(j+1);
    }
    var table=om_mod_0_vector(((raw)[i])["table"]);
    var width=len(parents);
    se((noise>=0)) {
      width=(width+1);
    }
    se((len(table)!=om_mod_0_power(2,width))) {
      fail("SCM truth-table arity mismatch");
    }
    j=0;
    enquanto((j<len(table))) {
      om_mod_0_integer((table)[j],0,1);
      j=(j+1);
    }
    push(nodes,[parents,noise,table]);
    i=(i+1);
  }
  var n=len(nodes);
  var mode=om_mod_0_text_field(r,"mode",24);
  se((mode=="backdoor")) {
    om_mod_24_independent_noise(worlds,probabilities,k);
    var x=om_mod_0_count(r,"treatment",0,(n-1));
    var y=om_mod_0_count(r,"outcome",0,(n-1));
    var value=om_mod_0_count(r,"value",0,1);
    var z=om_mod_0_vector((r)["controls"]);
    se(((len(z)>6)||(x==y))) {
      fail("Backdoor control budget / distinct X,Y");
    }
    i=0;
    enquanto((i<len(z))) {
      om_mod_0_integer((z)[i],0,(n-1));
      var j=0;
      enquanto((j<i)) {
        se(((z)[i]==(z)[j])) {
          fail("Duplicate backdoor control");
        }
        j=(j+1);
      }
      i=(i+1);
    }
    se((!om_mod_24_backdoor_separated(nodes,k,x,y,z))) {
      fail("Controls fail the backdoor separation criterion");
    }
    var none=om_mod_24_event_mask([],n);
    var adjustment=0;
    var code=0;
    enquanto((code<om_mod_0_power(2,len(z)))) {
      var pz=0;
      var pxz=0;
      var pyxz=0;
      i=0;
      enquanto((i<len(worlds))) {
        var observed=om_mod_24_evaluate(nodes,(worlds)[i],none);
        var matched=1;
        var j=0;
        enquanto((j<len(z))) {
          se(((observed)[(z)[j]]!=(qfloor((code/om_mod_0_power(2,j)))%2))) {
            matched=0;
          }
          j=(j+1);
        }
        se(matched) {
          pz=(pz+(probabilities)[i]);
          se(((observed)[x]==value)) {
            pxz=(pxz+(probabilities)[i]);
            se(((observed)[y]==1)) {
              pyxz=(pyxz+(probabilities)[i]);
            }
          }
        }
        i=(i+1);
      }
      se((pz>0)) {
        se((pxz==0)) {
          fail("Backdoor adjustment positivity fails");
        }
        adjustment=(adjustment+((pz*pyxz)/pxz));
      }
      code=(code+1);
    }
    var intervention=om_mod_24_event_mask([[x,value]],n);
    var direct=0;
    i=0;
    enquanto((i<len(worlds))) {
      se(((om_mod_24_evaluate(nodes,(worlds)[i],intervention))[y]==1)) {
        direct=(direct+(probabilities)[i]);
      }
      i=(i+1);
    }
    se((direct!=adjustment)) {
      fail("Backdoor formula disagrees with declared SCM");
    }
    var out=om_mod_0_result("graph-checked-finite-backdoor-adjustment",[(1-adjustment),adjustment]);
    put(out,"interventional_probability",direct);
    retornar out;
  }
  se((mode!="query")) {
    fail("Causal mode query or backdoor required");
  }
  var do_raw=[];
  var evidence_raw=[];
  se(has(r,"interventions")) {
    do_raw=(r)["interventions"];
  }
  se(has(r,"evidence")) {
    evidence_raw=(r)["evidence"];
  }
  var intervention=om_mod_24_event_mask(do_raw,n);
  var evidence=om_mod_24_event_mask(evidence_raw,n);
  var query=om_mod_0_count(r,"query",0,(n-1));
  var alternate=intervention;
  se(has(r,"counterfactual")) {
    alternate=om_mod_24_event_mask((r)["counterfactual"],n);
  }
  var mass=0;
  var distribution=[0,0];
  var posterior=[];
  i=0;
  enquanto((i<len(worlds))) {
    var factual=om_mod_24_evaluate(nodes,(worlds)[i],intervention);
    var weight=0;
    se(om_mod_24_matches(factual,evidence)) {
      weight=(probabilities)[i];
      var predicted=om_mod_24_evaluate(nodes,(worlds)[i],alternate);
      put(distribution,(predicted)[query],((distribution)[(predicted)[query]]+weight));
      mass=(mass+weight);
    }
    push(posterior,weight);
    i=(i+1);
  }
  se((mass==0)) {
    fail("Causal evidence is impossible under the supplied SCM");
  }
  var out=om_mod_0_result("exact-finite-SCM-abduction-action-prediction",om_mod_0_scale(distribution,(1/mass)));
  put(out,"evidence_probability",mass);
  put(out,"posterior_noise_worlds",om_mod_0_scale(posterior,(1/mass)));
  put(out,"counterfactual",has(r,"counterfactual"));
  put(out,"empirical_causal_graph_verified",0);
  retornar out;
}
funcao om_mod_24_independent_noise(worlds,probabilities,k) {
  var marginals=om_mod_0_zeros(k);
  var i=0;
  enquanto((i<len(worlds))) {
    var j=0;
    enquanto((j<k)) {
      put(marginals,j,((marginals)[j]+((probabilities)[i]*((worlds)[i])[j])));
      j=(j+1);
    }
    i=(i+1);
  }
  var code=0;
  enquanto((code<om_mod_0_power(2,k))) {
    var bits=[];
    var j=0;
    var product=1;
    enquanto((j<k)) {
      var bit=(qfloor((code/om_mod_0_power(2,j)))%2);
      push(bits,bit);
      se(bit) {
        product=(product*(marginals)[j]);
      }
      senao {
        product=(product*(1-(marginals)[j]));
      }
      j=(j+1);
    }
    var actual=0;
    i=0;
    enquanto((i<len(worlds))) {
      se(om_mod_13_same(bits,(worlds)[i])) {
        actual=(actual+(probabilities)[i]);
      }
      i=(i+1);
    }
    se((product!=actual)) {
      fail("Graph backdoor checking requires independent exogenous roots");
    }
    code=(code+1);
  }
  retornar 1;
}
funcao om_mod_24_matches(values,event) {
  var i=0;
  enquanto((i<len(event))) {
    se((((event)[i]>=0)&&((values)[i]!=(event)[i]))) {
      retornar 0;
    }
    i=(i+1);
  }
  retornar 1;
}
funcao om_mod_24_zero_matrix(n) {
  var matrix=[];
  var i=0;
  enquanto((i<n)) {
    push(matrix,om_mod_0_zeros(n));
    i=(i+1);
  }
  retornar matrix;
}
funcao om_mod_25_execute(r) {
  var keys=om_mod_0_mat((r)["keys"]);
  var values=om_mod_0_mat((r)["values"]);
  var capacity=om_mod_0_count(r,"capacity",1,32);
  se(((((len(keys)!=len(values))||(len(keys)>capacity))||(len((keys)[0])>16))||(len((values)[0])>16))) {
    fail("Finite associative bank shape/capacity");
  }
  var evicted=0;
  se(has(r,"new_key")) {
    var key=om_mod_0_vector((r)["new_key"]);
    var value=om_mod_0_vector((r)["new_value"]);
    se(((len(key)!=len((keys)[0]))||(len(value)!=len((values)[0])))) {
      fail("Associative insertion shape");
    }
    se((len(keys)==capacity)) {
      keys=slice(keys,1,len(keys));
      values=slice(values,1,len(values));
      evicted=1;
    }
    push(keys,key);
    push(values,value);
  }
  var state=om_mod_0_vector((r)["state"]);
  var input=om_mod_0_vector((r)["input"]);
  var transition=om_mod_0_mat((r)["transition"]);
  var input_map=om_mod_0_mat((r)["input_map"]);
  var query_map=om_mod_0_mat((r)["query_map"]);
  var n=len(state);
  se(((((((((n<1)||(n>16))||(len(transition)!=n))||(len((transition)[0])!=n))||(len(input_map)!=n))||(len((input_map)[0])!=len(input)))||(len(query_map)!=len((keys)[0])))||(len((query_map)[0])!=n))) {
    fail("SSM dimensions");
  }
  var norm=0;
  var i=0;
  enquanto((i<n)) {
    var row_sum=0;
    var j=0;
    enquanto((j<n)) {
      row_sum=(row_sum+om_mod_29_abs(((transition)[i])[j]));
      j=(j+1);
    }
    norm=om_mod_29_max(norm,row_sum);
    i=(i+1);
  }
  se((norm>1)) {
    fail("SSM recurrent infinity norm must be <=1");
  }
  var next=om_mod_0_add(om_mod_13_apply(transition,state),om_mod_13_apply(input_map,input));
  var query=om_mod_13_apply(query_map,next);
  var beta=om_mod_0_nonnegative(om_mod_0_q(r,"beta"));
  var bits=om_mod_0_integer(om_mod_0_num(r,"bits",40),12,80);
  var iterations=om_mod_0_integer(om_mod_0_num(r,"iterations",1),1,32);
  var damping=om_mod_0_num(r,"damping",0);
  se(((damping<0)||(damping>=1))) {
    fail("Hopfield damping must lie in [0,1)");
  }
  var tolerance=om_mod_0_nonnegative(om_mod_0_num(r,"tolerance",0));
  var step=0;
  var converged=0;
  enquanto(((step<iterations)&&(!converged))) {
    var retrieved=om_mod_25_retrieve(keys,values,query,beta,bits);
    var newquery=om_mod_0_add(om_mod_0_scale(query,damping),om_mod_0_scale((retrieved)["key_midpoint"],(1-damping)));
    converged=(om_mod_13_maxabs(om_mod_0_add(newquery,om_mod_0_scale(query,(-1))))<=tolerance);
    query=newquery;
    step=(step+1);
  }
  var out=om_mod_25_retrieve(keys,values,query,beta,bits);
  put(out,"model","finite-Hopfield-bank-and-bounded-linear-SSM");
  put(out,"state",next);
  put(out,"query",query);
  put(out,"keys",keys);
  put(out,"values",values);
  put(out,"evicted",evicted);
  put(out,"capacity",capacity);
  put(out,"iterations",step);
  put(out,"converged",converged);
  put(out,"recurrent_norm",norm);
  put(out,"infinite_memory_claimed",0);
  put(out,"formal_admission",0);
  retornar out;
}
funcao om_mod_25_retrieve(keys,values,query,beta,bits) {
  var scores=[];
  var maximum=(beta*om_mod_0_dot((keys)[0],query));
  var minimum=maximum;
  var i=0;
  enquanto((i<len(keys))) {
    var score=om_mod_0_check((beta*om_mod_0_dot((keys)[i],query)));
    push(scores,score);
    maximum=om_mod_29_max(maximum,score);
    minimum=om_mod_29_min(minimum,score);
    i=(i+1);
  }
  se(((maximum-minimum)>64)) {
    fail("Associative score dynamic-range budget 64");
  }
  var exponential=[];
  var total=[0,0];
  i=0;
  enquanto((i<len(scores))) {
    var e=om_mod_29_exp_interval(((scores)[i]-maximum),bits);
    push(exponential,e);
    total=om_mod_1_add(total,e);
    i=(i+1);
  }
  var midpoints=[];
  var normalization=0;
  var intervals=[];
  i=0;
  enquanto((i<len(scores))) {
    var weight=om_mod_1_div((exponential)[i],total);
    push(intervals,weight);
    var point=om_mod_1_midpoint(weight);
    push(midpoints,point);
    normalization=(normalization+point);
    i=(i+1);
  }
  midpoints=om_mod_0_scale(midpoints,(1/normalization));
  var enclosure=[];
  var dimension=0;
  enquanto((dimension<len((values)[0]))) {
    var sum=[0,0];
    i=0;
    enquanto((i<len(values))) {
      sum=om_mod_1_add(sum,om_mod_1_scale((intervals)[i],((values)[i])[dimension]));
      i=(i+1);
    }
    push(enclosure,sum);
    dimension=(dimension+1);
  }
  var out=obj();
  put(out,"weight_intervals",intervals);
  put(out,"normalized_midpoint_weights",midpoints);
  put(out,"value_intervals",enclosure);
  put(out,"key_midpoint",om_mod_13_apply(om_mod_0_transpose(keys),midpoints));
  retornar out;
}
funcao om_mod_26_diagonal_bounds(matrix) {
  var lower=((matrix)[0])[0];
  var upper=0;
  var i=0;
  enquanto((i<len(matrix))) {
    var off=0;
    var row=0;
    var j=0;
    enquanto((j<len(matrix))) {
      se((j!=i)) {
        off=(off+om_mod_29_abs(((matrix)[i])[j]));
      }
      row=(row+om_mod_29_abs(((matrix)[i])[j]));
      j=(j+1);
    }
    lower=om_mod_29_min(lower,(((matrix)[i])[i]-off));
    upper=om_mod_29_max(upper,row);
    i=(i+1);
  }
  retornar [lower,upper];
}
funcao om_mod_26_energy(matrix,drive,state) {
  retornar ((om_mod_0_dot(state,om_mod_13_apply(matrix,state))/2)-om_mod_0_dot(drive,state));
}
funcao om_mod_26_execute(r) {
  var weights=om_mod_0_mat((r)["weights"]);
  var leak=om_mod_0_vector((r)["leak"]);
  var drive=om_mod_0_vector((r)["drive"]);
  var outputs=om_mod_0_vector((r)["outputs"]);
  var target=om_mod_0_vector((r)["target"]);
  var n=len(drive);
  se(((((((((n<1)||(n>16))||(len(leak)!=n))||(len(weights)!=n))||(len((weights)[0])!=n))||(len(target)!=len(outputs)))||(len(outputs)<1))||(len(outputs)>n))) {
    fail("EqProp dimensions");
  }
  var matrix=[];
  var i=0;
  enquanto((i<n)) {
    om_mod_0_positive((leak)[i]);
    var row=om_mod_0_scale((weights)[i],(-1));
    put(row,i,(leak)[i]);
    se((((weights)[i])[i]!=0)) {
      fail("Use leak for diagonal energy terms, not self weights");
    }
    var j=0;
    enquanto((j<n)) {
      se((((weights)[i])[j]!=((weights)[j])[i])) {
        fail("EqProp weights must be symmetric");
      }
      j=(j+1);
    }
    push(matrix,row);
    i=(i+1);
  }
  om_mod_0_positive((om_mod_26_diagonal_bounds(matrix))[0]);
  var beta=om_mod_0_positive(om_mod_0_q(r,"beta"));
  var nudged=om_mod_0_copy(matrix);
  var nudged_drive=slice(drive,0,n);
  i=0;
  enquanto((i<len(outputs))) {
    var index=om_mod_0_integer((outputs)[i],0,(n-1));
    var j=0;
    enquanto((j<i)) {
      se(((outputs)[j]==index)) {
        fail("Duplicate output neuron");
      }
      j=(j+1);
    }
    put((nudged)[index],index,(((nudged)[index])[index]+beta));
    put(nudged_drive,index,((nudged_drive)[index]+(beta*(target)[i])));
    i=(i+1);
  }
  var eta=om_mod_0_positive(om_mod_0_q(r,"step"));
  var tolerance=om_mod_0_positive(om_mod_0_q(r,"tolerance"));
  var limit=om_mod_0_integer(om_mod_0_num(r,"max_iterations",128),1,512);
  var initial=om_mod_0_zeros(n);
  se(has(r,"initial")) {
    initial=om_mod_0_vector((r)["initial"]);
    se((len(initial)!=n)) {
      fail("EqProp initial state shape");
    }
  }
  var free=om_mod_26_relax(matrix,drive,initial,eta,tolerance,limit);
  var nudge=om_mod_26_relax(nudged,nudged_drive,(free)["state"],eta,tolerance,limit);
  var gradient=[];
  var error=[];
  var updated=[];
  var rate=om_mod_0_nonnegative(om_mod_0_num(r,"learning_rate",0));
  i=0;
  enquanto((i<n)) {
    var grow=[];
    var erow=[];
    var wrow=[];
    var j=0;
    enquanto((j<n)) {
      var value=0;
      var bound=0;
      se((i!=j)) {
        value=om_mod_0_check(((-((((nudge)["state"])[i]*((nudge)["state"])[j])-(((free)["state"])[i]*((free)["state"])[j])))/beta));
        var ef=(free)["state_error_inf_upper"];
        var en=(nudge)["state_error_inf_upper"];
        bound=((((((om_mod_29_abs(((nudge)["state"])[i])+om_mod_29_abs(((nudge)["state"])[j]))*en)+(en*en))+((om_mod_29_abs(((free)["state"])[i])+om_mod_29_abs(((free)["state"])[j]))*ef))+(ef*ef))/beta);
      }
      push(grow,value);
      push(erow,bound);
      push(wrow,om_mod_0_check((((weights)[i])[j]-(rate*value))));
      j=(j+1);
    }
    push(gradient,grow);
    push(error,erow);
    push(updated,wrow);
    i=(i+1);
  }
  var nextmatrix=[];
  i=0;
  enquanto((i<n)) {
    var row=om_mod_0_scale((updated)[i],(-1));
    put(row,i,(leak)[i]);
    push(nextmatrix,row);
    i=(i+1);
  }
  var accepted=((((om_mod_26_diagonal_bounds(nextmatrix))[0]>0)&&(free)["converged"])&&(nudge)["converged"]);
  var out=om_mod_0_result("finite-beta-quadratic-equilibrium-propagation",gradient);
  put(out,"free",free);
  put(out,"nudged",nudge);
  put(out,"relaxation_gradient_error_upper",error);
  put(out,"proposed_weights",updated);
  put(out,"update_admissible",accepted);
  put(out,"finite_beta_bias_included_in_error_bound",0);
  put(out,"iteration_history_stored",0);
  retornar out;
}
funcao om_mod_26_relax(matrix,drive,initial,eta,tolerance,limit) {
  var bounds=om_mod_26_diagonal_bounds(matrix);
  om_mod_0_positive((bounds)[0]);
  se(((eta<=0)||(eta>(1/(bounds)[1])))) {
    fail("Relaxation step must be in (0,1/Gershgorin-upper]");
  }
  var state=slice(initial,0,len(initial));
  var e0=om_mod_26_energy(matrix,drive,state);
  var previous=e0;
  var residual=om_mod_0_add(om_mod_13_apply(matrix,state),om_mod_0_scale(drive,(-1)));
  var step=0;
  enquanto(((step<limit)&&(om_mod_13_maxabs(residual)>tolerance))) {
    state=om_mod_0_add(state,om_mod_0_scale(residual,(-eta)));
    var e=om_mod_26_energy(matrix,drive,state);
    se((e>previous)) {
      fail("Contractive relaxation increased quadratic energy");
    }
    previous=e;
    residual=om_mod_0_add(om_mod_13_apply(matrix,state),om_mod_0_scale(drive,(-1)));
    step=(step+1);
  }
  var out=obj();
  put(out,"state",state);
  put(out,"residual",residual);
  put(out,"iterations",step);
  put(out,"converged",(om_mod_13_maxabs(residual)<=tolerance));
  put(out,"state_error_inf_upper",(om_mod_13_maxabs(residual)/(bounds)[0]));
  put(out,"initial_energy",e0);
  put(out,"final_energy",previous);
  retornar out;
}
funcao om_mod_27_evaluate(w,target_w,predictor,action_map,context,target,actions,floor,variance_weight,covariance_weight) {
  var batch=len(context);
  var latent=len(w);
  var z=[];
  var teacher=[];
  var prediction=[];
  var error=[];
  var means=om_mod_0_zeros(latent);
  var mse=0;
  var sample=0;
  enquanto((sample<batch)) {
    var embedding=om_mod_13_apply(w,(context)[sample]);
    var expected=om_mod_13_apply(target_w,(target)[sample]);
    var predicted=om_mod_0_add(om_mod_13_apply(predictor,embedding),om_mod_13_apply(action_map,(actions)[sample]));
    var residual=om_mod_0_add(predicted,om_mod_0_scale(expected,(-1)));
    mse=(mse+(om_mod_13_norm2(residual)/batch));
    means=om_mod_0_add(means,om_mod_0_scale(embedding,(1/batch)));
    push(z,embedding);
    push(teacher,expected);
    push(prediction,predicted);
    push(error,residual);
    sample=(sample+1);
  }
  var centered=[];
  sample=0;
  enquanto((sample<batch)) {
    push(centered,om_mod_0_add((z)[sample],om_mod_0_scale(means,(-1))));
    sample=(sample+1);
  }
  var covariance=om_mod_27_zeros(latent,latent);
  var i=0;
  enquanto((i<latent)) {
    var j=0;
    enquanto((j<latent)) {
      var total=0;
      sample=0;
      enquanto((sample<batch)) {
        total=om_mod_0_check((total+((((centered)[sample])[i]*((centered)[sample])[j])/(batch-1))));
        sample=(sample+1);
      }
      put((covariance)[i],j,total);
      j=(j+1);
    }
    i=(i+1);
  }
  var variance_penalty=0;
  var covariance_penalty=0;
  var collapsed=1;
  i=0;
  enquanto((i<latent)) {
    var deficit=om_mod_29_max(0,(floor-((covariance)[i])[i]));
    variance_penalty=(variance_penalty+(deficit*deficit));
    se((((covariance)[i])[i]>0)) {
      collapsed=0;
    }
    var j=0;
    enquanto((j<latent)) {
      se((i!=j)) {
        covariance_penalty=(covariance_penalty+(((covariance)[i])[j]*((covariance)[i])[j]));
      }
      j=(j+1);
    }
    i=(i+1);
  }
  var gw=om_mod_27_zeros(latent,len((w)[0]));
  var gp=om_mod_27_zeros(latent,latent);
  var ga=om_mod_27_zeros(latent,len((action_map)[0]));
  sample=0;
  enquanto((sample<batch)) {
    var gz=om_mod_0_scale(om_mod_13_apply(om_mod_0_transpose(predictor),(error)[sample]),(2/batch));
    i=0;
    enquanto((i<latent)) {
      var regularizer=(((((-4)*variance_weight)*om_mod_29_max(0,(floor-((covariance)[i])[i])))*((centered)[sample])[i])/(batch-1));
      var j=0;
      enquanto((j<latent)) {
        se((i!=j)) {
          regularizer=(regularizer+((((4*covariance_weight)*((covariance)[i])[j])*((centered)[sample])[j])/(batch-1)));
        }
        put((gp)[i],j,om_mod_0_check((((gp)[i])[j]+(((2*((error)[sample])[i])*((z)[sample])[j])/batch))));
        j=(j+1);
      }
      put(gz,i,om_mod_0_check(((gz)[i]+regularizer)));
      j=0;
      enquanto((j<len((action_map)[0]))) {
        put((ga)[i],j,om_mod_0_check((((ga)[i])[j]+(((2*((error)[sample])[i])*((actions)[sample])[j])/batch))));
        j=(j+1);
      }
      j=0;
      enquanto((j<len((w)[0]))) {
        put((gw)[i],j,om_mod_0_check((((gw)[i])[j]+((gz)[i]*((context)[sample])[j]))));
        j=(j+1);
      }
      i=(i+1);
    }
    sample=(sample+1);
  }
  var out=obj();
  put(out,"loss",om_mod_0_check(((mse+(variance_weight*variance_penalty))+(covariance_weight*covariance_penalty))));
  put(out,"prediction_loss",mse);
  put(out,"variance_penalty",variance_penalty);
  put(out,"covariance_penalty",covariance_penalty);
  put(out,"latent",z);
  put(out,"target_latent",teacher);
  put(out,"prediction",prediction);
  put(out,"covariance",covariance);
  put(out,"collapsed",collapsed);
  put(out,"encoder_gradient",gw);
  put(out,"predictor_gradient",gp);
  put(out,"action_gradient",ga);
  retornar out;
}
funcao om_mod_27_execute(r) {
  var w=om_mod_0_mat((r)["encoder"]);
  var target_w=om_mod_0_mat((r)["target_encoder"]);
  var predictor=om_mod_0_mat((r)["predictor"]);
  var action_map=om_mod_0_mat((r)["action_map"]);
  var context=om_mod_0_mat((r)["context"]);
  var target=om_mod_0_mat((r)["target"]);
  var actions=om_mod_0_mat((r)["actions"]);
  var latent=len(w);
  var batch=len(context);
  var input=len((w)[0]);
  se(((((((((((((((latent>8)||(input>16))||(batch<2))||(len(target_w)!=latent))||(len((target_w)[0])!=input))||(len((context)[0])!=input))||(len((target)[0])!=input))||(len(target)!=batch))||(len(actions)!=batch))||(len(predictor)!=latent))||(len((predictor)[0])!=latent))||(len(action_map)!=latent))||(len((action_map)[0])!=len((actions)[0])))||(len((actions)[0])>8))) {
    fail("Linear JEPA dimensions/budget");
  }
  var rate=om_mod_0_positive(om_mod_0_q(r,"learning_rate"));
  var ema=om_mod_0_q(r,"ema");
  se(((ema<0)||(ema>=1))) {
    fail("Target encoder EMA must lie in [0,1)");
  }
  var floor=om_mod_0_positive(om_mod_0_q(r,"variance_floor"));
  var vw=om_mod_0_nonnegative(om_mod_0_q(r,"variance_weight"));
  var cw=om_mod_0_nonnegative(om_mod_0_q(r,"covariance_weight"));
  var epochs=om_mod_0_integer(om_mod_0_num(r,"epochs",1),1,32);
  var history=[];
  var epoch=0;
  var first=om_mod_27_evaluate(w,target_w,predictor,action_map,context,target,actions,floor,vw,cw);
  enquanto((epoch<epochs)) {
    var status=om_mod_27_evaluate(w,target_w,predictor,action_map,context,target,actions,floor,vw,cw);
    push(history,(status)["loss"]);
    w=om_mod_27_update(w,(status)["encoder_gradient"],rate);
    predictor=om_mod_27_update(predictor,(status)["predictor_gradient"],rate);
    action_map=om_mod_27_update(action_map,(status)["action_gradient"],rate);
    var next_target=[];
    var i=0;
    enquanto((i<latent)) {
      push(next_target,om_mod_0_add(om_mod_0_scale((target_w)[i],ema),om_mod_0_scale((w)[i],(1-ema))));
      i=(i+1);
    }
    target_w=next_target;
    epoch=(epoch+1);
  }
  var out=om_mod_0_result("linear-stop-gradient-JEPA-with-variance-covariance-regularization",w);
  put(out,"target_encoder",target_w);
  put(out,"predictor",predictor);
  put(out,"action_map",action_map);
  put(out,"before",first);
  put(out,"after",om_mod_27_evaluate(w,target_w,predictor,action_map,context,target,actions,floor,vw,cw));
  put(out,"loss_history",history);
  put(out,"noncollapse_guaranteed",0);
  put(out,"empirical_world_understanding_claimed",0);
  retornar out;
}
funcao om_mod_27_update(matrix,gradient,rate) {
  var out=[];
  var i=0;
  enquanto((i<len(matrix))) {
    push(out,om_mod_0_add((matrix)[i],om_mod_0_scale((gradient)[i],(-rate))));
    i=(i+1);
  }
  retornar out;
}
funcao om_mod_27_zeros(rows,columns) {
  var out=[];
  var i=0;
  enquanto((i<rows)) {
    push(out,om_mod_0_zeros(columns));
    i=(i+1);
  }
  retornar out;
}
funcao om_mod_28_execute(r) {
  var features=om_mod_0_vector((r)["features"]);
  var variables=om_mod_0_count(r,"variables",1,4);
  var raw=(r)["basis"];
  se((((((len(features)<1)||(len(features)>16))||(!islist(raw)))||(len(raw)<1))||(len(raw)>16))) {
    fail("Hypernetwork feature/basis budget");
  }
  var basis=[];
  var i=0;
  enquanto((i<len(raw))) {
    var term=om_mod_13_poly_read([[1,(raw)[i]]],variables);
    var j=0;
    enquanto((j<i)) {
      se(om_mod_13_same((basis)[j],((term)[0])[1])) {
        fail("Duplicate synthesis basis");
      }
      j=(j+1);
    }
    push(basis,((term)[0])[1]);
    i=(i+1);
  }
  var mode=om_mod_0_text_field(r,"mode",24);
  var hyper=[];
  var training_error=0;
  se((mode=="fit_generate")) {
    var x=om_mod_0_mat((r)["training_features"]);
    var y=om_mod_0_mat((r)["training_coefficients"]);
    se((((len(x)!=len(y))||(len((x)[0])!=len(features)))||(len((y)[0])!=len(basis)))) {
      fail("Hypernetwork training shape");
    }
    hyper=om_mod_28_fit(x,y,om_mod_0_nonnegative(om_mod_0_num(r,"ridge",0)));
    i=0;
    enquanto((i<len(x))) {
      training_error=(training_error+om_mod_13_norm2(om_mod_0_add(om_mod_13_apply(hyper,(x)[i]),om_mod_0_scale((y)[i],(-1)))));
      i=(i+1);
    }
  }
  senao {
    se((mode!="generate")) {
      fail("Hypernetwork mode generate or fit_generate required");
    }
    hyper=om_mod_0_mat((r)["hyper_weights"]);
  }
  se(((len(hyper)!=len(basis))||(len((hyper)[0])!=len(features)))) {
    fail("Hypernetwork output signature mismatch");
  }
  var coefficients=om_mod_13_apply(hyper,features);
  var polynomial=[];
  i=0;
  enquanto((i<len(basis))) {
    se(((coefficients)[i]!=0)) {
      push(polynomial,[(coefficients)[i],(basis)[i]]);
    }
    i=(i+1);
  }
  var cases=(r)["cases"];
  se((((!islist(cases))||(len(cases)<1))||(len(cases)>32))) {
    fail("Synthesis requires 1..32 reviewable cases");
  }
  var checks=[];
  var accepted=1;
  i=0;
  enquanto((i<len(cases))) {
    var x=om_mod_0_vector(((cases)[i])["input"]);
    se((len(x)!=variables)) {
      fail("Synthesis case input type/dimension");
    }
    var expected=om_mod_0_q((cases)[i],"expected");
    var value=om_mod_13_poly_eval(polynomial,x);
    var good=(value==expected);
    se((!good)) {
      accepted=0;
    }
    push(checks,[value,expected,good]);
    i=(i+1);
  }
  var code=om_mod_28_source(polynomial,variables);
  var out=om_mod_0_result("linear-hypernetwork-to-polynomial-Omega-program",coefficients);
  put(out,"polynomial",polynomial);
  put(out,"hyper_weights",hyper);
  put(out,"training_squared_error",training_error);
  put(out,"source",code);
  put(out,"source_sha256",sha256(code));
  put(out,"cases",checks);
  put(out,"examples_passed",accepted);
  put(out,"compiled",0);
  put(out,"generalization_proven",0);
  retornar out;
}
funcao om_mod_28_fit(features,targets,ridge) {
  var xt=om_mod_0_transpose(features);
  var gram=om_mod_0_mul(xt,features);
  var i=0;
  enquanto((i<len(gram))) {
    put((gram)[i],i,(((gram)[i])[i]+ridge));
    i=(i+1);
  }
  retornar om_mod_0_transpose(om_mod_0_mul(om_mod_13_inverse(gram),om_mod_0_mul(xt,targets)));
}
funcao om_mod_28_source(polynomial,variables) {
  var body=(("funcao predict(x) { retornar "+om_mod_13_poly_text(polynomial))+"; }\n");
  body=(((((body+"funcao principal() { se(argc()!=")+text(((2*variables)+1)))+") { fail(\"Expected numerator/denominator argument pairs\"); } var x=[]; var i=0; enquanto(i<")+text(variables))+") { push(x,number(arg(2*i+1))/number(arg(2*i+2))); i=i+1; } var y=predict(x); print(qnum(y)); print(qden(y)); retornar 0; }\n");
  retornar body;
}
funcao om_mod_5_execute(id,request) {
  se((id==1)) {
    retornar om_mod_19_execute(request);
  }
  se((id==2)) {
    retornar om_mod_15_execute(request);
  }
  se((id==3)) {
    retornar om_mod_18_execute(request);
  }
  se((id==4)) {
    retornar om_mod_17_execute(request);
  }
  se((id==5)) {
    retornar om_mod_23_execute(request);
  }
  se((id==6)) {
    retornar om_mod_21_execute(request);
  }
  se((id==7)) {
    retornar om_mod_16_execute(request);
  }
  se((id==8)) {
    retornar om_mod_20_execute(request);
  }
  se((id==9)) {
    retornar om_mod_12_execute(request);
  }
  se((id==10)) {
    retornar om_mod_22_execute(request);
  }
  se((id==11)) {
    retornar om_mod_26_execute(request);
  }
  se((id==12)) {
    retornar om_mod_25_execute(request);
  }
  se((id==13)) {
    retornar om_mod_24_execute(request);
  }
  se((id==14)) {
    retornar om_mod_27_execute(request);
  }
  se((id==15)) {
    retornar om_mod_28_execute(request);
  }
  se((id==16)) {
    retornar om_mod_14_execute(request);
  }
  fail("Unknown bounded engine ID");
  retornar obj();
}
funcao om_mod_7_arity(op) {
  se(contains(["pi","lambda","app","sigma","annotation","refl","absurd","nat-add","nat-mul","rat-add","rat-mul"],op)) {
    retornar 2;
  }
  se(contains(["let","pair","equality","transport"],op)) {
    retornar 3;
  }
  se(contains(["first","second","successor","rat-neg"],op)) {
    retornar 1;
  }
  se((op=="nat-rec")) {
    retornar 4;
  }
  se(contains(["sort","var","nat","zero","nat-literal","unit","unit-value","empty","constant","rat","rat-literal"],op)) {
    retornar 0;
  }
  retornar (-1);
}
funcao om_mod_7_atom(state,op) {
  retornar om_mod_7_make_node(state,op,[],[]);
}
funcao om_mod_7_binary(state,op,a,b) {
  retornar om_mod_7_make_node(state,op,[a,b],[]);
}
funcao om_mod_7_binder(op,index) {
  retornar ((contains(["pi","lambda","sigma"],op)&&(index==1))||((op=="let")&&(index==2)));
}
funcao om_mod_7_check_term(state,term,expected,depth) {
  var actual=om_mod_7_infer_term(state,term,(depth+1));
  se(((actual<0)||(!om_mod_7_equal_terms(state,actual,expected,(depth+1))))) {
    om_mod_7_fault(state,"type-mismatch",term);
    retornar 0;
  }
  retornar ((state)["error"]=="");
}
funcao om_mod_7_data_arity(op) {
  se((op=="rat-literal")) {
    retornar 2;
  }
  se(contains(["sort","var","constant","nat-literal"],op)) {
    retornar 1;
  }
  retornar 0;
}
funcao om_mod_7_equal_terms(state,left,right,depth) {
  se((!om_mod_7_tick(state,left,depth))) {
    retornar 0;
  }
  se((((left==right)&&(left>=0))&&(left<len((state)["nodes"])))) {
    retornar 1;
  }
  left=om_mod_7_normal(state,left,(depth+1));
  right=om_mod_7_normal(state,right,(depth+1));
  se(((state)["error"]!="")) {
    retornar 0;
  }
  var a=om_mod_7_node(state,left);
  var b=om_mod_7_node(state,right);
  se(((((a)[0]!=(b)[0])||(len((a)[2])!=len((b)[2])))||(len((a)[1])!=len((b)[1])))) {
    retornar 0;
  }
  var i=0;
  enquanto((i<len((a)[2]))) {
    se((((a)[2])[i]!=((b)[2])[i])) {
      retornar 0;
    }
    i=(i+1);
  }
  i=0;
  enquanto((i<len((a)[1]))) {
    se((!om_mod_7_equal_terms(state,((a)[1])[i],((b)[1])[i],(depth+1)))) {
      retornar 0;
    }
    i=(i+1);
  }
  retornar 1;
}
funcao om_mod_7_fault(state,code,node) {
  se(((state)["error"]=="")) {
    put(state,"error",code);
    put(state,"error_node",node);
  }
  retornar (-1);
}
funcao om_mod_7_fields(raw,allowed) {
  se(((isnum(raw)||isstr(raw))||islist(raw))) {
    fail("Proof protocol object required");
  }
  var names=keys(raw);
  var i=0;
  enquanto((i<len(names))) {
    se((!contains(allowed,(names)[i]))) {
      fail("Unknown proof protocol field");
    }
    i=(i+1);
  }
  retornar 0;
}
funcao om_mod_7_infer_term(state,id,depth) {
  se((!om_mod_7_tick(state,id,depth))) {
    retornar (-1);
  }
  var term=om_mod_7_node(state,id);
  var op=(term)[0];
  var args=(term)[1];
  se((op=="sort")) {
    se((((term)[2])[0]>31)) {
      retornar om_mod_7_fault(state,"universe-limit",id);
    }
    retornar om_mod_7_sort_node(state,(((term)[2])[0]+1));
  }
  se((op=="var")) {
    var k=((term)[2])[0];
    se(((k<0)||(k>=(state)["context_depth"]))) {
      retornar om_mod_7_fault(state,"scope",id);
    }
    retornar om_mod_7_shift(state,((state)["context"])[(((state)["context_depth"]-1)-k)],(k+1),0,(depth+1));
  }
  se(((op=="pi")||(op=="sigma"))) {
    var a=om_mod_7_type_level(state,(args)[0],(depth+1));
    se(((a<0)||(!om_mod_7_push_context(state,(args)[0],id)))) {
      retornar (-1);
    }
    var b=om_mod_7_type_level(state,(args)[1],(depth+1));
    put(state,"context_depth",((state)["context_depth"]-1));
    se((b<0)) {
      retornar (-1);
    }
    retornar om_mod_7_sort_node(state,om_mod_29_max(a,b));
  }
  se((op=="lambda")) {
    se(((om_mod_7_type_level(state,(args)[0],(depth+1))<0)||(!om_mod_7_push_context(state,(args)[0],id)))) {
      retornar (-1);
    }
    var body=om_mod_7_infer_term(state,(args)[1],(depth+1));
    put(state,"context_depth",((state)["context_depth"]-1));
    retornar om_mod_7_binary(state,"pi",(args)[0],body);
  }
  se((op=="app")) {
    var fn=om_mod_7_node(state,om_mod_7_normal(state,om_mod_7_infer_term(state,(args)[0],(depth+1)),(depth+1)));
    se(((fn)[0]!="pi")) {
      retornar om_mod_7_fault(state,"not-a-function",id);
    }
    se((!om_mod_7_check_term(state,(args)[1],((fn)[1])[0],(depth+1)))) {
      retornar (-1);
    }
    retornar om_mod_7_instantiate(state,((fn)[1])[1],(args)[1],(depth+1));
  }
  se((op=="let")) {
    se((((om_mod_7_type_level(state,(args)[0],(depth+1))<0)||(!om_mod_7_check_term(state,(args)[1],(args)[0],(depth+1))))||(!om_mod_7_push_context(state,(args)[0],id)))) {
      retornar (-1);
    }
    var body=om_mod_7_infer_term(state,(args)[2],(depth+1));
    put(state,"context_depth",((state)["context_depth"]-1));
    retornar om_mod_7_instantiate(state,body,(args)[1],(depth+1));
  }
  se((op=="annotation")) {
    se(((om_mod_7_type_level(state,(args)[1],(depth+1))<0)||(!om_mod_7_check_term(state,(args)[0],(args)[1],(depth+1))))) {
      retornar (-1);
    }
    retornar (args)[1];
  }
  se((op=="pair")) {
    se((om_mod_7_type_level(state,(args)[0],(depth+1))<0)) {
      retornar (-1);
    }
    var sigma=om_mod_7_node(state,om_mod_7_normal(state,(args)[0],(depth+1)));
    se(((sigma)[0]!="sigma")) {
      retornar om_mod_7_fault(state,"not-a-pair",id);
    }
    se((!om_mod_7_check_term(state,(args)[1],((sigma)[1])[0],(depth+1)))) {
      retornar (-1);
    }
    var second=om_mod_7_instantiate(state,((sigma)[1])[1],(args)[1],(depth+1));
    se((!om_mod_7_check_term(state,(args)[2],second,(depth+1)))) {
      retornar (-1);
    }
    retornar (args)[0];
  }
  se(((op=="first")||(op=="second"))) {
    var sigma=om_mod_7_node(state,om_mod_7_normal(state,om_mod_7_infer_term(state,(args)[0],(depth+1)),(depth+1)));
    se(((sigma)[0]!="sigma")) {
      retornar om_mod_7_fault(state,"not-a-pair",id);
    }
    se((op=="first")) {
      retornar ((sigma)[1])[0];
    }
    retornar om_mod_7_instantiate(state,((sigma)[1])[1],om_mod_7_unary(state,"first",(args)[0]),(depth+1));
  }
  se(contains(["nat","rat","unit","empty"],op)) {
    retornar om_mod_7_sort_node(state,0);
  }
  se((op=="unit-value")) {
    retornar om_mod_7_atom(state,"unit");
  }
  se(((op=="zero")||(op=="nat-literal"))) {
    retornar om_mod_7_atom(state,"nat");
  }
  se(contains(["successor","nat-add","nat-mul","rat-add","rat-mul","rat-neg"],op)) {
    var base="nat";
    se(contains(["rat-add","rat-mul","rat-neg"],op)) {
      base="rat";
    }
    var type=om_mod_7_atom(state,base);
    var i=0;
    enquanto((i<len(args))) {
      se((!om_mod_7_check_term(state,(args)[i],type,(depth+1)))) {
        retornar (-1);
      }
      i=(i+1);
    }
    retornar type;
  }
  se((op=="rat-literal")) {
    retornar om_mod_7_atom(state,"rat");
  }
  se((op=="nat-rec")) {
    var motive=om_mod_7_node(state,om_mod_7_normal(state,om_mod_7_infer_term(state,(args)[0],(depth+1)),(depth+1)));
