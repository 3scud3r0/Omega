modulo scheduler_preemptivo;

exportar execute;
funcao execute(r){var jobs=r["jobs"];var quantum=r["quantum"];se(quantum<1||quantum>1000000||qden(quantum)!=1||len(jobs)>256){fail("Scheduler budget");}var queue=[];var i=0;var sum=0;enquanto(i<len(jobs)){var job=parsejson(json(jobs[i]));se(job["remaining"]<1||qden(job["remaining"])!=1){fail("Positive integer work units required");}sum=sum+job["remaining"];push(queue,job);i=i+1;}se(sum>1000000){fail("Total work budget");}var timeline=[];var clock=0;var remaining=len(queue);enquanto(remaining>0){i=0;enquanto(i<len(queue)){var job=queue[i];se(job["remaining"]>0){var used=quantum;se(job["remaining"]<used){used=job["remaining"];}push(timeline,[clock,job["id"],used,job["resource"]]);clock=clock+used;put(job,"remaining",job["remaining"]-used);se(job["remaining"]==0){remaining=remaining-1;}}i=i+1;}}retornar timeline;}
