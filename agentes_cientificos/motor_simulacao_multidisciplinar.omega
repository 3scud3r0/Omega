modulo science_102;
importar "../ciencia/core/exato.omega" como u;
importar "../std/math.omega" como m;
importar "../std/string.omega" como s;
importar "../std/math/linalg_exact.omega" como la;
exportar execute;
# A declared closed oscillator/two-reservoir/isomer model with exact discrete total-energy and amount checks.

funcao execute(r){var q=u::q(r,"position");var p=u::q(r,"momentum");var mass=u::positive(u::q(r,"mass"));var spring=u::positive(u::q(r,"spring"));var t1=u::nonnegative(u::q(r,"temperature1"));var t2=u::nonnegative(u::q(r,"temperature2"));var c1=u::positive(u::q(r,"heat_capacity1"));var c2=u::positive(u::q(r,"heat_capacity2"));var a=u::nonnegative(u::q(r,"amount_A"));var b=u::nonnegative(u::q(r,"amount_B"));var enthalpy=u::q(r,"reaction_enthalpy");var h=u::positive(u::q(r,"step"));var friction=u::nonnegative(u::q(r,"friction"));var exchange=u::nonnegative(u::q(r,"heat_exchange"));var kf=u::nonnegative(u::q(r,"forward_rate"));var kr=u::nonnegative(u::q(r,"reverse_rate"));se(h*friction>1||h*exchange*(1/c1+1/c2)>1){fail("Coupled map positivity domain");}var energy=p*p/(2*mass)+spring*q*q/2+c1*t1+c2*t2+enthalpy*b;var denominator=1+h*h*spring/(4*mass);var nextq=((1-h*h*spring/(4*mass))*q+h*p/mass)/denominator;var nextp=((1-h*h*spring/(4*mass))*p-h*spring*q)/denominator;var damped=nextp*(1-h*friction)/(1+h*friction);t1=t1+(nextp*nextp-damped*damped)/(2*mass*c1);var heat=h*exchange*(t1-t2);t1=t1-heat/c1;t2=t2+heat/c2;var total=a+b;var nexta=(a+h*kr*total)/(1+h*(kf+kr));var nextb=total-nexta;t1=t1-enthalpy*(nextb-b)/c1;se(t1<0||t2<0||nexta<0||nextb<0){fail("Coupled step outside thermochemical domain");}var after=damped*damped/(2*mass)+spring*nextq*nextq/2+c1*t1+c2*t2+enthalpy*nextb;se(after!=energy){fail("Multiphysics total energy conservation");}var out=u::result("closed-oscillator-thermal-isomer-splitting",[nextq,damped,t1,t2,nexta,nextb]);put(out,"total_energy_before",energy);put(out,"total_energy_after",after);put(out,"total_chemical_amount",total);retornar out;}
