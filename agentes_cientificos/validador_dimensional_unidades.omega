modulo science_103;
importar "../ciencia/core/exato.omega" como u;
importar "../std/math.omega" como m;
importar "../std/string.omega" como s;
importar "../std/math/linalg_exact.omega" como la;
exportar execute;
# SI dimension graph with exact unit scales; additions require equal dimension vectors, multiplicative units only.

funcao unit(name){var out=obj();var dim=[0,0,0,0,0,0,0];var scale=1;se(name=="1"){}senao{se(name=="kg"){put(dim,0,1);}senao{se(name=="m"||name=="cm"){put(dim,1,1);se(name=="cm"){scale=1/100;}}senao{se(name=="s"){put(dim,2,1);}senao{se(name=="A"){put(dim,3,1);}senao{se(name=="K"){put(dim,4,1);}senao{se(name=="mol"){put(dim,5,1);}senao{se(name=="cd"){put(dim,6,1);}senao{se(name=="N"){dim=[1,1,-2,0,0,0,0];}senao{se(name=="J"){dim=[1,2,-2,0,0,0,0];}senao{se(name=="W"){dim=[1,2,-3,0,0,0,0];}senao{se(name=="Pa"){dim=[1,-1,-2,0,0,0,0];}senao{fail("Unknown multiplicative SI unit; affine temperatures are unsupported");}}}}}}}}}}}}put(out,"dimensions",dim);put(out,"scale",scale);retornar out;}
funcao execute(r){var nodes=s::as_list(r["nodes"]);se(len(nodes)<1||len(nodes)>256){fail("Dimension graph budget");}var states=[];var i=0;enquanto(i<len(nodes)){var node=nodes[i];var out=obj();var op=u::text_field(node,"operation",16);se(op=="value"){var base=unit(u::text_field(node,"unit",16));put(out,"value",u::q(node,"value")*base["scale"]);put(out,"dimensions",base["dimensions"]);}senao{var left=u::count(node,"left",0,i-1);var a=states[left];var dim=slice(a["dimensions"],0,7);var v=0;se(op=="power"){var n=u::count(node,"exponent",-16,16);v=u::power(a["value"],n);dim=u::scale(dim,n);}senao{var right=u::count(node,"right",0,i-1);var b=states[right];se(op=="add"||op=="subtract"){se(s::canonical(dim)!=s::canonical(b["dimensions"])){fail("Cannot add different physical dimensions");}v=a["value"]+b["value"];se(op=="subtract"){v=a["value"]-b["value"];}}senao{se(op=="multiply"){v=a["value"]*b["value"];dim=u::add(dim,b["dimensions"]);}senao{se(op=="divide"){se(b["value"]==0){fail("Dimensioned division by zero");}v=a["value"]/b["value"];dim=u::add(dim,u::scale(b["dimensions"],-1));}senao{fail("Unknown dimensional operation");}}}}put(out,"value",v);put(out,"dimensions",dim);}push(states,out);i=i+1;}retornar u::result("SI-dimension-graph",states);}
