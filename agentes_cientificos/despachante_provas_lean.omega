modulo science_104;
importar "../ciencia/core/exato.omega" como u;
importar "../std/math.omega" como m;
importar "../std/string.omega" como s;
importar "../std/math/linalg_exact.omega" como la;
exportar execute;
# Renders bounded closed rational obligations only; the CPU supervisor actually compiles Lean and audits dependencies.

funcao literal(q){retornar "(("+text(qnum(q))+" : Rat) / "+text(qden(q))+")";}
funcao execute(r){var witnesses=s::as_list(r["witnesses"]);se(len(witnesses)<1||len(witnesses)>32){fail("Numeric proof obligation budget");}var source="import Mathlib.Tactic.NormNum\n";var subjects=[];var i=0;enquanto(i<len(witnesses)){var witness=witnesses[i];var proposition="";se(has(witness,"nonnegative")){var q=u::q(witness,"nonnegative");proposition="0 <= "+literal(q);}senao{var left=u::vector(witness["left"]);var right=u::vector(witness["right"]);var a=0;var b=0;var j=0;enquanto(j<len(left)){a=a+left[j];j=j+1;}j=0;enquanto(j<len(right)){b=b+right[j];j=j+1;}proposition=literal(a)+" = "+literal(b);}var name="science_observation_"+text(i);source=source+"theorem "+name+" : "+proposition+" := by norm_num\n#print axioms "+name+"\n";push(subjects,sha256(proposition));i=i+1;}var out=u::result("closed-numeric-Lean-proof-job",source);put(out,"source_sha256",sha256(source));put(out,"subjects",subjects);put(out,"dispatch_status","awaiting-independent-CPU-supervisor");put(out,"executable",0);retornar out;}
